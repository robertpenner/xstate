  decreases |events|
{
  if (|events| == 0) then
    snapshot
  else
    run(machine, transition(machine, snapshot, events[0]).snapshot, events[1..])
}

lemma run_ensures(machine: Machine, snapshot: Snapshot, events: seq<FSMEvent>)
  ensures ((|events| == 0) ==> (run(machine, snapshot, events) == snapshot))
