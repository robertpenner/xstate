// Generated by lsc from fsmModel.ts
// lsc options: string-semantics=javascript-utf16

datatype Option<T> = None | Some(value: T)

datatype Value = integer(value: int) | negativeZero | notANumber | undefinedValue | opaque_(id: int)

datatype PatchEntry = PatchEntry(key: string, value: Value)

datatype FSMEvent = FSMEvent(type_: string, payload: int)

datatype TransitionConfig = TransitionConfig(target: Option<string>, context: Option<seq<PatchEntry>>)

datatype Transition = target(target: string) | config(config: TransitionConfig) | function_(compute: (map<string, Value>, FSMEvent) -> Option<TransitionConfig>)

datatype StateNode = StateNode(on: map<string, Transition>)

datatype Machine = Machine(initial: string, context: Option<map<string, Value>>, inherited: map<string, Value>, states: map<string, StateNode>)

datatype Snapshot = Snapshot(value: string, context: map<string, Value>)

datatype Step = Step(snapshot: Snapshot, reused: bool)

function strictEquals(a: Value, b: Value): bool
{
  match a {
    case integer(i_a_value) =>
      if b.integer? then
        (b.value == i_a_value)
      else
        (b.negativeZero? && (i_a_value == 0))
    case negativeZero =>
      if b.integer? then
        (b.value == 0)
      else
        b.negativeZero?
    case notANumber =>
      false
    case undefinedValue =>
      b.undefinedValue?
    case opaque_(i_a_id) =>
      (b.opaque_? && (b.id == i_a_id))
  }
}

lemma strictEquals_ensures(a: Value, b: Value)
  ensures (a.notANumber? ==> !(strictEquals(a, b)))
{
}

function sameValue(a: Value, b: Value): bool
{
  match a {
    case integer(i_a_value) =>
      (b.integer? && (b.value == i_a_value))
    case negativeZero =>
      b.negativeZero?
    case notANumber =>
      b.notANumber?
    case undefinedValue =>
      b.undefinedValue?
    case opaque_(i_a_id) =>
      (b.opaque_? && (b.id == i_a_id))
  }
}

lemma sameValue_ensures(a: Value, b: Value)
  ensures (sameValue(a, b) == (a == b))
{
}

function read(inherited: map<string, Value>, context: map<string, Value>, key: string): Value
{
  if (key in context) then
    context[key]
  else
    if (key in inherited) then
      inherited[key]
    else
      Value.undefinedValue
}

lemma read_ensures(inherited: map<string, Value>, context: map<string, Value>, key: string)
  ensures ((key in context) ==> ((key in context) && (var i_value := context[key]; (i_value == read(inherited, context, key)))))
{
}

function initialState(machine: Machine): Snapshot
{
  Snapshot(machine.initial, (match machine.context { case Some(i_oc0_val) => i_oc0_val case None => map[] }))
}

lemma initialState_ensures(machine: Machine)
  ensures (initialState(machine).value == machine.initial)
{
}

function lookupTransition(machine: Machine, value: string, type_: string): Option<Transition>
{
  if (value in machine.states) then
    var i_node_val := machine.states[value];
    (if type_ in i_node_val.on then Some(i_node_val.on[type_]) else None)
  else
    None
}

lemma lookupTransition_ensures(machine: Machine, value: string, type_: string)
  ensures (!((value in machine.states)) ==> (match lookupTransition(machine, value, type_) { case Some(i_) => false case None => true }))
{
}

function resolveTransition(transition: Option<Transition>, context: map<string, Value>, event: FSMEvent): Option<TransitionConfig>
{
  match transition {
    case Some(i_transition_val) =>
      match i_transition_val {
        case target(i__transition_val_target) =>
          Some(TransitionConfig(Some(i__transition_val_target), None))
        case config(i__transition_val_config) =>
          Some(i__transition_val_config)
        case function_(i__transition_val_compute) =>
          var compute := i__transition_val_compute;
          compute(context, event)
      }
    case None =>
      None
  }
}

lemma resolveTransition_ensures(transition: Option<Transition>, context: map<string, Value>, event: FSMEvent)
  ensures ((match transition { case Some(i_) => false case None => true }) ==> (match resolveTransition(transition, context, event) { case Some(i_) => false case None => true }))
{
}

function patchChanges(inherited: map<string, Value>, context: map<string, Value>, patch: seq<PatchEntry>): bool
{
  (exists entry :: entry in patch && !(strictEquals(entry.value, read(inherited, context, entry.key))))
}

lemma patchChanges_ensures(inherited: map<string, Value>, context: map<string, Value>, patch: seq<PatchEntry>)
  ensures ((|patch| == 0) ==> !(patchChanges(inherited, context, patch)))
{
}

function mergePatch(context: map<string, Value>, patch: seq<PatchEntry>): map<string, Value>
  decreases |patch|
{
  if (|patch| == 0) then
    context
  else
    var entry := patch[0];
    mergePatch(context[entry.key := entry.value], patch[1..])
}

lemma mergePatch_ensures(context: map<string, Value>, patch: seq<PatchEntry>)
  ensures ((|patch| == 0) ==> (mergePatch(context, patch) == context))
{
}

function transition(machine: Machine, snapshot: Snapshot, event: FSMEvent): Step
{
  var config := resolveTransition(lookupTransition(machine, snapshot.value, event.type_), snapshot.context, event);
  match config {
    case Some(i_config_val) =>
      var target := (match i_config_val.target { case Some(i_oc1_val) => i_oc1_val case None => snapshot.value });
      var patch := (match i_config_val.context { case Some(i_oc2_val) => i_oc2_val case None => [] });
      var changed := patchChanges(machine.inherited, snapshot.context, patch);
      if ((target == snapshot.value) && !(changed)) then
        Step(snapshot, true)
      else
        Step(Snapshot(target, (if changed then mergePatch(snapshot.context, patch) else snapshot.context)), false)
    case None =>
      Step(snapshot, true)
  }
}

lemma transition_ensures(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  ensures (transition(machine, snapshot, event).reused ==> (transition(machine, snapshot, event).snapshot == snapshot))
{
}

