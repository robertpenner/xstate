// ---- Laws about the xstate/fsm model ----

ghost predicate HasKey(patch: seq<PatchEntry>, k: string)
{
  exists e :: e in patch && e.key == k
}

ghost predicate DistinctKeys(patch: seq<PatchEntry>)
{
  forall i, j :: 0 <= i < j < |patch| ==> patch[i].key != patch[j].key
}

ghost predicate NoNotANumber(patch: seq<PatchEntry>)
{
  forall e :: e in patch ==> !e.value.notANumber?
}

// `===` is symmetric, and every value except NaN is `===` to itself.
lemma StrictEqualsSymmetric(a: Value, b: Value)
  ensures strictEquals(a, b) == strictEquals(b, a)
{
}

lemma StrictEqualsReflexiveExceptNaN(a: Value)
  ensures strictEquals(a, a) <==> !a.notANumber?
{
}

// `===` and `Object.is` disagree only on NaN against NaN and on 0 against -0.
lemma StrictEqualsDiffersFromSameValue(a: Value, b: Value)
  ensures strictEquals(a, b) != sameValue(a, b) <==>
    (a.notANumber? && b.notANumber?) ||
    (a == Value.integer(0) && b == Value.negativeZero) ||
    (a == Value.negativeZero && b == Value.integer(0))
{
}

// A context key is present after a merge exactly when the context or the patch has it.
lemma MergeKeys(context: map<string, Value>, patch: seq<PatchEntry>, k: string)
  ensures k in mergePatch(context, patch) <==> (k in context || HasKey(patch, k))
  decreases |patch|
{
  if |patch| > 0 {
    MergeKeys(context[patch[0].key := patch[0].value], patch[1..], k);
    if HasKey(patch[1..], k) {
      var e :| e in patch[1..] && e.key == k;
      assert e in patch;
    }
    if HasKey(patch, k) && patch[0].key != k {
      var e :| e in patch && e.key == k;
      assert e in patch[1..];
    }
  }
}

// Each patched key takes the patch value; every other key keeps the context value.
lemma MergeValues(context: map<string, Value>, patch: seq<PatchEntry>)
  requires DistinctKeys(patch)
  ensures forall e :: e in patch ==> e.key in mergePatch(context, patch) && mergePatch(context, patch)[e.key] == e.value
  ensures forall k :: k in context && !HasKey(patch, k) ==> k in mergePatch(context, patch) && mergePatch(context, patch)[k] == context[k]
  decreases |patch|
{
  if |patch| > 0 {
    var next := context[patch[0].key := patch[0].value];
    assert DistinctKeys(patch[1..]);
    MergeValues(next, patch[1..]);
    forall e | e in patch
      ensures e.key in mergePatch(context, patch) && mergePatch(context, patch)[e.key] == e.value
    {
      if e == patch[0] {
        assert !HasKey(patch[1..], e.key) by {
          if HasKey(patch[1..], e.key) {
            var f :| f in patch[1..] && f.key == e.key;
            var j :| 0 <= j < |patch[1..]| && patch[1..][j] == f;
            assert patch[0].key == patch[j + 1].key;
          }
        }
      } else {
        assert e in patch[1..];
      }
    }
    forall k | k in context && !HasKey(patch, k)
      ensures k in mergePatch(context, patch) && mergePatch(context, patch)[k] == context[k]
    {
      assert patch[0] in patch;
      assert !HasKey(patch[1..], k) by {
        if HasKey(patch[1..], k) {
          var f :| f in patch[1..] && f.key == k;
          assert f in patch;
        }
      }
    }
  }
}

// Merging values the context already owns, structurally identical, changes nothing.
lemma MergeOfOwnedValuesIsIdentity(context: map<string, Value>, patch: seq<PatchEntry>)
  requires forall e :: e in patch ==> e.key in context && context[e.key] == e.value
  ensures mergePatch(context, patch) == context
  decreases |patch|
{
  if |patch| > 0 {
    assert patch[0] in patch;
    assert context[patch[0].key := patch[0].value] == context;
    forall e | e in patch[1..] ensures e in patch {}
    MergeOfOwnedValuesIsIdentity(context, patch[1..]);
  }
}

// When beta.1 skips the copy, every key reads a value `===` to (or identical
// with) what the full merge would read. The skipped merge could still have
// added an own key or replaced 0 with -0; see the concrete laws below.
lemma UnchangedMergeReadsStrictlyEqual(inherited: map<string, Value>, context: map<string, Value>, patch: seq<PatchEntry>, k: string)
  requires DistinctKeys(patch)
  requires !patchChanges(inherited, context, patch)
  ensures strictEquals(read(inherited, mergePatch(context, patch), k), read(inherited, context, k)) ||
          read(inherited, mergePatch(context, patch), k) == read(inherited, context, k)
{
  MergeValues(context, patch);
  MergeKeys(context, patch, k);
  if HasKey(patch, k) {
    var e :| e in patch && e.key == k;
    assert read(inherited, mergePatch(context, patch), k) == e.value;
  }
}

// After a merge, the same patch no longer changes anything, unless it carries NaN.
lemma MergeSettles(inherited: map<string, Value>, context: map<string, Value>, patch: seq<PatchEntry>)
  requires DistinctKeys(patch)
  requires NoNotANumber(patch)
  ensures !patchChanges(inherited, mergePatch(context, patch), patch)
{
  MergeValues(context, patch);
  forall e | e in patch
    ensures strictEquals(e.value, read(inherited, mergePatch(context, patch), e.key))
  {
    StrictEqualsReflexiveExceptNaN(e.value);
  }
}

lemma MergeIdempotent(context: map<string, Value>, patch: seq<PatchEntry>)
  requires DistinctKeys(patch)
  ensures mergePatch(mergePatch(context, patch), patch) == mergePatch(context, patch)
{
  MergeValues(context, patch);
  MergeOfOwnedValuesIsIdentity(mergePatch(context, patch), patch);
}

// The patch carried by a resolved transition, or the empty patch.
ghost function ResolvedPatch(config: Option<TransitionConfig>): seq<PatchEntry>
{
  if config.Some? && config.value.context.Some? then config.value.context.value else []
}

ghost function ResolvedTarget(config: Option<TransitionConfig>, value: string): string
{
  if config.Some? && config.value.target.Some? then config.value.target.value else value
}

ghost function Resolve(machine: Machine, snapshot: Snapshot, event: FSMEvent): Option<TransitionConfig>
{
  resolveTransition(lookupTransition(machine, snapshot.value, event.type_), snapshot.context, event)
}

// The next snapshot is the resolved target, with the patch merged into the
// context exactly when some patched value is not `===` to the value read.
lemma TransitionMeaning(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  ensures transition(machine, snapshot, event).snapshot ==
    Snapshot(ResolvedTarget(Resolve(machine, snapshot, event), snapshot.value),
             if patchChanges(machine.inherited, snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event)))
             then mergePatch(snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event)))
             else snapshot.context)
{
}

// A patch that changes something always produces a new snapshot with the full merge.
lemma ChangedPatchCopies(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  requires patchChanges(machine.inherited, snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event)))
  ensures !transition(machine, snapshot, event).reused
  ensures transition(machine, snapshot, event).snapshot.context ==
          mergePatch(snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event)))
{
}

// Whether or not beta.1 copies, every key of the next context reads a value
// `===` to (or identical with) the full merge's.
lemma TransitionReadsMatchMerge(machine: Machine, snapshot: Snapshot, event: FSMEvent, k: string)
  requires DistinctKeys(ResolvedPatch(Resolve(machine, snapshot, event)))
  ensures strictEquals(read(machine.inherited, transition(machine, snapshot, event).snapshot.context, k),
                       read(machine.inherited, mergePatch(snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event))), k)) ||
          read(machine.inherited, transition(machine, snapshot, event).snapshot.context, k) ==
          read(machine.inherited, mergePatch(snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event))), k)
{
  var patch := ResolvedPatch(Resolve(machine, snapshot, event));
  TransitionMeaning(machine, snapshot, event);
  if !patchChanges(machine.inherited, snapshot.context, patch) {
    UnchangedMergeReadsStrictlyEqual(machine.inherited, snapshot.context, patch, k);
    StrictEqualsSymmetric(read(machine.inherited, mergePatch(snapshot.context, patch), k), read(machine.inherited, snapshot.context, k));
  }
}

lemma MissingTransitionKeepsSnapshot(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  requires lookupTransition(machine, snapshot.value, event.type_).None?
  ensures transition(machine, snapshot, event) == Step(snapshot, true)
{
}

// Without NaN in the patch, the implementation returns the same snapshot
// object exactly when the next snapshot equals it. A NaN patch value always
// copies, even when the result equals the old snapshot.
lemma ReuseIsExactWithoutNaN(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  requires DistinctKeys(ResolvedPatch(Resolve(machine, snapshot, event)))
  requires NoNotANumber(ResolvedPatch(Resolve(machine, snapshot, event)))
  ensures transition(machine, snapshot, event).reused <==> transition(machine, snapshot, event).snapshot == snapshot
{
  var patch := ResolvedPatch(Resolve(machine, snapshot, event));
  if patchChanges(machine.inherited, snapshot.context, patch) {
    MergeValues(snapshot.context, patch);
    var e :| e in patch && !strictEquals(e.value, read(machine.inherited, snapshot.context, e.key));
    assert mergePatch(snapshot.context, patch)[e.key] == e.value;
    StrictEqualsReflexiveExceptNaN(e.value);
  }
}

lemma StringTargetIsConfigTarget(target: string, context: map<string, Value>, event: FSMEvent)
  ensures resolveTransition(Some(Transition.target(target)), context, event) ==
          resolveTransition(Some(config(TransitionConfig(Some(target), None))), context, event)
{
}

lemma EmptyConfigKeepsSnapshot(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  requires Resolve(machine, snapshot, event) == Some(TransitionConfig(None, None))
  ensures transition(machine, snapshot, event) == Step(snapshot, true)
{
}

lemma ContextKeysKept(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  ensures snapshot.context.Keys <= transition(machine, snapshot, event).snapshot.context.Keys
{
  TransitionMeaning(machine, snapshot, event);
  forall k | k in snapshot.context
    ensures k in transition(machine, snapshot, event).snapshot.context
  {
    MergeKeys(snapshot.context, ResolvedPatch(Resolve(machine, snapshot, event)), k);
  }
}

// `undefined` for a key the context neither owns nor inherits reads the same
// as before, so beta.1 keeps the snapshot and the context never gains the key.
lemma UndefinedOnAbsentKeyIsUnchanged(inherited: map<string, Value>, context: map<string, Value>, k: string)
  requires k !in context && k !in inherited
  ensures !patchChanges(inherited, context, [PatchEntry(k, Value.undefinedValue)])
  ensures k in mergePatch(context, [PatchEntry(k, Value.undefinedValue)])
{
  MergeKeys(context, [PatchEntry(k, Value.undefinedValue)], k);
  assert PatchEntry(k, Value.undefinedValue) in [PatchEntry(k, Value.undefinedValue)];
}

// -0 over an own 0 is `===`, so beta.1 keeps 0 although Object.is would differ.
lemma NegativeZeroOverZeroIsUnchanged(inherited: map<string, Value>, context: map<string, Value>, k: string)
  requires k in context && context[k] == Value.integer(0)
  ensures !patchChanges(inherited, context, [PatchEntry(k, Value.negativeZero)])
  ensures k in mergePatch(context, [PatchEntry(k, Value.negativeZero)]) &&
          !sameValue(mergePatch(context, [PatchEntry(k, Value.negativeZero)])[k], context[k])
{
  MergeValues(context, [PatchEntry(k, Value.negativeZero)]);
  assert PatchEntry(k, Value.negativeZero) in [PatchEntry(k, Value.negativeZero)];
}

// When another entry changes, the copy applies the whole patch, -0 included.
lemma NegativeZeroAppliesWithAnotherChange(inherited: map<string, Value>, context: map<string, Value>, zeroKey: string, otherKey: string, v: Value)
  requires zeroKey != otherKey
  requires zeroKey in context && context[zeroKey] == Value.integer(0)
  requires !strictEquals(v, read(inherited, context, otherKey))
  ensures patchChanges(inherited, context, [PatchEntry(zeroKey, Value.negativeZero), PatchEntry(otherKey, v)])
  ensures zeroKey in mergePatch(context, [PatchEntry(zeroKey, Value.negativeZero), PatchEntry(otherKey, v)]) &&
          mergePatch(context, [PatchEntry(zeroKey, Value.negativeZero), PatchEntry(otherKey, v)])[zeroKey] == Value.negativeZero
{
  var patch := [PatchEntry(zeroKey, Value.negativeZero), PatchEntry(otherKey, v)];
  assert patch[1] in patch;
  assert patch[0] in patch;
  MergeValues(context, patch);
}

// A NaN patch value is never `===` to anything, so it always counts as a change.
lemma NotANumberAlwaysChanges(inherited: map<string, Value>, context: map<string, Value>, patch: seq<PatchEntry>, e: PatchEntry)
  requires e in patch && e.value.notANumber?
  ensures patchChanges(inherited, context, patch)
{
  strictEquals_ensures(e.value, read(inherited, context, e.key));
}

// Opaque values such as strings, booleans, and objects compare by identity.
lemma OpaqueComparesByIdentity(inherited: map<string, Value>, context: map<string, Value>, k: string, a: int, b: int)
  requires k in context && context[k] == Value.opaque_(a)
  ensures patchChanges(inherited, context, [PatchEntry(k, Value.opaque_(b))]) <==> a != b
{
  assert PatchEntry(k, Value.opaque_(b)) in [PatchEntry(k, Value.opaque_(b))];
}

// A patch value `===` to the inherited one (such as Object.prototype.toString)
// counts as unchanged, so the context never gains the own key.
lemma InheritedValueIsUnchanged(inherited: map<string, Value>, context: map<string, Value>, k: string)
  requires k !in context && k in inherited && !inherited[k].notANumber?
  ensures !patchChanges(inherited, context, [PatchEntry(k, inherited[k])])
{
  StrictEqualsReflexiveExceptNaN(inherited[k]);
}

// A patch value that differs from the inherited one copies and adds an own key.
lemma InheritedMismatchOwnsKey(inherited: map<string, Value>, context: map<string, Value>, k: string, v: Value)
  requires k !in context && k in inherited && !strictEquals(v, inherited[k])
  ensures patchChanges(inherited, context, [PatchEntry(k, v)])
  ensures k in mergePatch(context, [PatchEntry(k, v)])
{
  assert PatchEntry(k, v) in [PatchEntry(k, v)];
  MergeKeys(context, [PatchEntry(k, v)], k);
}

ghost predicate TargetDeclared(machine: Machine, config: TransitionConfig)
{
  config.target.Some? ==> config.target.value in machine.states
}

ghost predicate TransitionTargetsDeclared(machine: Machine, t: Transition)
{
  match t
  case target(s) => s in machine.states
  case config(c) => TargetDeclared(machine, c)
  case function_(f) => forall c, e :: f(c, e).Some? ==> TargetDeclared(machine, f(c, e).value)
}

ghost predicate TargetsDeclared(machine: Machine)
{
  machine.initial in machine.states &&
  forall v, t :: v in machine.states && t in machine.states[v].on.Values ==> TransitionTargetsDeclared(machine, t)
}

lemma StepStaysDeclared(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  requires TargetsDeclared(machine)
  requires snapshot.value in machine.states
  ensures transition(machine, snapshot, event).snapshot.value in machine.states
{
  TransitionMeaning(machine, snapshot, event);
  var t := lookupTransition(machine, snapshot.value, event.type_);
  if t.Some? {
    assert t.value in machine.states[snapshot.value].on.Values;
    assert TransitionTargetsDeclared(machine, t.value);
    match t.value {
      case target(s) =>
      case config(c) =>
      case function_(f) =>
        assert f(snapshot.context, event).Some? ==> TargetDeclared(machine, f(snapshot.context, event).value);
    }
  }
}

lemma RunStaysDeclared(machine: Machine, snapshot: Snapshot, events: seq<FSMEvent>)
  requires TargetsDeclared(machine)
  requires snapshot.value in machine.states
  ensures run(machine, snapshot, events).value in machine.states
  decreases |events|
{
  if |events| > 0 {
    StepStaysDeclared(machine, snapshot, events[0]);
    RunStaysDeclared(machine, transition(machine, snapshot, events[0]).snapshot, events[1..]);
  }
}

// The initial snapshot uses the configured context, or an empty one.
lemma InitialContext(machine: Machine)
  ensures initialState(machine).context == (if machine.context.Some? then machine.context.value else map[])
{
}

lemma InitialDeclared(machine: Machine)
  requires TargetsDeclared(machine)
  ensures initialState(machine).value in machine.states
{
}

// Running one event is one transition.
lemma RunSingleEvent(machine: Machine, snapshot: Snapshot, event: FSMEvent)
  ensures run(machine, snapshot, [event]) == transition(machine, snapshot, event).snapshot
{
  assert [event][1..] == [];
}

lemma RunConcat(machine: Machine, snapshot: Snapshot, first: seq<FSMEvent>, second: seq<FSMEvent>)
  ensures run(machine, snapshot, first + second) == run(machine, run(machine, snapshot, first), second)
  decreases |first|
{
  if |first| > 0 {
    assert (first + second)[1..] == first[1..] + second;
    RunConcat(machine, transition(machine, snapshot, first[0]).snapshot, first[1..], second);
  } else {
    assert first + second == second;
  }
}

lemma RunKeepsContextKeys(machine: Machine, snapshot: Snapshot, events: seq<FSMEvent>)
  ensures snapshot.context.Keys <= run(machine, snapshot, events).context.Keys
  decreases |events|
{
  if |events| > 0 {
    ContextKeysKept(machine, snapshot, events[0]);
    RunKeepsContextKeys(machine, transition(machine, snapshot, events[0]).snapshot, events[1..]);
  }
}
