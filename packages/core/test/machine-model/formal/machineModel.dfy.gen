        CompoundMacrostep(false, false, step, queue, [])
      else
        if (|queue| == 0) then
          CompoundMacrostep(true, false, step, queue, [])
        else
          if !(ready(machine, step.snapshot, queue[0])) then
            CompoundMacrostep(false, true, step, queue, [])
          else
            var next := compoundTransition(machine, step.snapshot, queue[0]);
            var rest := compoundSettle(machine, CompoundStep(next.snapshot, (step.snapshotReused && next.snapshotReused), (step.contextReused && next.contextReused), (step.effects + next.effects), (step.raised + next.raised)), (queue[1..] + next.raised), (remaining - 1));
            CompoundMacrostep(rest.settled, rest.refused, rest.step, rest.queue, ([next] + rest.trace))
}

function compoundInitialMacrostep(machine: CompoundMachine, event: Event, maxIterations: int): CompoundMacrostep
  requires (machine.root in machine.nodes)
  requires declaredPath(machine.nodes, lookupNode(machine.nodes, machine.root).initialPath)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
{
  var first := compoundInitialTransition(machine, event);
  compoundSettle(machine, first, first.raised, maxIterations)
}

function compoundMacrostep(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event, maxIterations: int): CompoundMacrostep
  requires declaredPath(machine.nodes, snapshot.path)
  requires ready(machine, snapshot, event)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
{
  var first := compoundTransition(machine, snapshot, event);
  compoundSettle(machine, first, first.raised, maxIterations)
}

function below(path: seq<string>, prefix: seq<string>): bool
{
  ((|path| > |prefix|) && (commonPrefix(path, prefix) == |prefix|))
}

lemma below_ensures(path: seq<string>, prefix: seq<string>)
  ensures (below(path, prefix) ==> (|path| > |prefix|))
{
}

function samePath(a: seq<string>, b: seq<string>): bool
{
  ((|a| == |b|) && (commonPrefix(a, b) == |a|))
}

lemma samePath_ensures(a: seq<string>, b: seq<string>)
  ensures (samePath(a, b) ==> (|a| == |b|))
{
}

function completes(nodes: map<string, CompoundNode>, parallels: seq<string>, target: seq<string>, path: seq<string>): bool
  decreases |path|
{
  ((|path| < 2) || (var id := path[0]; (if !((id in nodes)) then false else (var node := lookupNode(nodes, id); (var child := path[1]; (var allowed := ((id in parallels) || (if below(target, node.path) then (child == target[|node.path|]) else (match node.initial { case Some(i_value) => (i_value == child) case None => false }))); (allowed && completes(nodes, parallels, target, path[1..]))))))))
}

lemma completes_ensures(nodes: map<string, CompoundNode>, parallels: seq<string>, target: seq<string>, path: seq<string>)
  ensures ((|path| < 2) ==> completes(nodes, parallels, target, path))
{
}

function entering(nodes: map<string, CompoundNode>, parallels: seq<string>, target: seq<string>, domain: seq<string>, extra: Option<string>, id: string): bool
{
  if !((id in nodes)) then
    false
  else
    ((match extra { case Some(i_value) => (i_value == id) case None => false }) || (var path := lookupNode(nodes, id).path; (below(path, domain) && completes(nodes, parallels, target, path[(if (|domain| == 0) then 0 else (|domain| - 1))..]))))
}

function exiting(nodes: map<string, CompoundNode>, domain: seq<string>, reentered: Option<string>, id: string): bool
{
  if !((id in nodes)) then
    false
  else
    ((match reentered { case Some(i_value) => (i_value == id) case None => false }) || below(lookupNode(nodes, id).path, domain))
}

function narrow(parallels: seq<string>, target: seq<string>, domain: seq<string>): seq<string>
  decreases (|target| - |domain|)
{
  if ((|domain| == 0) || !(below(target, domain))) then
    domain
  else
    if !((domain[(|domain| - 1)] in parallels)) then
      domain
    else
      narrow(parallels, target, target[0..(|domain| + 1)])
}

function compoundAncestor(parallels: seq<string>, path: seq<string>): seq<string>
  decreases |path|
{
  if (|path| <= 1) then
    []
  else
    var parent := path[0..(|path| - 1)];
    if !((parent[(|parent| - 1)] in parallels)) then
      parent
    else
      compoundAncestor(parallels, parent)
}

function transitionDomain(parallels: seq<string>, source: seq<string>, target: seq<string>, reenter: bool): seq<string>
{
  if (commonPrefix(source, target) == |source|) then
    if reenter then
      source
    else
      narrow(parallels, target, source)
  else
    if (|target| == 0) then
      []
    else
      var ancestors := target[0..(|target| - 1)];
      var lca := commonPrefix(source, ancestors);
      if ((lca > 0) && (source[(lca - 1)] in parallels)) then
        compoundAncestor(parallels, source[0..lca])
      else
        if reenter then
          source[0..lca]
        else
          narrow(parallels, target, (if (lca == 0) then target[0..1] else source[0..lca]))
}

function runLifecycle(nodes: map<string, CompoundNode>, path: seq<string>, context: map<string, int>, event: Event, exiting: bool): Applied
{
  if !(declaredPath(nodes, path)) then
    Applied(context, true, [], [])
  else
    lifecycle(nodes, path, context, event, exiting)
}

function isActiveLeaf(nodes: map<string, CompoundNode>, active: seq<string>, id: string): bool
{
  if !((id in nodes)) then
    false
  else
    var path := lookupNode(nodes, id).path;
    !((exists other :: other in active && ((other in nodes) && below(lookupNode(nodes, other).path, path))))
}

function hasSelectionId(selections: seq<Selection>, id: string): bool
  decreases |selections|
{
  if (|selections| == 0) then
    false
  else
    ((selections[0].id == id) || hasSelectionId(selections[1..], id))
}

function leafSelections(nodes: map<string, CompoundNode>, active: seq<string>, candidates: seq<string>, context: map<string, int>, event: Event, seen: seq<Selection>): seq<Selection>
  decreases |candidates|
{
  if (|candidates| == 0) then
    seen
  else
    var id := candidates[0];
    var rest := candidates[1..];
    if !(isActiveLeaf(nodes, active, id)) then
      leafSelections(nodes, active, rest, context, event, seen)
    else
      var path := lookupNode(nodes, id).path;
      if !(declaredPath(nodes, path)) then
        leafSelections(nodes, active, rest, context, event, seen)
      else
        var picked := select(nodes, path, context, event);
        match picked {
          case Some(i_picked_val) =>
            if hasSelectionId(seen, i_picked_val.id) then
              leafSelections(nodes, active, rest, context, event, seen)
            else
              leafSelections(nodes, active, rest, context, event, (seen + [i_picked_val]))
          case None =>
            leafSelections(nodes, active, rest, context, event, seen)
        }
}

function parallelSelections(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): seq<Selection>
{
  leafSelections(machine.nodes, snapshot.active, snapshot.active, snapshot.context, event, [])
}

function parallelReady(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): bool
{
  var selections := parallelSelections(machine, snapshot, event);
  ((|selections| == 0) || (if (|selections| > 1) then false else (var result := selections[0].evaluation.result; (match result { case Some(i_result_val) => (var target := i_result_val.target; (match target { case Some(i_target_val) => (if !((i_target_val in machine.nodes)) then false else (var targetPath := lookupNode(machine.nodes, i_target_val).path; ((|targetPath| < 2) || !(((targetPath[(|targetPath| - 2)] in machine.parallels) && (i_target_val in snapshot.active)))))) case None => true })) case None => true }))))
}

function parallelInitialTransition(machine: ParallelMachine, event: Event): ParallelStep
{
  var nodes := machine.nodes;
  var parallels := machine.parallels;
  var target := (if (machine.root in nodes) then lookupNode(nodes, machine.root).path else []);
  var entries := SeqFilter((id: string) => entering(nodes, parallels, target, [], None, id), machine.order);
  var entered := runLifecycle(nodes, entries, machine.context, event, false);
  ParallelStep(ParallelSnapshot(entries, entered.context), false, entered.reused, entered.effects)
}

lemma parallelInitialTransition_ensures(machine: ParallelMachine, event: Event)
  ensures !(parallelInitialTransition(machine, event).snapshotReused)
{
}

function parallelPlan(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool): ParallelPlan
{
  var nodes := machine.nodes;
  var parallels := machine.parallels;
  var sourcePath := (if (source in nodes) then lookupNode(nodes, source).path else []);
  var targetPath := (if (target in nodes) then lookupNode(nodes, target).path else []);
  var domain := transitionDomain(parallels, sourcePath, targetPath, reenter);
  var reentered := (if (reenter && samePath(domain, sourcePath)) then Option.Some(source) else Option.None);
  var extra := (match reentered { case Some(i_reentered_val) => Option.Some(i_reentered_val) case None => (if (samePath(domain, targetPath) && (target != source)) then Option.Some(target) else Option.None) });
  var exits := reverse(SeqFilter((id: string) => exiting(nodes, domain, reentered, id), active));
  var entries := SeqFilter((id: string) => entering(nodes, parallels, targetPath, domain, extra, id), machine.order);
  var next := SeqFilter((id: string) => (((id in active) && !(exiting(nodes, domain, reentered, id))) || entering(nodes, parallels, targetPath, domain, extra, id)), machine.order);
  ParallelPlan(domain, reentered, extra, exits, entries, next)
}

function parallelTransition(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): ParallelStep
{
  var selections := parallelSelections(machine, snapshot, event);
  if (|selections| == 0) then
    ParallelStep(snapshot, true, true, [])
  else
    var selected := selections[0];
    var nodes := machine.nodes;
    var result := selected.evaluation.result;
    var target := (match result { case Some(i_result_val) => i_result_val.target case None => Option.None });
    var reenter := (match result { case Some(i_result_val) => i_result_val.reenter case None => false });
    match target {
      case Some(i_target_val) =>
        if !((i_target_val in nodes)) then
          var updated := apply(snapshot.context, selected.evaluation);
          ParallelStep(ParallelSnapshot(snapshot.active, updated.context), false, updated.reused, updated.effects)
        else
          var plan := parallelPlan(machine, snapshot.active, selected.id, i_target_val, reenter);
          var exited := runLifecycle(nodes, plan.exits, snapshot.context, event, true);
          var updated := apply(exited.context, selected.evaluation);
          var entered := runLifecycle(nodes, plan.entries, updated.context, event, false);
          ParallelStep(ParallelSnapshot(plan.active, entered.context), false, ((exited.reused && updated.reused) && entered.reused), ((exited.effects + updated.effects) + entered.effects))
      case None =>
        var updated := apply(snapshot.context, selected.evaluation);
        ParallelStep(ParallelSnapshot(snapshot.active, updated.context), false, updated.reused, updated.effects)
    }
}

lemma parallelTransition_ensures(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  ensures (parallelTransition(machine, snapshot, event).snapshotReused ==> (parallelTransition(machine, snapshot, event).snapshot == snapshot))
{
}

function selectionPlan(machine: ParallelMachine, active: seq<string>, selection: Selection): Option<ParallelPlan>
{
  var result := selection.evaluation.result;
  match result {
    case Some(i_result_val) =>
      var target := i_result_val.target;
      match target {
        case Some(i_target_val) =>
          if !((i_target_val in machine.nodes)) then
            None
          else
            Some(parallelPlan(machine, active, selection.id, i_target_val, i_result_val.reenter))
        case None =>
          None
      }
    case None =>
      None
  }
}

function conflictExits(machine: ParallelMachine, active: seq<string>, selection: Selection): seq<string>
{
  var plan := selectionPlan(machine, active, selection);
  match plan {
    case Some(i_plan_val) =>
      i_plan_val.exits
    case None =>
      []
  }
}

function overlaps(a: seq<string>, b: seq<string>): bool
{
  (exists id :: id in a && (id in b))
}

function preempts(machine: ParallelMachine, active: seq<string>, candidate: Selection, kept: Selection): bool
{
  (overlaps(conflictExits(machine, active, candidate), conflictExits(machine, active, kept)) && !(below(candidate.node.path, kept.node.path)))
}

function anyPreempts(machine: ParallelMachine, active: seq<string>, candidate: Selection, kept: seq<Selection>): bool
  decreases |kept|
{
  if (|kept| == 0) then
    false
  else
    (preempts(machine, active, candidate, kept[0]) || anyPreempts(machine, active, candidate, kept[1..]))
}

function removeConflicts(machine: ParallelMachine, active: seq<string>, pending: seq<Selection>, kept: seq<Selection>): seq<Selection>
  decreases |pending|
{
  if (|pending| == 0) then
    kept
  else
    var first := pending[0];
    var rest := pending[1..];
    if anyPreempts(machine, active, first, kept) then
      removeConflicts(machine, active, rest, kept)
    else
      var exits := conflictExits(machine, active, first);
      var survivors := SeqFilter((other: Selection) => !(overlaps(exits, conflictExits(machine, active, other))), kept);
      removeConflicts(machine, active, rest, (survivors + [first]))
}

function selectionPlans(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>): seq<ParallelPlan>
  decreases |selections|
{
  if (|selections| == 0) then
    []
  else
    var plan := selectionPlan(machine, active, selections[0]);
    var rest := selectionPlans(machine, active, selections[1..]);
    match plan {
      case Some(i_plan_val) =>
        ([i_plan_val] + rest)
      case None =>
        rest
    }
}

lemma selectionPlans_ensures(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  ensures (|selectionPlans(machine, active, selections)| <= |selections|)
{
}

function plansExit(plans: seq<ParallelPlan>, id: string): bool
{
  (exists plan :: plan in plans && (id in plan.exits))
}

function plansEnter(plans: seq<ParallelPlan>, id: string): bool
{
  (exists plan :: plan in plans && (id in plan.entries))
}

function applyAll(context: map<string, int>, selections: seq<Selection>): Applied
  decreases |selections|
{
  if (|selections| == 0) then
    Applied(context, true, [], [])
  else
    var first := apply(context, selections[0].evaluation);
    var rest := applyAll(first.context, selections[1..]);
    Applied(rest.context, (first.reused && rest.reused), (first.effects + rest.effects), (first.raises + rest.raises))
}

lemma applyAll_ensures(context: map<string, int>, selections: seq<Selection>)
  ensures ((|selections| == 0) ==> (applyAll(context, selections).context == context))
{
}

function selectionReady(machine: ParallelMachine, active: seq<string>, selection: Selection): bool
{
  var result := selection.evaluation.result;
  match result {
    case Some(i_result_val) =>
      var target := i_result_val.target;
      match target {
        case Some(i_target_val) =>
          if !((i_target_val in machine.nodes)) then
            false
          else
            var targetPath := lookupNode(machine.nodes, i_target_val).path;
            ((|targetPath| < 2) || !(((targetPath[(|targetPath| - 2)] in machine.parallels) && (i_target_val in active))))
        case None =>
          true
      }
    case None =>
      true
  }
}

function comparable(a: seq<string>, b: seq<string>): bool
{
  var shared := commonPrefix(a, b);
  ((shared == |a|) || (shared == |b|))
}

function sourceApart(path: seq<string>, selections: seq<Selection>): bool
  decreases |selections|
{
  ((|selections| == 0) || (!(comparable(path, selections[0].node.path)) && sourceApart(path, selections[1..])))
}

function sourcesApart(selections: seq<Selection>): bool
  decreases |selections|
{
  ((|selections| == 0) || (var first := selections[0]; (var rest := selections[1..]; (sourceApart(first.node.path, rest) && sourcesApart(rest)))))
}

function domainsApart(plans: seq<ParallelPlan>): bool
  decreases |plans|
{
  ((|plans| == 0) || (var first := plans[0]; (var rest := plans[1..]; (!((exists other :: other in rest && comparable(first.domain, other.domain))) && domainsApart(rest)))))
}

function multiReady(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>): bool
{
  SeqAll(selections, (selection: Selection) => selectionReady(machine, active, selection))
}

function parallelStepReady(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): bool
{
  var selections := parallelSelections(machine, snapshot, event);
  if (|selections| < 2) then
    parallelReady(machine, snapshot, event)
  else
    multiReady(machine, snapshot.active, selections)
}

function parallelStep(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): ParallelStep
{
  var selections := parallelSelections(machine, snapshot, event);
  if (|selections| < 2) then
    parallelTransition(machine, snapshot, event)
  else
    var nodes := machine.nodes;
    var active := snapshot.active;
    var kept := removeConflicts(machine, active, selections, []);
    var plans := selectionPlans(machine, active, kept);
    var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
    var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
    var next := SeqFilter((id: string) => (((id in active) && !(plansExit(plans, id))) || plansEnter(plans, id)), machine.order);
    var exited := runLifecycle(nodes, exits, snapshot.context, event, true);
    var updated := applyAll(exited.context, kept);
    var entered := runLifecycle(nodes, entries, updated.context, event, false);
    ParallelStep(ParallelSnapshot(next, entered.context), false, ((exited.reused && updated.reused) && entered.reused), ((exited.effects + updated.effects) + entered.effects))
}

lemma parallelStep_ensures(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  ensures (parallelStep(machine, snapshot, event).snapshotReused ==> (parallelStep(machine, snapshot, event).snapshot == snapshot))
{
}

function parallelParts(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): ParallelParts
{
  var selections := parallelSelections(machine, snapshot, event);
  var nodes := machine.nodes;
  if (|selections| == 0) then
    ParallelParts([], [], snapshot.context)
  else
    if (|selections| < 2) then
      var selected := selections[0];
      var result := selected.evaluation.result;
      var target := (match result { case Some(i_result_val) => i_result_val.target case None => Option.None });
      var reenter := (match result { case Some(i_result_val) => i_result_val.reenter case None => false });
      match target {
        case Some(i_target_val) =>
          if !((i_target_val in nodes)) then
            var updated := apply(snapshot.context, selected.evaluation);
            ParallelParts(updated.raises, [], updated.context)
          else
            var plan := parallelPlan(machine, snapshot.active, selected.id, i_target_val, reenter);
            var exited := runLifecycle(nodes, plan.exits, snapshot.context, event, true);
            var updated := apply(exited.context, selected.evaluation);
            ParallelParts((exited.raises + updated.raises), plan.entries, updated.context)
        case None =>
          var updated := apply(snapshot.context, selected.evaluation);
          ParallelParts(updated.raises, [], updated.context)
      }
    else
      var active := snapshot.active;
      var kept := removeConflicts(machine, active, selections, []);
      var plans := selectionPlans(machine, active, kept);
      var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
      var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
      var exited := runLifecycle(nodes, exits, snapshot.context, event, true);
      var updated := applyAll(exited.context, kept);
      ParallelParts((exited.raises + updated.raises), entries, updated.context)
}

function activeAt(next: seq<string>, entries: seq<string>, index: int, id: string): bool
{
  if !((id in next)) then
    false
  else
    if (index < 0) then
      !((id in entries))
    else
      (((index + 1) >= |entries|) || !((id in entries[(index + 1)..])))
}

function finalAt(machine: ParallelMachine, next: seq<string>, entries: seq<string>, index: int, id: string, fuel: int): bool
  decreases fuel
{
  if ((fuel <= 0) || !((id in machine.nodes))) then
    false
  else
    var nodes := machine.nodes;
    var node := lookupNode(nodes, id);
    if (id in machine.parallels) then
      SeqAll(node.children, (child: string) => finalAt(machine, next, entries, index, child, (fuel - 1)))
    else
      if (|node.children| == 0) then
        node.final
      else
        (exists child :: child in node.children && (((child in nodes) && lookupNode(nodes, child).final) && activeAt(next, entries, index, child)))
}

function queuedOutput(queue: seq<Event>, type_: string, missing: int): int
  decreases |queue|
{
  if (|queue| == 0) then
    missing
  else
    if (queue[0].type_ == type_) then
      queue[0].value
    else
      queuedOutput(queue[1..], type_, missing)
}

function finalChildOutput(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, children: seq<string>): int
  decreases |children|
{
  if (|children| == 0) then
    outputs.missing
  else
    var child := children[0];
    if (((child in machine.nodes) && lookupNode(machine.nodes, child).final) && activeAt(next, entries, index, child)) then
      var own := lookupNode(machine.nodes, child).output;
      own(context, event)
    else
      finalChildOutput(machine, outputs, next, entries, index, context, event, children[1..])
}

function regionOutput(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, region: string): int
{
  if !((region in machine.nodes)) then
    outputs.missing
  else
    var node := lookupNode(machine.nodes, region);
    if node.final then
      var own := node.output;
      own(context, event)
    else
      if (region in machine.parallels) then
        queuedOutput(queue, doneEvent(region, 0).type_, outputs.missing)
      else
        finalChildOutput(machine, outputs, next, entries, index, context, event, node.children)
}

function regionOutputs(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, regions: seq<string>): seq<int>
  decreases |regions|
{
  if (|regions| == 0) then
    []
  else
    ([regionOutput(machine, outputs, next, entries, index, context, event, queue, regions[0])] + regionOutputs(machine, outputs, next, entries, index, context, event, queue, regions[1..]))
}

lemma regionOutputs_ensures(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, regions: seq<string>)
  ensures (|regionOutputs(machine, outputs, next, entries, index, context, event, queue, regions)| == |regions|)
{
}

function climb(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, completed: seq<string>, marker: string, fuel: int): ParallelClimb
  decreases fuel
{
  if (((((fuel <= 0) || !((marker in machine.nodes))) || !((marker in machine.parallels))) || (marker in completed)) || !(finalAt(machine, next, entries, index, marker, |machine.order|))) then
    ParallelClimb([], completed, false, None)
  else
    var node := lookupNode(machine.nodes, marker);
    var combine := outputs.regions;
    var done := doneEvent(marker, combine(marker, regionOutputs(machine, outputs, next, entries, index, context, event, queue, node.children)));
    var path := node.path;
    if (|path| < 2) then
      var rootOutput := outputs.output;
      ParallelClimb([done], (completed + [marker]), true, Some(rootOutput(context, done)))
    else
      var rest := climb(machine, outputs, next, entries, index, context, event, (queue + [done]), (completed + [marker]), path[(|path| - 2)], (fuel - 1));
      ParallelClimb(([done] + rest.raised), rest.completed, rest.done, rest.output)
}

function finalEntered(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, completed: seq<string>): ParallelClimb
{
  var none := ParallelClimb([], completed, false, None);
  if ((index < 0) || (index >= |entries|)) then
    none
  else
    var id := entries[index];
    if !((id in machine.nodes)) then
      none
    else
      var node := lookupNode(machine.nodes, id);
      var path := node.path;
      if (!(node.final) || (|path| < 2)) then
        none
      else
        var parent := path[(|path| - 2)];
        var fuel := |machine.order|;
        if (parent in machine.parallels) then
          climb(machine, outputs, next, entries, index, context, event, queue, completed, parent, fuel)
        else
          var own := node.output;
          var finalOutput := own(context, event);
          var done := doneEvent(parent, finalOutput);
          if (|path| < 3) then
            var rootOutput := outputs.output;
            ParallelClimb([done], completed, true, Some((if outputs.hasOutput then rootOutput(context, doneEvent(id, finalOutput)) else finalOutput)))
          else
            var rest := climb(machine, outputs, next, entries, index, context, event, (queue + [done]), completed, path[(|path| - 3)], fuel);
            ParallelClimb(([done] + rest.raised), rest.completed, rest.done, rest.output)
}

function parallelEnter(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, completed: seq<string>): ParallelEntered
  decreases (|entries| - index)
{
  if ((index < 0) || (index >= |entries|)) then
    ParallelEntered(context, true, [], [], completed, false, None)
  else
    var entered := runLifecycle(machine.nodes, [entries[index]], context, event, false);
    var queued := (queue + entered.raises);
    var final := finalEntered(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    var rest := parallelEnter(machine, outputs, next, entries, (index + 1), entered.context, event, (queued + final.raised), final.completed);
    ParallelEntered(rest.context, (entered.reused && rest.reused), (entered.effects + rest.effects), ((entered.raises + final.raised) + rest.raised), rest.completed, (final.done || rest.done), (if rest.done then rest.output else final.output))
}

function parallelFinish(machine: ParallelMachine, step: ParallelStep, parts: ParallelParts, entered: ParallelEntered, event: Event): ParallelMicro
{
  var raised := (parts.raised + entered.raised);
  if !(entered.done) then
    ParallelMicro(ParallelState(step.snapshot, false, None), step.snapshotReused, step.contextReused, step.effects, raised)
  else
    var active := step.snapshot.active;
    var exited := runLifecycle(machine.nodes, reverse(active), step.snapshot.context, event, true);
    ParallelMicro(ParallelState(ParallelSnapshot(active, exited.context), true, entered.output), false, (step.contextReused && exited.reused), (step.effects + exited.effects), raised)
}

function parallelInitialMicro(machine: ParallelMachine, outputs: ParallelOutputs, event: Event): ParallelMicro
{
  var step := parallelInitialTransition(machine, event);
  var entries := step.snapshot.active;
  var parts := ParallelParts([], entries, machine.context);
  var entered := parallelEnter(machine, outputs, entries, entries, 0, machine.context, event, [], []);
  parallelFinish(machine, step, parts, entered, event)
}

function parallelMicrostep(machine: ParallelMachine, outputs: ParallelOutputs, state: ParallelState, event: Event, pending: seq<Event>): ParallelMicro
{
  var unchanged_ := ParallelMicro(state, true, true, [], []);
  if state.done then
    unchanged_
  else
    var step := parallelStep(machine, state.snapshot, event);
    if step.snapshotReused then
      unchanged_
    else
      var parts := parallelParts(machine, state.snapshot, event);
      var entered := parallelEnter(machine, outputs, step.snapshot.active, parts.entries, 0, parts.entryContext, event, (pending + parts.raised), []);
      parallelFinish(machine, step, parts, entered, event)
}

lemma parallelMicrostep_ensures(machine: ParallelMachine, outputs: ParallelOutputs, state: ParallelState, event: Event, pending: seq<Event>)
  ensures (parallelMicrostep(machine, outputs, state, event, pending).snapshotReused ==> (parallelMicrostep(machine, outputs, state, event, pending).state == state))
{
}

function parallelSettle(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro, queue: seq<Event>, remaining: int): ParallelMacrostep
  decreases remaining
{
  if step.state.done then
    ParallelMacrostep(true, false, step, [], [])
  else
    if (remaining <= 0) then
      ParallelMacrostep(false, false, step, queue, [])
    else
      if (|queue| == 0) then
        ParallelMacrostep(true, false, step, queue, [])
      else
        if !(parallelStepReady(machine, step.state.snapshot, queue[0])) then
          ParallelMacrostep(false, true, step, queue, [])
        else
          var next := parallelMicrostep(machine, outputs, step.state, queue[0], queue[1..]);
          var rest := parallelSettle(machine, outputs, ParallelMicro(next.state, (step.snapshotReused && next.snapshotReused), (step.contextReused && next.contextReused), (step.effects + next.effects), (step.raised + next.raised)), (queue[1..] + next.raised), (remaining - 1));
          ParallelMacrostep(rest.settled, rest.refused, rest.step, rest.queue, ([next] + rest.trace))
}

function parallelInitialMacrostep(machine: ParallelMachine, outputs: ParallelOutputs, event: Event, maxIterations: int): ParallelMacrostep
{
  var first := parallelInitialMicro(machine, outputs, event);
  parallelSettle(machine, outputs, first, first.raised, maxIterations)
}

function parallelMacrostep(machine: ParallelMachine, outputs: ParallelOutputs, state: ParallelState, event: Event, maxIterations: int): ParallelMacrostep
{
  var first := parallelMicrostep(machine, outputs, state, event, []);
  parallelSettle(machine, outputs, first, first.raised, maxIterations)
}
