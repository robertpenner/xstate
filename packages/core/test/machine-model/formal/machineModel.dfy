lemma LastPatchCons(first: PatchEntry, rest: seq<PatchEntry>, key: string)
  ensures LastPatchValue([first] + rest, key) ==
    (if LastPatchValue(rest, key).Some? then LastPatchValue(rest, key)
     else if first.key == key then Some(first.value) else None)
  decreases |rest|
{
  if |rest| > 0 {
    LastPatchCons(first, rest[..|rest| - 1], key);
    assert ([first] + rest)[..|rest|] == [first] + rest[..|rest| - 1];
  }
}

