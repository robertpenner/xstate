ghost function LastPatchValue(patch: seq<PatchEntry>, key: string): Option<int>
  decreases |patch|
{
  if |patch| == 0 then None
  else if patch[|patch| - 1].key == key then Some(patch[|patch| - 1].value)
  else LastPatchValue(patch[..|patch| - 1], key)
}

lemma LastPatchCons(first: PatchEntry, rest: seq<PatchEntry>, key: string)
  ensures LastPatchValue([first] + rest, key) ==
    (if LastPatchValue(rest, key).Some? then LastPatchValue(rest, key)
     else if first.key == key then Some(first.value) else None)
  decreases |rest|
{
  if |rest| > 0 {
    LastPatchCons(first, rest[..|rest| - 1], key);
    assert ([first] + rest)[..|rest|] == [first] + rest[..|rest| - 1];
  }
}

lemma MergeMeaning(context: map<string, int>, patch: seq<PatchEntry>, key: string)
  ensures key in mergePatch(context, patch) <==>
    key in context || LastPatchValue(patch, key).Some?
  ensures key in mergePatch(context, patch) ==>
    mergePatch(context, patch)[key] ==
      (if LastPatchValue(patch, key).Some? then LastPatchValue(patch, key).value
       else context[key])
  decreases |patch|
{
  if |patch| > 0 {
    MergeMeaning(context[patch[0].key := patch[0].value], patch[1..], key);
    LastPatchCons(patch[0], patch[1..], key);
    assert patch == [patch[0]] + patch[1..];
  }
}

