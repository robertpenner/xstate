  requires declaredPath(nodes, path)
  ensures ((|path| == 0) ==> (match select(nodes, path, context, event) { case Some(i_) => false case None => true }))
{
}

function commonPrefix(a: seq<string>, b: seq<string>): int
  decreases |a|
  ensures 0 <= commonPrefix(a, b) <= |a|
  ensures commonPrefix(a, b) <= |b|
  ensures a[..commonPrefix(a, b)] == b[..commonPrefix(a, b)]
{
  if ((|a| == 0) || (|b| == 0)) then
    0
  else
    if (a[0] != b[0]) then
      0
    else
      (1 + commonPrefix(a[1..], b[1..]))
}

lemma commonPrefix_ensures(a: seq<string>, b: seq<string>)
  ensures (0 <= commonPrefix(a, b))
  ensures (commonPrefix(a, b) <= |a|)
  ensures (commonPrefix(a, b) <= |b|)
{
}

function initialWitness(nodes: map<string, CompoundNode>, id: string): bool
  requires (id in nodes)
{
  var node := lookupNode(nodes, id);
  if (|node.path| > |node.initialPath|) then
    false
  else
    var initial := node.initial;
    match initial {
      case Some(i_initial_val) =>
        if !((i_initial_val in nodes)) then
          false
        else
          var child := lookupNode(nodes, i_initial_val);
          (((|child.path| > |node.path|) && (|child.initialPath| == |node.initialPath|)) && (commonPrefix(child.initialPath, node.initialPath) == |node.initialPath|))
      case None =>
        ((|node.path| == |node.initialPath|) && (commonPrefix(node.path, node.initialPath) == |node.path|))
    }
}

function descend(nodes: map<string, CompoundNode>, id: string): seq<string>
  requires (id in nodes)
  requires forall k :: ((k in nodes) ==> initialWitness(nodes, k))
  ensures descend(nodes, id) == lookupNode(nodes, id).initialPath
  decreases (|lookupNode(nodes, id).initialPath| - |lookupNode(nodes, id).path|)
{
  assert initialWitness(nodes, id);
  var node := lookupNode(nodes, id);
  var initial := node.initial;
  match initial {
    case Some(i_initial_val) =>
      descend(nodes, i_initial_val)
    case None =>
      node.path
  }
}

lemma descend_ensures(nodes: map<string, CompoundNode>, id: string)
  requires (id in nodes)
  requires forall k :: ((k in nodes) ==> initialWitness(nodes, k))
  ensures (descend(nodes, id) == lookupNode(nodes, id).initialPath)
{
}

function reverse(path: seq<string>): seq<string>
  decreases |path|
  ensures |reverse(path)| == |path|
  ensures forall id :: id in reverse(path) <==> id in path
{
  if (|path| == 0) then
    []
  else
    (reverse(path[1..]) + [path[0]])
}

lemma reverse_ensures(path: seq<string>)
  ensures (|reverse(path)| == |path|)
{
}

function lifecycle(nodes: map<string, CompoundNode>, path: seq<string>, context: map<string, int>, event: Event, exiting: bool): Applied
  requires declaredPath(nodes, path)
  decreases |path|
  ensures |path| == 0 ==> lifecycle(nodes, path, context, event, exiting) == Applied(context, true, [], [])
{
  if (|path| == 0) then
    Applied(context, true, [], [])
  else
    var node := lookupNode(nodes, path[0]);
    var exit := node.exit;
    var entry := node.entry;
    var evaluation := (if exiting then exit(context, event) else entry(context, event));
    var first := apply(context, evaluation);
    var rest := lifecycle(nodes, path[1..], first.context, event, exiting);
    Applied(rest.context, (first.reused && rest.reused), (first.effects + rest.effects), (first.raises + rest.raises))
}

lemma lifecycle_ensures(nodes: map<string, CompoundNode>, path: seq<string>, context: map<string, int>, event: Event, exiting: bool)
  requires declaredPath(nodes, path)
  ensures ((|path| == 0) ==> (lifecycle(nodes, path, context, event, exiting).context == context))
{
}

function ready(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event): bool
  requires declaredPath(machine.nodes, snapshot.path)
{
  var selected := select(machine.nodes, snapshot.path, snapshot.context, event);
  match selected {
    case Some(i_selected_val) =>
      var sourcePath := i_selected_val.node.path;
      if (|sourcePath| == 0) then
        false
      else
        if (commonPrefix(sourcePath, snapshot.path) != |sourcePath|) then
          false
        else
          var result := i_selected_val.evaluation.result;
          match result {
            case Some(i_result_val) =>
              var target := i_result_val.target;
              match target {
                case Some(i_target_val) =>
                  if !((i_target_val in machine.nodes)) then
                    false
                  else
                    var destination := lookupNode(machine.nodes, i_target_val);
                    if (|destination.path| == 0) then
                      false
                    else
                      if (commonPrefix(destination.path, destination.initialPath) != |destination.path|) then
                        false
                      else
                        declaredPath(machine.nodes, destination.initialPath)
                case None =>
                  true
              }
            case None =>
              true
          }
    case None =>
      true
  }
}

function compoundDone(machine: CompoundMachine, path: seq<string>): bool
  requires declaredPath(machine.nodes, path)
{
  if (|path| < 2) then
    false
  else
    if (path[(|path| - 2)] != machine.root) then
      false
    else
      lookupNode(machine.nodes, path[(|path| - 1)]).final
}

function compoundCompletion(machine: CompoundMachine, path: seq<string>, entering: bool, context: map<string, int>, event: Event): CompoundCompletion
  requires declaredPath(machine.nodes, path)
{
  if (!(entering) || (|path| < 2)) then
    CompoundCompletion(context, true, [], [], None)
  else
    var leafId := path[(|path| - 1)];
    var leaf := lookupNode(machine.nodes, leafId);
    if !(leaf.final) then
      CompoundCompletion(context, true, [], [], None)
    else
      var leafOutput := leaf.output;
      var finalOutput := leafOutput(context, event);
      var parentId := path[(|path| - 2)];
      if (parentId != machine.root) then
        CompoundCompletion(context, true, [], [doneEvent(parentId, finalOutput)], None)
      else
        var rootOutput := machine.output;
        var output := (if machine.hasOutput then rootOutput(context, doneEvent(leafId, finalOutput)) else finalOutput);
        var exited := lifecycle(machine.nodes, reverse(path), context, event, true);
        CompoundCompletion(exited.context, exited.reused, exited.effects, [], Some(output))
}

function compoundInitialTransition(machine: CompoundMachine, event: Event): CompoundStep
  requires (machine.root in machine.nodes)
  requires declaredPath(machine.nodes, lookupNode(machine.nodes, machine.root).initialPath)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
{
  var path := descend(machine.nodes, machine.root);
  var entered := lifecycle(machine.nodes, path, machine.context, event, false);
  var done := compoundCompletion(machine, path, true, entered.context, event);
  CompoundStep(CompoundSnapshot(path, done.context, done.output), false, (entered.reused && done.reused), (entered.effects + done.effects), (entered.raises + done.raised))
}

lemma compoundInitialTransition_ensures(machine: CompoundMachine, event: Event)
  requires (machine.root in machine.nodes)
  requires declaredPath(machine.nodes, lookupNode(machine.nodes, machine.root).initialPath)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
  ensures !(compoundInitialTransition(machine, event).snapshotReused)
{
}

function compoundTransition(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event): CompoundStep
  requires declaredPath(machine.nodes, snapshot.path)
  requires ready(machine, snapshot, event)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
{
  if compoundDone(machine, snapshot.path) then
    CompoundStep(snapshot, true, true, [], [])
  else
    var selected := select(machine.nodes, snapshot.path, snapshot.context, event);
    match selected {
      case Some(i_selected_val) =>
        var result := i_selected_val.evaluation.result;
        var target := (match result { case Some(i_result_val) => i_result_val.target case None => Option.None });
        var reenter := (match result { case Some(i_result_val) => i_result_val.reenter case None => false });
        var nextPath := (match target { case Some(i_target_val) => descend(machine.nodes, i_target_val) case None => snapshot.path });
        var targetPath := (match target { case Some(i_target_val) => lookupNode(machine.nodes, i_target_val).path case None => [] });
        var sourcePath := i_selected_val.node.path;
        var contained := (commonPrefix(sourcePath, targetPath) == |sourcePath|);
        var targetAncestors := (if (|targetPath| == 0) then [] else targetPath[0..(|targetPath| - 1)]);
        var kept := (if contained then (|sourcePath| - (if reenter then 1 else 0)) else commonPrefix(sourcePath, targetAncestors));
        var exitKept := (if ((match target { case Some(i_value) => (i_value == machine.root) case None => false }) && !(reenter)) then 1 else kept);
        var exitPath := (match target { case Some(i_target_val) => reverse(snapshot.path[exitKept..]) case None => [] });
        var entryPath := (match target { case Some(i_target_val) => nextPath[kept..] case None => [] });
        var exited := lifecycle(machine.nodes, exitPath, snapshot.context, event, true);
        var updated := apply(exited.context, i_selected_val.evaluation);
        var entered := lifecycle(machine.nodes, entryPath, updated.context, event, false);
        var done := compoundCompletion(machine, nextPath, (|entryPath| > 0), entered.context, event);
        CompoundStep(CompoundSnapshot(nextPath, done.context, done.output), false, (((exited.reused && updated.reused) && entered.reused) && done.reused), (((exited.effects + updated.effects) + entered.effects) + done.effects), (((exited.raises + updated.raises) + entered.raises) + done.raised))
      case None =>
        CompoundStep(snapshot, true, true, [], [])
    }
}

lemma compoundTransition_ensures(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event)
  requires declaredPath(machine.nodes, snapshot.path)
  requires ready(machine, snapshot, event)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
  ensures (compoundTransition(machine, snapshot, event).snapshotReused ==> (compoundTransition(machine, snapshot, event).snapshot == snapshot))
{
}

function compoundSettle(machine: CompoundMachine, step: CompoundStep, queue: seq<Event>, remaining: int): CompoundMacrostep
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
  decreases remaining
{
  if !(declaredPath(machine.nodes, step.snapshot.path)) then
    CompoundMacrostep(false, true, step, queue, [])
  else
    if compoundDone(machine, step.snapshot.path) then
      CompoundMacrostep(true, false, step, [], [])
    else
      if (remaining <= 0) then
        CompoundMacrostep(false, false, step, queue, [])
      else
        if (|queue| == 0) then
          CompoundMacrostep(true, false, step, queue, [])
        else
          if !(ready(machine, step.snapshot, queue[0])) then
            CompoundMacrostep(false, true, step, queue, [])
          else
            var next := compoundTransition(machine, step.snapshot, queue[0]);
            var rest := compoundSettle(machine, CompoundStep(next.snapshot, (step.snapshotReused && next.snapshotReused), (step.contextReused && next.contextReused), (step.effects + next.effects), (step.raised + next.raised)), (queue[1..] + next.raised), (remaining - 1));
            CompoundMacrostep(rest.settled, rest.refused, rest.step, rest.queue, ([next] + rest.trace))
}

function compoundInitialMacrostep(machine: CompoundMachine, event: Event, maxIterations: int): CompoundMacrostep
  requires (machine.root in machine.nodes)
  requires declaredPath(machine.nodes, lookupNode(machine.nodes, machine.root).initialPath)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
{
  var first := compoundInitialTransition(machine, event);
  compoundSettle(machine, first, first.raised, maxIterations)
}

function compoundMacrostep(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event, maxIterations: int): CompoundMacrostep
  requires declaredPath(machine.nodes, snapshot.path)
  requires ready(machine, snapshot, event)
  requires forall k :: ((k in machine.nodes) ==> initialWitness(machine.nodes, k))
{
  var first := compoundTransition(machine, snapshot, event);
  compoundSettle(machine, first, first.raised, maxIterations)
}

function below(path: seq<string>, prefix: seq<string>): bool
{
  ((|path| > |prefix|) && (commonPrefix(path, prefix) == |prefix|))
}

lemma below_ensures(path: seq<string>, prefix: seq<string>)
  ensures (below(path, prefix) ==> (|path| > |prefix|))
{
}

function samePath(a: seq<string>, b: seq<string>): bool
{
  ((|a| == |b|) && (commonPrefix(a, b) == |a|))
}

lemma samePath_ensures(a: seq<string>, b: seq<string>)
  ensures (samePath(a, b) ==> (|a| == |b|))
{
}

function completes(nodes: map<string, CompoundNode>, parallels: seq<string>, target: seq<string>, path: seq<string>): bool
  decreases |path|
{
  ((|path| < 2) || (var id := path[0]; (if !((id in nodes)) then false else (var node := lookupNode(nodes, id); (var child := path[1]; (var allowed := ((id in parallels) || (if below(target, node.path) then (child == target[|node.path|]) else (match node.initial { case Some(i_value) => (i_value == child) case None => false }))); (allowed && completes(nodes, parallels, target, path[1..]))))))))
}

lemma completes_ensures(nodes: map<string, CompoundNode>, parallels: seq<string>, target: seq<string>, path: seq<string>)
  ensures ((|path| < 2) ==> completes(nodes, parallels, target, path))
{
}

function entering(nodes: map<string, CompoundNode>, parallels: seq<string>, target: seq<string>, domain: seq<string>, extra: Option<string>, id: string): bool
{
  if !((id in nodes)) then
    false
  else
    ((match extra { case Some(i_value) => (i_value == id) case None => false }) || (var path := lookupNode(nodes, id).path; (below(path, domain) && completes(nodes, parallels, target, path[(if (|domain| == 0) then 0 else (|domain| - 1))..]))))
}

function exiting(nodes: map<string, CompoundNode>, domain: seq<string>, reentered: Option<string>, id: string): bool
{
  if !((id in nodes)) then
    false
  else
    ((match reentered { case Some(i_value) => (i_value == id) case None => false }) || below(lookupNode(nodes, id).path, domain))
}

function narrow(parallels: seq<string>, target: seq<string>, domain: seq<string>): seq<string>
  decreases (|target| - |domain|)
{
  if ((|domain| == 0) || !(below(target, domain))) then
    domain
  else
    if !((domain[(|domain| - 1)] in parallels)) then
      domain
    else
      narrow(parallels, target, target[0..(|domain| + 1)])
}

function compoundAncestor(parallels: seq<string>, path: seq<string>): seq<string>
  decreases |path|
{
  if (|path| <= 1) then
    []
  else
    var parent := path[0..(|path| - 1)];
    if !((parent[(|parent| - 1)] in parallels)) then
      parent
    else
      compoundAncestor(parallels, parent)
}

function transitionDomain(parallels: seq<string>, source: seq<string>, target: seq<string>, reenter: bool): seq<string>
{
  if (commonPrefix(source, target) == |source|) then
    if reenter then
      source
    else
      narrow(parallels, target, source)
  else
    if (|target| == 0) then
      []
    else
      var ancestors := target[0..(|target| - 1)];
      var lca := commonPrefix(source, ancestors);
      if ((lca > 0) && (source[(lca - 1)] in parallels)) then
        compoundAncestor(parallels, source[0..lca])
      else
        if reenter then
          source[0..lca]
        else
          narrow(parallels, target, (if (lca == 0) then target[0..1] else source[0..lca]))
}

function runLifecycle(nodes: map<string, CompoundNode>, path: seq<string>, context: map<string, int>, event: Event, exiting: bool): Applied
{
  if !(declaredPath(nodes, path)) then
    Applied(context, true, [], [])
  else
    lifecycle(nodes, path, context, event, exiting)
}

function isActiveLeaf(nodes: map<string, CompoundNode>, active: seq<string>, id: string): bool
{
  if !((id in nodes)) then
    false
  else
    var path := lookupNode(nodes, id).path;
    !((exists other :: other in active && ((other in nodes) && below(lookupNode(nodes, other).path, path))))
}

function hasSelectionId(selections: seq<Selection>, id: string): bool
  decreases |selections|
{
  if (|selections| == 0) then
    false
  else
    ((selections[0].id == id) || hasSelectionId(selections[1..], id))
}

function leafSelections(nodes: map<string, CompoundNode>, active: seq<string>, candidates: seq<string>, context: map<string, int>, event: Event, seen: seq<Selection>): seq<Selection>
  decreases |candidates|
{
  if (|candidates| == 0) then
    seen
  else
    var id := candidates[0];
    var rest := candidates[1..];
    if !(isActiveLeaf(nodes, active, id)) then
      leafSelections(nodes, active, rest, context, event, seen)
    else
      var path := lookupNode(nodes, id).path;
      if !(declaredPath(nodes, path)) then
        leafSelections(nodes, active, rest, context, event, seen)
      else
        var picked := select(nodes, path, context, event);
        match picked {
          case Some(i_picked_val) =>
            if hasSelectionId(seen, i_picked_val.id) then
              leafSelections(nodes, active, rest, context, event, seen)
            else
              leafSelections(nodes, active, rest, context, event, (seen + [i_picked_val]))
          case None =>
            leafSelections(nodes, active, rest, context, event, seen)
        }
}

function parallelSelections(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): seq<Selection>
{
  leafSelections(machine.nodes, snapshot.active, snapshot.active, snapshot.context, event, [])
}

function parallelReady(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): bool
{
  var selections := parallelSelections(machine, snapshot, event);
  ((|selections| == 0) || (if (|selections| > 1) then false else (var result := selections[0].evaluation.result; (match result { case Some(i_result_val) => (var target := i_result_val.target; (match target { case Some(i_target_val) => (if !((i_target_val in machine.nodes)) then false else (var targetPath := lookupNode(machine.nodes, i_target_val).path; ((|targetPath| < 2) || !(((targetPath[(|targetPath| - 2)] in machine.parallels) && (i_target_val in snapshot.active)))))) case None => true })) case None => true }))))
}

function parallelInitialTransition(machine: ParallelMachine, event: Event): ParallelStep
{
  var nodes := machine.nodes;
  var parallels := machine.parallels;
  var target := (if (machine.root in nodes) then lookupNode(nodes, machine.root).path else []);
  var entries := SeqFilter((id: string) => entering(nodes, parallels, target, [], None, id), machine.order);
  var entered := runLifecycle(nodes, entries, machine.context, event, false);
  ParallelStep(ParallelSnapshot(entries, entered.context), false, entered.reused, entered.effects)
}

lemma parallelInitialTransition_ensures(machine: ParallelMachine, event: Event)
  ensures !(parallelInitialTransition(machine, event).snapshotReused)
{
}

function parallelPlan(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool): ParallelPlan
{
  var nodes := machine.nodes;
  var parallels := machine.parallels;
  var sourcePath := (if (source in nodes) then lookupNode(nodes, source).path else []);
  var targetPath := (if (target in nodes) then lookupNode(nodes, target).path else []);
  var domain := transitionDomain(parallels, sourcePath, targetPath, reenter);
  var reentered := (if (reenter && samePath(domain, sourcePath)) then Option.Some(source) else Option.None);
  var extra := (match reentered { case Some(i_reentered_val) => Option.Some(i_reentered_val) case None => (if (samePath(domain, targetPath) && (target != source)) then Option.Some(target) else Option.None) });
  var exits := reverse(SeqFilter((id: string) => exiting(nodes, domain, reentered, id), active));
  var entries := SeqFilter((id: string) => entering(nodes, parallels, targetPath, domain, extra, id), machine.order);
  var next := SeqFilter((id: string) => (((id in active) && !(exiting(nodes, domain, reentered, id))) || entering(nodes, parallels, targetPath, domain, extra, id)), machine.order);
  ParallelPlan(domain, reentered, extra, exits, entries, next)
}

function parallelTransition(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): ParallelStep
{
  var selections := parallelSelections(machine, snapshot, event);
  if (|selections| == 0) then
    ParallelStep(snapshot, true, true, [])
  else
    var selected := selections[0];
    var nodes := machine.nodes;
    var result := selected.evaluation.result;
    var target := (match result { case Some(i_result_val) => i_result_val.target case None => Option.None });
    var reenter := (match result { case Some(i_result_val) => i_result_val.reenter case None => false });
    match target {
      case Some(i_target_val) =>
        if !((i_target_val in nodes)) then
          var updated := apply(snapshot.context, selected.evaluation);
          ParallelStep(ParallelSnapshot(snapshot.active, updated.context), false, updated.reused, updated.effects)
        else
          var plan := parallelPlan(machine, snapshot.active, selected.id, i_target_val, reenter);
          var exited := runLifecycle(nodes, plan.exits, snapshot.context, event, true);
          var updated := apply(exited.context, selected.evaluation);
          var entered := runLifecycle(nodes, plan.entries, updated.context, event, false);
          ParallelStep(ParallelSnapshot(plan.active, entered.context), false, ((exited.reused && updated.reused) && entered.reused), ((exited.effects + updated.effects) + entered.effects))
      case None =>
        var updated := apply(snapshot.context, selected.evaluation);
        ParallelStep(ParallelSnapshot(snapshot.active, updated.context), false, updated.reused, updated.effects)
    }
}

lemma parallelTransition_ensures(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  ensures (parallelTransition(machine, snapshot, event).snapshotReused ==> (parallelTransition(machine, snapshot, event).snapshot == snapshot))
{
}

function selectionPlan(machine: ParallelMachine, active: seq<string>, selection: Selection): Option<ParallelPlan>
{
  var result := selection.evaluation.result;
  match result {
    case Some(i_result_val) =>
      var target := i_result_val.target;
      match target {
        case Some(i_target_val) =>
          if !((i_target_val in machine.nodes)) then
            None
          else
            Some(parallelPlan(machine, active, selection.id, i_target_val, i_result_val.reenter))
        case None =>
          None
      }
    case None =>
      None
  }
}

function conflictExits(machine: ParallelMachine, active: seq<string>, selection: Selection): seq<string>
{
  var plan := selectionPlan(machine, active, selection);
  match plan {
    case Some(i_plan_val) =>
      i_plan_val.exits
    case None =>
      []
  }
}

function overlaps(a: seq<string>, b: seq<string>): bool
{
  (exists id :: id in a && (id in b))
}

function preempts(machine: ParallelMachine, active: seq<string>, candidate: Selection, kept: Selection): bool
{
  (overlaps(conflictExits(machine, active, candidate), conflictExits(machine, active, kept)) && !(below(candidate.node.path, kept.node.path)))
}

function anyPreempts(machine: ParallelMachine, active: seq<string>, candidate: Selection, kept: seq<Selection>): bool
  decreases |kept|
{
  if (|kept| == 0) then
    false
  else
    (preempts(machine, active, candidate, kept[0]) || anyPreempts(machine, active, candidate, kept[1..]))
}

function removeConflicts(machine: ParallelMachine, active: seq<string>, pending: seq<Selection>, kept: seq<Selection>): seq<Selection>
  decreases |pending|
{
  if (|pending| == 0) then
    kept
  else
    var first := pending[0];
    var rest := pending[1..];
    if anyPreempts(machine, active, first, kept) then
      removeConflicts(machine, active, rest, kept)
    else
      var exits := conflictExits(machine, active, first);
      var survivors := SeqFilter((other: Selection) => !(overlaps(exits, conflictExits(machine, active, other))), kept);
      removeConflicts(machine, active, rest, (survivors + [first]))
}

function selectionPlans(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>): seq<ParallelPlan>
  decreases |selections|
{
  if (|selections| == 0) then
    []
  else
    var plan := selectionPlan(machine, active, selections[0]);
    var rest := selectionPlans(machine, active, selections[1..]);
    match plan {
      case Some(i_plan_val) =>
        ([i_plan_val] + rest)
      case None =>
        rest
    }
}

lemma selectionPlans_ensures(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  ensures (|selectionPlans(machine, active, selections)| <= |selections|)
{
}

function plansExit(plans: seq<ParallelPlan>, id: string): bool
{
  (exists plan :: plan in plans && (id in plan.exits))
}

function plansEnter(plans: seq<ParallelPlan>, id: string): bool
{
  (exists plan :: plan in plans && (id in plan.entries))
}

function applyAll(context: map<string, int>, selections: seq<Selection>): Applied
  decreases |selections|
{
  if (|selections| == 0) then
    Applied(context, true, [], [])
  else
    var first := apply(context, selections[0].evaluation);
    var rest := applyAll(first.context, selections[1..]);
    Applied(rest.context, (first.reused && rest.reused), (first.effects + rest.effects), (first.raises + rest.raises))
}

lemma applyAll_ensures(context: map<string, int>, selections: seq<Selection>)
  ensures ((|selections| == 0) ==> (applyAll(context, selections).context == context))
{
}

function selectionReady(machine: ParallelMachine, active: seq<string>, selection: Selection): bool
{
  var result := selection.evaluation.result;
  match result {
    case Some(i_result_val) =>
      var target := i_result_val.target;
      match target {
        case Some(i_target_val) =>
          if !((i_target_val in machine.nodes)) then
            false
          else
            var targetPath := lookupNode(machine.nodes, i_target_val).path;
            ((|targetPath| < 2) || !(((targetPath[(|targetPath| - 2)] in machine.parallels) && (i_target_val in active))))
        case None =>
          true
      }
    case None =>
      true
  }
}

function comparable(a: seq<string>, b: seq<string>): bool
{
  var shared := commonPrefix(a, b);
  ((shared == |a|) || (shared == |b|))
}

function sourceApart(path: seq<string>, selections: seq<Selection>): bool
  decreases |selections|
{
  ((|selections| == 0) || (!(comparable(path, selections[0].node.path)) && sourceApart(path, selections[1..])))
}

function sourcesApart(selections: seq<Selection>): bool
  decreases |selections|
{
  ((|selections| == 0) || (var first := selections[0]; (var rest := selections[1..]; (sourceApart(first.node.path, rest) && sourcesApart(rest)))))
}

function domainsApart(plans: seq<ParallelPlan>): bool
  decreases |plans|
{
  ((|plans| == 0) || (var first := plans[0]; (var rest := plans[1..]; (!((exists other :: other in rest && comparable(first.domain, other.domain))) && domainsApart(rest)))))
}

function multiReady(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>): bool
{
  SeqAll(selections, (selection: Selection) => selectionReady(machine, active, selection))
}

function parallelStepReady(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): bool
{
  var selections := parallelSelections(machine, snapshot, event);
  if (|selections| < 2) then
    parallelReady(machine, snapshot, event)
  else
    multiReady(machine, snapshot.active, selections)
}

function parallelStep(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): ParallelStep
{
  var selections := parallelSelections(machine, snapshot, event);
  if (|selections| < 2) then
    parallelTransition(machine, snapshot, event)
  else
    var nodes := machine.nodes;
    var active := snapshot.active;
    var kept := removeConflicts(machine, active, selections, []);
    var plans := selectionPlans(machine, active, kept);
    var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
    var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
    var next := SeqFilter((id: string) => (((id in active) && !(plansExit(plans, id))) || plansEnter(plans, id)), machine.order);
    var exited := runLifecycle(nodes, exits, snapshot.context, event, true);
    var updated := applyAll(exited.context, kept);
    var entered := runLifecycle(nodes, entries, updated.context, event, false);
    ParallelStep(ParallelSnapshot(next, entered.context), false, ((exited.reused && updated.reused) && entered.reused), ((exited.effects + updated.effects) + entered.effects))
}

lemma parallelStep_ensures(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  ensures (parallelStep(machine, snapshot, event).snapshotReused ==> (parallelStep(machine, snapshot, event).snapshot == snapshot))
{
}

function parallelParts(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event): ParallelParts
{
  var selections := parallelSelections(machine, snapshot, event);
  var nodes := machine.nodes;
  if (|selections| == 0) then
    ParallelParts([], [], snapshot.context)
  else
    if (|selections| < 2) then
      var selected := selections[0];
      var result := selected.evaluation.result;
      var target := (match result { case Some(i_result_val) => i_result_val.target case None => Option.None });
      var reenter := (match result { case Some(i_result_val) => i_result_val.reenter case None => false });
      match target {
        case Some(i_target_val) =>
          if !((i_target_val in nodes)) then
            var updated := apply(snapshot.context, selected.evaluation);
            ParallelParts(updated.raises, [], updated.context)
          else
            var plan := parallelPlan(machine, snapshot.active, selected.id, i_target_val, reenter);
            var exited := runLifecycle(nodes, plan.exits, snapshot.context, event, true);
            var updated := apply(exited.context, selected.evaluation);
            ParallelParts((exited.raises + updated.raises), plan.entries, updated.context)
        case None =>
          var updated := apply(snapshot.context, selected.evaluation);
          ParallelParts(updated.raises, [], updated.context)
      }
    else
      var active := snapshot.active;
      var kept := removeConflicts(machine, active, selections, []);
      var plans := selectionPlans(machine, active, kept);
      var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
      var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
      var exited := runLifecycle(nodes, exits, snapshot.context, event, true);
      var updated := applyAll(exited.context, kept);
      ParallelParts((exited.raises + updated.raises), entries, updated.context)
}

function activeAt(next: seq<string>, entries: seq<string>, index: int, id: string): bool
{
  if !((id in next)) then
    false
  else
    if (index < 0) then
      !((id in entries))
    else
      (((index + 1) >= |entries|) || !((id in entries[(index + 1)..])))
}

function finalAt(machine: ParallelMachine, next: seq<string>, entries: seq<string>, index: int, id: string, fuel: int): bool
  decreases fuel
{
  if ((fuel <= 0) || !((id in machine.nodes))) then
    false
  else
    var nodes := machine.nodes;
    var node := lookupNode(nodes, id);
    if (id in machine.parallels) then
      SeqAll(node.children, (child: string) => finalAt(machine, next, entries, index, child, (fuel - 1)))
    else
      if (|node.children| == 0) then
        node.final
      else
        (exists child :: child in node.children && (((child in nodes) && lookupNode(nodes, child).final) && activeAt(next, entries, index, child)))
}

function queuedOutput(queue: seq<Event>, type_: string, missing: int): int
  decreases |queue|
{
  if (|queue| == 0) then
    missing
  else
    if (queue[0].type_ == type_) then
      queue[0].value
    else
      queuedOutput(queue[1..], type_, missing)
}

function finalChildOutput(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, children: seq<string>): int
  decreases |children|
{
  if (|children| == 0) then
    outputs.missing
  else
    var child := children[0];
    if (((child in machine.nodes) && lookupNode(machine.nodes, child).final) && activeAt(next, entries, index, child)) then
      var own := lookupNode(machine.nodes, child).output;
      own(context, event)
    else
      finalChildOutput(machine, outputs, next, entries, index, context, event, children[1..])
}

function regionOutput(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, region: string): int
{
  if !((region in machine.nodes)) then
    outputs.missing
  else
    var node := lookupNode(machine.nodes, region);
    if node.final then
      var own := node.output;
      own(context, event)
    else
      if (region in machine.parallels) then
        queuedOutput(queue, doneEvent(region, 0).type_, outputs.missing)
      else
        finalChildOutput(machine, outputs, next, entries, index, context, event, node.children)
}

function regionOutputs(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, regions: seq<string>): seq<int>
  decreases |regions|
{
  if (|regions| == 0) then
    []
  else
    ([regionOutput(machine, outputs, next, entries, index, context, event, queue, regions[0])] + regionOutputs(machine, outputs, next, entries, index, context, event, queue, regions[1..]))
}

lemma regionOutputs_ensures(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, regions: seq<string>)
  ensures (|regionOutputs(machine, outputs, next, entries, index, context, event, queue, regions)| == |regions|)
{
}

function climb(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, completed: seq<string>, marker: string, fuel: int): ParallelClimb
  decreases fuel
{
  if (((((fuel <= 0) || !((marker in machine.nodes))) || !((marker in machine.parallels))) || (marker in completed)) || !(finalAt(machine, next, entries, index, marker, |machine.order|))) then
    ParallelClimb([], completed, false, None)
  else
    var node := lookupNode(machine.nodes, marker);
    var combine := outputs.regions;
    var done := doneEvent(marker, combine(marker, regionOutputs(machine, outputs, next, entries, index, context, event, queue, node.children)));
    var path := node.path;
    if (|path| < 2) then
      var rootOutput := outputs.output;
      ParallelClimb([done], (completed + [marker]), true, Some(rootOutput(context, done)))
    else
      var rest := climb(machine, outputs, next, entries, index, context, event, (queue + [done]), (completed + [marker]), path[(|path| - 2)], (fuel - 1));
      ParallelClimb(([done] + rest.raised), rest.completed, rest.done, rest.output)
}

function finalEntered(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, completed: seq<string>): ParallelClimb
{
  var none := ParallelClimb([], completed, false, None);
  if ((index < 0) || (index >= |entries|)) then
    none
  else
    var id := entries[index];
    if !((id in machine.nodes)) then
      none
    else
      var node := lookupNode(machine.nodes, id);
      var path := node.path;
      if (!(node.final) || (|path| < 2)) then
        none
      else
        var parent := path[(|path| - 2)];
        var fuel := |machine.order|;
        if (parent in machine.parallels) then
          climb(machine, outputs, next, entries, index, context, event, queue, completed, parent, fuel)
        else
          var own := node.output;
          var finalOutput := own(context, event);
          var done := doneEvent(parent, finalOutput);
          if (|path| < 3) then
            var rootOutput := outputs.output;
            ParallelClimb([done], completed, true, Some((if outputs.hasOutput then rootOutput(context, doneEvent(id, finalOutput)) else finalOutput)))
          else
            var rest := climb(machine, outputs, next, entries, index, context, event, (queue + [done]), completed, path[(|path| - 3)], fuel);
            ParallelClimb(([done] + rest.raised), rest.completed, rest.done, rest.output)
}

function parallelEnter(machine: ParallelMachine, outputs: ParallelOutputs, next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event, queue: seq<Event>, completed: seq<string>): ParallelEntered
  decreases (|entries| - index)
{
  if ((index < 0) || (index >= |entries|)) then
    ParallelEntered(context, true, [], [], completed, false, None)
  else
    var entered := runLifecycle(machine.nodes, [entries[index]], context, event, false);
    var queued := (queue + entered.raises);
    var final := finalEntered(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    var rest := parallelEnter(machine, outputs, next, entries, (index + 1), entered.context, event, (queued + final.raised), final.completed);
    ParallelEntered(rest.context, (entered.reused && rest.reused), (entered.effects + rest.effects), ((entered.raises + final.raised) + rest.raised), rest.completed, (final.done || rest.done), (if rest.done then rest.output else final.output))
}

function parallelFinish(machine: ParallelMachine, step: ParallelStep, parts: ParallelParts, entered: ParallelEntered, event: Event): ParallelMicro
{
  var raised := (parts.raised + entered.raised);
  if !(entered.done) then
    ParallelMicro(ParallelState(step.snapshot, false, None), step.snapshotReused, step.contextReused, step.effects, raised)
  else
    var active := step.snapshot.active;
    var exited := runLifecycle(machine.nodes, reverse(active), step.snapshot.context, event, true);
    ParallelMicro(ParallelState(ParallelSnapshot(active, exited.context), true, entered.output), false, (step.contextReused && exited.reused), (step.effects + exited.effects), raised)
}

function parallelInitialMicro(machine: ParallelMachine, outputs: ParallelOutputs, event: Event): ParallelMicro
{
  var step := parallelInitialTransition(machine, event);
  var entries := step.snapshot.active;
  var parts := ParallelParts([], entries, machine.context);
  var entered := parallelEnter(machine, outputs, entries, entries, 0, machine.context, event, [], []);
  parallelFinish(machine, step, parts, entered, event)
}

function parallelMicrostep(machine: ParallelMachine, outputs: ParallelOutputs, state: ParallelState, event: Event, pending: seq<Event>): ParallelMicro
{
  var unchanged_ := ParallelMicro(state, true, true, [], []);
  if state.done then
    unchanged_
  else
    var step := parallelStep(machine, state.snapshot, event);
    if step.snapshotReused then
      unchanged_
    else
      var parts := parallelParts(machine, state.snapshot, event);
      var entered := parallelEnter(machine, outputs, step.snapshot.active, parts.entries, 0, parts.entryContext, event, (pending + parts.raised), []);
      parallelFinish(machine, step, parts, entered, event)
}

lemma parallelMicrostep_ensures(machine: ParallelMachine, outputs: ParallelOutputs, state: ParallelState, event: Event, pending: seq<Event>)
  ensures (parallelMicrostep(machine, outputs, state, event, pending).snapshotReused ==> (parallelMicrostep(machine, outputs, state, event, pending).state == state))
{
}

function parallelSettle(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro, queue: seq<Event>, remaining: int): ParallelMacrostep
  decreases remaining
{
  if step.state.done then
    ParallelMacrostep(true, false, step, [], [])
  else
    if (remaining <= 0) then
      ParallelMacrostep(false, false, step, queue, [])
    else
      if (|queue| == 0) then
        ParallelMacrostep(true, false, step, queue, [])
      else
        if !(parallelStepReady(machine, step.state.snapshot, queue[0])) then
          ParallelMacrostep(false, true, step, queue, [])
        else
          var next := parallelMicrostep(machine, outputs, step.state, queue[0], queue[1..]);
          var rest := parallelSettle(machine, outputs, ParallelMicro(next.state, (step.snapshotReused && next.snapshotReused), (step.contextReused && next.contextReused), (step.effects + next.effects), (step.raised + next.raised)), (queue[1..] + next.raised), (remaining - 1));
          ParallelMacrostep(rest.settled, rest.refused, rest.step, rest.queue, ([next] + rest.trace))
}

function parallelInitialMacrostep(machine: ParallelMachine, outputs: ParallelOutputs, event: Event, maxIterations: int): ParallelMacrostep
{
  var first := parallelInitialMicro(machine, outputs, event);
  parallelSettle(machine, outputs, first, first.raised, maxIterations)
}

function parallelMacrostep(machine: ParallelMachine, outputs: ParallelOutputs, state: ParallelState, event: Event, maxIterations: int): ParallelMacrostep
{
  var first := parallelMicrostep(machine, outputs, state, event, []);
  parallelSettle(machine, outputs, first, first.raised, maxIterations)
}

ghost predicate ParallelNodeShape(machine: ParallelMachine, id: string)
  requires id in machine.nodes
{
  var node := machine.nodes[id];
  var path := node.path;
  |path| > 0 && path[0] == machine.root && path[|path| - 1] == id &&
  (|path| > 1 ==>
    path[|path| - 2] in machine.nodes &&
    machine.nodes[path[|path| - 2]].path == path[..|path| - 1] &&
    id in machine.nodes[path[|path| - 2]].children) &&
  (forall child :: child in node.children ==>
    child in machine.nodes && machine.nodes[child].path == path + [child]) &&
  (if id in machine.parallels then node.initial == None && |node.children| > 0
   else (node.initial == None <==> |node.children| == 0) &&
        (node.initial.Some? ==> node.initial.value in node.children))
}

ghost predicate ParallelWellFormed(machine: ParallelMachine)
{
  machine.root in machine.nodes && machine.nodes[machine.root].path == [machine.root] &&
  (forall id :: id in machine.nodes ==> ParallelNodeShape(machine, id)) &&
  (forall p :: p in machine.parallels ==> p in machine.nodes) &&
  (forall i, j :: 0 <= i < j < |machine.order| ==> machine.order[i] != machine.order[j]) &&
  (forall id :: id in machine.order <==> id in machine.nodes)
}

ghost predicate Subseq(a: seq<string>, b: seq<string>)
  decreases |b|
{
  |a| == 0 || (|b| > 0 && ((a[0] == b[0] && Subseq(a[1..], b[1..])) || Subseq(a, b[1..])))
}

ghost predicate ChildrenActive(machine: ParallelMachine, active: seq<string>, id: string)
  requires id in machine.nodes
{
  var children := machine.nodes[id].children;
  if id in machine.parallels then (forall child :: child in children ==> child in active)
  else (|children| == 0 ||
    exists child :: child in children && child in active &&
      forall other :: other in children && other in active ==> other == child)
}

ghost predicate ParallelValid(machine: ParallelMachine, active: seq<string>)
{
  Subseq(active, machine.order) && machine.root in active &&
  forall id :: id in active ==>
    id in machine.nodes &&
    (|machine.nodes[id].path| > 1 ==>
      machine.nodes[id].path[|machine.nodes[id].path| - 2] in active) &&
    ChildrenActive(machine, active, id)
}

ghost predicate ActiveNodePath(machine: ParallelMachine, active: seq<string>, path: seq<string>)
{
  |path| == 0 ||
  (path[|path| - 1] in machine.nodes && machine.nodes[path[|path| - 1]].path == path &&
   path[|path| - 1] in active)
}

ghost predicate Allowed(nodes: map<string, CompoundNode>, parallels: seq<string>,
                        target: seq<string>, id: string, child: string)
  requires id in nodes
{
  id in parallels ||
  (if below(target, nodes[id].path) then child == target[|nodes[id].path|]
   else nodes[id].initial == Some(child))
}

lemma {:induction false} FilterSubseq(p: string -> bool, xs: seq<string>)
  ensures Subseq(SeqFilter(p, xs), xs)
  decreases |xs|
{
  if |xs| > 0 {
    FilterSubseq(p, xs[1..]);
    var rest := SeqFilter(p, xs[1..]);
    if p(xs[0]) {
      assert SeqFilter(p, xs) == [xs[0]] + rest;
      assert ([xs[0]] + rest)[1..] == rest;
    } else {
      assert SeqFilter(p, xs) == rest;
    }
  }
}

lemma FiltersAreSubsequences(xs: seq<string>)
  ensures forall p: string -> bool :: Subseq(SeqFilter(p, xs), xs)
{
  forall p: string -> bool
    ensures Subseq(SeqFilter(p, xs), xs)
  {
    FilterSubseq(p, xs);
  }
}

lemma {:induction false} SubseqTransitive(a: seq<string>, b: seq<string>, c: seq<string>)
  requires Subseq(a, b) && Subseq(b, c)
  ensures Subseq(a, c)
  decreases |c|
{
  if |a| > 0 {
    if b[0] == c[0] && Subseq(b[1..], c[1..]) {
      if a[0] == b[0] && Subseq(a[1..], b[1..]) {
        SubseqTransitive(a[1..], b[1..], c[1..]);
      } else {
        SubseqTransitive(a, b[1..], c[1..]);
      }
    } else {
      SubseqTransitive(a, b, c[1..]);
    }
  }
}

lemma {:induction false} ReverseSnoc(path: seq<string>, last: string)
  ensures reverse(path + [last]) == [last] + reverse(path)
  decreases |path|
{
  if |path| == 0 {
    assert reverse([last]) == reverse([last][1..]) + [last];
    assert [last][1..] == [];
  } else {
    assert (path + [last])[0] == path[0];
    assert (path + [last])[1..] == path[1..] + [last];
    ReverseSnoc(path[1..], last);
  }
}

lemma {:induction false} ReverseInvolution(path: seq<string>)
  ensures reverse(reverse(path)) == path
  decreases |path|
{
  if |path| > 0 {
    ReverseSnoc(reverse(path[1..]), path[0]);
    ReverseInvolution(path[1..]);
    assert path == [path[0]] + path[1..];
  }
}

lemma {:induction false} ReverseMembers(path: seq<string>)
  ensures forall x :: x in reverse(path) <==> x in path
  decreases |path|
{
  if |path| > 0 {
    ReverseMembers(path[1..]);
    assert path == [path[0]] + path[1..];
  }
}

lemma {:induction false} DeclaredMembers(nodes: map<string, CompoundNode>, path: seq<string>)
  ensures declaredPath(nodes, path) <==> forall x :: x in path ==> x in nodes
  decreases |path|
{
  if |path| > 0 {
    DeclaredMembers(nodes, path[1..]);
    assert path == [path[0]] + path[1..];
  }
}

lemma {:induction false} CommonPrefixMeaning(a: seq<string>, b: seq<string>)
  ensures var n := commonPrefix(a, b);
    0 <= n <= |a| && n <= |b| && a[..n] == b[..n] && (n == |a| || n == |b| || a[n] != b[n])
  decreases |a|
{
  if |a| > 0 && |b| > 0 && a[0] == b[0] {
    CommonPrefixMeaning(a[1..], b[1..]);
    var m := commonPrefix(a[1..], b[1..]);
    assert a[..m + 1] == [a[0]] + a[1..][..m];
    assert b[..m + 1] == [b[0]] + b[1..][..m];
  }
}

lemma CommonPrefixExact(a: seq<string>, b: seq<string>, k: int)
  requires 0 <= k <= |a| && k <= |b| && a[..k] == b[..k]
  requires k == |a| || k == |b| || a[k] != b[k]
  ensures commonPrefix(a, b) == k
{
  CommonPrefixMeaning(a, b);
  var n := commonPrefix(a, b);
  if n < k {
    assert a[n] == a[..k][n] && b[n] == b[..k][n];
  }
  if n > k {
    assert a[k] == a[..n][k] && b[k] == b[..n][k];
  }
}

lemma BelowMeaning(path: seq<string>, prefix: seq<string>)
  ensures below(path, prefix) <==> |path| > |prefix| && path[..|prefix|] == prefix
{
  CommonPrefixMeaning(path, prefix);
  if |path| > |prefix| && path[..|prefix|] == prefix {
    CommonPrefixExact(path, prefix, |prefix|);
  }
}

lemma SamePathMeaning(a: seq<string>, b: seq<string>)
  ensures samePath(a, b) <==> a == b
{
  CommonPrefixMeaning(a, b);
  if a == b {
    CommonPrefixExact(a, b, |a|);
  }
}

lemma BelowChild(parent: seq<string>, child: string, domain: seq<string>)
  ensures below(parent + [child], domain) <==> below(parent, domain) || parent == domain
{
  BelowMeaning(parent + [child], domain);
  BelowMeaning(parent, domain);
  if |parent| >= |domain| {
    assert (parent + [child])[..|domain|] == parent[..|domain|];
  }
}

lemma {:induction false} CompletesSnoc(nodes: map<string, CompoundNode>, parallels: seq<string>,
                                       target: seq<string>, path: seq<string>, child: string)
  requires |path| > 0
  ensures completes(nodes, parallels, target, path + [child]) <==>
    completes(nodes, parallels, target, path) && path[|path| - 1] in nodes &&
    Allowed(nodes, parallels, target, path[|path| - 1], child)
  decreases |path|
{
  if |path| == 1 {
    assert (path + [child])[1..] == [child];
  } else {
    assert (path + [child])[1..] == path[1..] + [child];
    CompletesSnoc(nodes, parallels, target, path[1..], child);
    assert path[1..][|path| - 2] == path[|path| - 1];
  }
}

lemma {:induction false} PathPrefixes(machine: ParallelMachine, id: string, i: int)
  requires ParallelWellFormed(machine) && id in machine.nodes
  requires 0 < i <= |machine.nodes[id].path|
  ensures machine.nodes[id].path[i - 1] in machine.nodes
  ensures machine.nodes[machine.nodes[id].path[i - 1]].path == machine.nodes[id].path[..i]
  decreases |machine.nodes[id].path|
{
  var path := machine.nodes[id].path;
  assert ParallelNodeShape(machine, id);
  if i < |path| {
    var parent := path[|path| - 2];
    PathPrefixes(machine, parent, i);
    assert machine.nodes[parent].path[i - 1] == path[i - 1];
    assert machine.nodes[parent].path[..i] == path[..i];
  } else {
    assert path[..i] == path;
  }
}

lemma {:induction false} AncestorsActive(machine: ParallelMachine, active: seq<string>, id: string, i: int)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active) && id in active
  requires 0 <= i < |machine.nodes[id].path|
  ensures machine.nodes[id].path[i] in active
  decreases |machine.nodes[id].path|
{
  var path := machine.nodes[id].path;
  assert ParallelNodeShape(machine, id);
  if i < |path| - 1 {
    var parent := path[|path| - 2];
    AncestorsActive(machine, active, parent, i);
  }
}

lemma {:induction false} SelectSource(nodes: map<string, CompoundNode>, path: seq<string>,
                                      context: map<string, int>, event: Event)
  requires declaredPath(nodes, path)
  ensures var selected := select(nodes, path, context, event);
    selected.Some? ==> selected.value.id in path
  decreases |path|
{
  if |path| > 0 {
    DeclaredMembers(nodes, path);
    DeclaredMembers(nodes, path[..|path| - 1]);
    SelectSource(nodes, path[..|path| - 1], context, event);
  }
}

lemma {:induction false} CompoundAncestorPrefix(parallels: seq<string>, path: seq<string>)
  ensures var anc := compoundAncestor(parallels, path);
    (|anc| < |path| || (|path| == 0 && anc == [])) &&
    anc == path[..|anc|] &&
    (|anc| > 0 ==> anc[|anc| - 1] !in parallels)
  decreases |path|
{
  if |path| > 1 {
    var parent := path[0..|path| - 1];
    if parent[|parent| - 1] in parallels {
      CompoundAncestorPrefix(parallels, parent);
    }
  }
}

lemma IsActiveLeafMeaning(nodes: map<string, CompoundNode>, active: seq<string>, id: string)
  ensures isActiveLeaf(nodes, active, id) <==>
    (id in nodes &&
      !(exists other ::
          other in active && other in nodes &&
          below(nodes[other].path, nodes[id].path)))
{
}

lemma HasSelectionIdMeaning(selections: seq<Selection>, id: string)
  ensures hasSelectionId(selections, id) <==>
    exists s :: s in selections && s.id == id
{
}

lemma {:induction false} LeafSelectionsMeaning(nodes: map<string, CompoundNode>, active: seq<string>,
                                               candidates: seq<string>, context: map<string, int>, event: Event,
                                               seen: seq<Selection>)
  ensures forall s :: s in seen ==> s in leafSelections(nodes, active, candidates, context, event, seen)
  ensures forall s :: s in leafSelections(nodes, active, candidates, context, event, seen) ==>
    s in seen ||
    exists leaf :: leaf in candidates && isActiveLeaf(nodes, active, leaf) &&
      declaredPath(nodes, nodes[leaf].path) &&
      select(nodes, nodes[leaf].path, context, event) == Some(s)
  ensures forall leaf :: (leaf in candidates && isActiveLeaf(nodes, active, leaf) &&
    declaredPath(nodes, nodes[leaf].path) &&
    select(nodes, nodes[leaf].path, context, event).Some?) ==>
      exists s :: s in leafSelections(nodes, active, candidates, context, event, seen) &&
        s.id == select(nodes, nodes[leaf].path, context, event).value.id
  decreases |candidates|
{
  if |candidates| > 0 {
    var id := candidates[0];
    var rest := candidates[1..];
    forall leaf | leaf in candidates
      ensures leaf == id || leaf in rest
    {
      var i :| 0 <= i < |candidates| && candidates[i] == leaf;
      if i > 0 { assert rest[i - 1] == leaf; }
    }
    if !isActiveLeaf(nodes, active, id) {
      LeafSelectionsMeaning(nodes, active, rest, context, event, seen);
    } else {
      var path := nodes[id].path;
      if !declaredPath(nodes, path) {
        LeafSelectionsMeaning(nodes, active, rest, context, event, seen);
      } else {
        var picked := select(nodes, path, context, event);
        if picked.None? || hasSelectionId(seen, picked.value.id) {
          LeafSelectionsMeaning(nodes, active, rest, context, event, seen);
          if picked.Some? {
            HasSelectionIdMeaning(seen, picked.value.id);
          }
        } else {
          var nextSeen := seen + [picked.value];
          LeafSelectionsMeaning(nodes, active, rest, context, event, nextSeen);
          assert picked.value in nextSeen;
        }
      }
    }
  }
}

lemma SelectionSourcesActive(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  ensures forall selected :: selected in parallelSelections(machine, snapshot, event) ==>
    selected.id in snapshot.active && selected.id in machine.nodes
{
  var nodes := machine.nodes;
  var active := snapshot.active;
  LeafSelectionsMeaning(nodes, active, active, snapshot.context, event, []);
  forall selected | selected in parallelSelections(machine, snapshot, event)
    ensures selected.id in active && selected.id in nodes
  {
    var leaf :| leaf in active && isActiveLeaf(nodes, active, leaf) &&
      declaredPath(nodes, nodes[leaf].path) &&
      select(nodes, nodes[leaf].path, snapshot.context, event) == Some(selected);
    SelectSource(nodes, nodes[leaf].path, snapshot.context, event);
    var k :| 0 <= k < |nodes[leaf].path| && nodes[leaf].path[k] == selected.id;
    AncestorsActive(machine, active, leaf, k);
  }
}

lemma {:induction false} NarrowActive(machine: ParallelMachine, active: seq<string>, target: string, domain: seq<string>)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active) && target in machine.nodes
  requires ActiveNodePath(machine, active, domain)
  ensures ActiveNodePath(machine, active, narrow(machine.parallels, machine.nodes[target].path, domain))
  decreases |machine.nodes[target].path| - |domain|
{
  var path := machine.nodes[target].path;
  if |domain| > 0 && below(path, domain) && domain[|domain| - 1] in machine.parallels {
    var k := |domain|;
    var parallel := domain[k - 1];
    BelowMeaning(path, domain);
    PathPrefixes(machine, target, k + 1);
    var region := path[k];
    assert ParallelNodeShape(machine, region);
    assert machine.nodes[region].path == path[..k + 1];
    assert path[..k + 1][k - 1] == domain[k - 1];
    assert region in machine.nodes[parallel].children;
    assert ChildrenActive(machine, active, parallel);
    assert path[0..k + 1] == path[..k + 1];
    assert ActiveNodePath(machine, active, path[0..k + 1]);
    NarrowActive(machine, active, target, path[0..k + 1]);
  }
}

lemma {:isolate_assertions} DomainActive(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures ActiveNodePath(machine, active,
    transitionDomain(machine.parallels, machine.nodes[source].path, machine.nodes[target].path, reenter))
{
  var sourcePath := machine.nodes[source].path;
  var targetPath := machine.nodes[target].path;
  assert ParallelNodeShape(machine, source);
  assert ParallelNodeShape(machine, target);
  assert ParallelNodeShape(machine, machine.root);
  assert ActiveNodePath(machine, active, sourcePath);
  var domain := transitionDomain(machine.parallels, sourcePath, targetPath, reenter);
  if commonPrefix(sourcePath, targetPath) == |sourcePath| {
    if !reenter {
      assert domain == narrow(machine.parallels, targetPath, sourcePath);
      NarrowActive(machine, active, target, sourcePath);
    }
  } else {
    var ancestors := targetPath[0..|targetPath| - 1];
    var lca := commonPrefix(sourcePath, ancestors);
    CommonPrefixMeaning(sourcePath, ancestors);
    if lca > 0 {
      PathPrefixes(machine, source, lca);
      AncestorsActive(machine, active, source, lca - 1);
      assert sourcePath[0..lca] == sourcePath[..lca];
      assert ActiveNodePath(machine, active, sourcePath[0..lca]);
      if sourcePath[lca - 1] in machine.parallels {
        assert domain == compoundAncestor(machine.parallels, sourcePath[0..lca]);
        CompoundAncestorPrefix(machine.parallels, sourcePath[0..lca]);
        if |domain| > 0 {
          PathPrefixes(machine, source, |domain|);
          AncestorsActive(machine, active, source, |domain| - 1);
          assert ActiveNodePath(machine, active, domain);
        }
      } else if !reenter {
        assert domain == narrow(machine.parallels, targetPath, sourcePath[0..lca]);
        NarrowActive(machine, active, target, sourcePath[0..lca]);
      }
    } else if !reenter {
      assert targetPath[0..1] == [machine.root];
      assert ActiveNodePath(machine, active, [machine.root]);
      assert domain == narrow(machine.parallels, targetPath, targetPath[0..1]);
      NarrowActive(machine, active, target, targetPath[0..1]);
    }
  }
}

lemma KnownSource(machine: ParallelMachine, active: seq<string>, source: string)
  requires ParallelValid(machine, active) && source in active
  ensures source in machine.nodes
{
}

ghost predicate PlanDomainFacts(machine: ParallelMachine, active: seq<string>, source: string, target: string,
                                reenter: bool, plan: ParallelPlan)
  requires source in machine.nodes && target in machine.nodes
{
  var nodes := machine.nodes;
  plan.domain == transitionDomain(machine.parallels, nodes[source].path, nodes[target].path, reenter) &&
  ActiveNodePath(machine, active, plan.domain) &&
  (plan.reentered.Some? ==> plan.reentered.value == source && nodes[source].path == plan.domain) &&
  (plan.reentered.Some? ==> plan.extra == plan.reentered) &&
  (!reenter ==> plan.reentered.None?) &&
  (plan.extra.Some? ==>
    (plan.extra.value in nodes && plan.extra.value in active && nodes[plan.extra.value].path == plan.domain))
}

ghost predicate PlanMemberFacts(machine: ParallelMachine, active: seq<string>, target: string, plan: ParallelPlan)
  requires target in machine.nodes
{
  var nodes := machine.nodes;
  var targetPath := nodes[target].path;
  (forall id :: id in plan.active <==>
    (id in nodes &&
     ((id in active && !exiting(nodes, plan.domain, plan.reentered, id)) ||
      entering(nodes, machine.parallels, targetPath, plan.domain, plan.extra, id)))) &&
  (forall id :: id in plan.exits <==> id in active && exiting(nodes, plan.domain, plan.reentered, id)) &&
  (forall id :: id in plan.entries <==>
    entering(nodes, machine.parallels, targetPath, plan.domain, plan.extra, id))
}

ghost predicate PlanOrderFacts(machine: ParallelMachine, active: seq<string>, plan: ParallelPlan)
{
  Subseq(plan.active, machine.order) && Subseq(plan.entries, machine.order) &&
  Subseq(reverse(plan.exits), active)
}

lemma PlanDomain(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures PlanDomainFacts(machine, active, source, target, reenter,
    parallelPlan(machine, active, source, target, reenter))
{
  var plan := parallelPlan(machine, active, source, target, reenter);
  DomainActive(machine, active, source, target, reenter);
  SamePathMeaning(plan.domain, machine.nodes[source].path);
  SamePathMeaning(plan.domain, machine.nodes[target].path);
  assert ParallelNodeShape(machine, source);
  assert ParallelNodeShape(machine, target);
}

lemma PlanMembers(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures PlanMemberFacts(machine, active, target, parallelPlan(machine, active, source, target, reenter))
{
  var nodes := machine.nodes;
  var plan := parallelPlan(machine, active, source, target, reenter);
  var kept := SeqFilter((id: string) => exiting(nodes, plan.domain, plan.reentered, id), active);
  assert plan.exits == reverse(kept);
}

lemma PlanNextOrder(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  ensures Subseq(parallelPlan(machine, active, source, target, reenter).active, machine.order)
{
  FiltersAreSubsequences(machine.order);
}

lemma PlanEntryOrder(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  ensures Subseq(parallelPlan(machine, active, source, target, reenter).entries, machine.order)
{
  FiltersAreSubsequences(machine.order);
}

lemma PlanExitOrder(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  ensures Subseq(reverse(parallelPlan(machine, active, source, target, reenter).exits), active)
{
  var plan := parallelPlan(machine, active, source, target, reenter);
  var kept := SeqFilter((id: string) => exiting(machine.nodes, plan.domain, plan.reentered, id), active);
  assert plan.exits == reverse(kept);
  ReverseInvolution(kept);
  FilterSubseq((id: string) => exiting(machine.nodes, plan.domain, plan.reentered, id), active);
}

lemma PlanOrders(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  ensures PlanOrderFacts(machine, active, parallelPlan(machine, active, source, target, reenter))
{
  PlanNextOrder(machine, active, source, target, reenter);
  PlanEntryOrder(machine, active, source, target, reenter);
  PlanExitOrder(machine, active, source, target, reenter);
}

ghost predicate PlanFacts(machine: ParallelMachine, active: seq<string>, source: string, target: string,
                          reenter: bool, plan: ParallelPlan)
  requires source in machine.nodes && target in machine.nodes
{
  PlanDomainFacts(machine, active, source, target, reenter, plan) &&
  PlanMemberFacts(machine, active, target, plan) && PlanOrderFacts(machine, active, plan)
}

lemma PlanContext(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures PlanFacts(machine, active, source, target, reenter,
    parallelPlan(machine, active, source, target, reenter))
{
  PlanDomain(machine, active, source, target, reenter);
  PlanMembers(machine, active, source, target, reenter);
  PlanOrders(machine, active, source, target, reenter);
}

ghost function DomainStart(domain: seq<string>): int
{
  if |domain| == 0 then 0 else |domain| - 1
}

ghost predicate ActiveClosed(machine: ParallelMachine, active: seq<string>)
{
  forall id :: id in active ==>
    id in machine.nodes &&
    (|machine.nodes[id].path| > 1 ==>
      machine.nodes[id].path[|machine.nodes[id].path| - 2] in active) &&
    ChildrenActive(machine, active, id)
}

ghost predicate NextShape(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                          target: string, domain: seq<string>)
  requires target in machine.nodes
{
  var nodes := machine.nodes;
  var targetPath := nodes[target].path;
  ActiveNodePath(machine, active, domain) &&
  (forall id :: id in next ==> id in nodes) &&
  (forall id :: id in nodes && below(nodes[id].path, domain) ==>
    (id in next <==> completes(nodes, machine.parallels, targetPath, nodes[id].path[DomainStart(domain)..]))) &&
  (forall id :: id in nodes && nodes[id].path == domain ==> id in next) &&
  (forall id :: id in nodes && !below(nodes[id].path, domain) && nodes[id].path != domain ==>
    (id in next <==> id in active))
}

lemma PathEnds(machine: ParallelMachine, id: string)
  requires ParallelWellFormed(machine) && id in machine.nodes
  ensures |machine.nodes[id].path| > 0 && machine.nodes[id].path[|machine.nodes[id].path| - 1] == id
{
  assert ParallelNodeShape(machine, id);
}

lemma PlanShape(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures NextShape(machine, active, parallelPlan(machine, active, source, target, reenter).active,
    target, parallelPlan(machine, active, source, target, reenter).domain)
{
  hide *;
  reveal PlanFacts(), PlanDomainFacts(), PlanMemberFacts(), NextShape(), ActiveNodePath(), exiting(), entering();
  reveal DomainStart(), below();
  var nodes := machine.nodes;
  var plan := parallelPlan(machine, active, source, target, reenter);
  var domain := plan.domain;
  var targetPath := nodes[target].path;
  KnownSource(machine, active, source);
  PlanContext(machine, active, source, target, reenter);
  forall id | id in nodes && nodes[id].path == domain
    ensures id in plan.active
  {
    PathEnds(machine, id);
    BelowMeaning(nodes[id].path, domain);
    if plan.reentered.Some? {
      PathEnds(machine, source);
      assert entering(nodes, machine.parallels, targetPath, domain, plan.extra, id);
    } else {
      assert !exiting(nodes, domain, plan.reentered, id);
    }
  }
  forall id | id in nodes && below(nodes[id].path, domain)
    ensures id in plan.active <==>
      completes(nodes, machine.parallels, targetPath, nodes[id].path[DomainStart(domain)..])
  {
    BelowMeaning(nodes[id].path, domain);
    assert exiting(nodes, domain, plan.reentered, id);
    assert plan.extra != Some(id);
  }
  forall id | id in nodes && !below(nodes[id].path, domain) && nodes[id].path != domain
    ensures id in plan.active <==> id in active
  {
    assert plan.reentered != Some(id);
    assert plan.extra != Some(id);
    assert !exiting(nodes, domain, plan.reentered, id);
    assert !entering(nodes, machine.parallels, targetPath, domain, plan.extra, id);
  }
}

lemma InitialShape(machine: ParallelMachine, event: Event)
  requires ParallelWellFormed(machine)
  ensures NextShape(machine, [], parallelInitialTransition(machine, event).snapshot.active, machine.root, [])
{
  var nodes := machine.nodes;
  var entries := parallelInitialTransition(machine, event).snapshot.active;
  forall id | id in nodes
    ensures id in entries <==> completes(nodes, machine.parallels, [machine.root], nodes[id].path)
  {
    assert ParallelNodeShape(machine, id);
    BelowMeaning(nodes[id].path, []);
    assert nodes[id].path[0..] == nodes[id].path;
  }
  forall id | id in nodes ensures below(nodes[id].path, [])
  {
    assert ParallelNodeShape(machine, id);
    BelowMeaning(nodes[id].path, []);
  }
}

lemma AllowedChildren(machine: ParallelMachine, next: seq<string>, target: string, id: string)
  requires ParallelWellFormed(machine) && target in machine.nodes && id in machine.nodes
  requires forall child :: child in machine.nodes[id].children ==>
    (child in next <==> Allowed(machine.nodes, machine.parallels, machine.nodes[target].path, id, child))
  ensures ChildrenActive(machine, next, id)
{
  var nodes := machine.nodes;
  var path := nodes[id].path;
  var targetPath := nodes[target].path;
  var children := nodes[id].children;
  assert ParallelNodeShape(machine, id);
  if id !in machine.parallels && |children| > 0 {
    var chosen;
    if below(targetPath, path) {
      BelowMeaning(targetPath, path);
      PathPrefixes(machine, target, |path| + 1);
      chosen := targetPath[|path|];
      assert ParallelNodeShape(machine, chosen);
      assert nodes[chosen].path == targetPath[..|path| + 1];
      assert targetPath[..|path| + 1][|path| - 1] == path[|path| - 1];
      assert chosen in children;
    } else {
      chosen := nodes[id].initial.value;
    }
    assert chosen in next;
    assert forall other :: other in children && other in next ==> other == chosen;
  }
}

lemma ShapeAt(machine: ParallelMachine, active: seq<string>, next: seq<string>,
               target: string, domain: seq<string>, id: string)
  requires target in machine.nodes && id in machine.nodes
  requires NextShape(machine, active, next, target, domain)
  ensures below(machine.nodes[id].path, domain) ==>
    (id in next <==> completes(machine.nodes, machine.parallels, machine.nodes[target].path,
      machine.nodes[id].path[DomainStart(domain)..]))
  ensures machine.nodes[id].path == domain ==> id in next
  ensures !below(machine.nodes[id].path, domain) && machine.nodes[id].path != domain ==>
    (id in next <==> id in active)
{
}

lemma ShapeChildrenInside(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                          target: string, domain: seq<string>, id: string)
  requires ParallelWellFormed(machine) && target in machine.nodes && id in machine.nodes
  requires NextShape(machine, active, next, target, domain) && id in next
  requires below(machine.nodes[id].path, domain) || machine.nodes[id].path == domain
  ensures ChildrenActive(machine, next, id)
{
  var nodes := machine.nodes;
  var path := nodes[id].path;
  var targetPath := nodes[target].path;
  var children := nodes[id].children;
  assert ParallelNodeShape(machine, id);
  BelowMeaning(path, domain);
  ShapeAt(machine, active, next, target, domain, id);
  var start := DomainStart(domain);
  var tail := path[start..];
  assert |tail| > 0 && tail[|tail| - 1] == id;
  if path == domain {
    completes_ensures(nodes, machine.parallels, targetPath, tail);
  }
  assert completes(nodes, machine.parallels, targetPath, tail);
  forall child | child in children
    ensures child in next <==> Allowed(nodes, machine.parallels, targetPath, id, child)
  {
    BelowChild(path, child, domain);
    assert child in nodes && nodes[child].path == path + [child];
    ShapeAt(machine, active, next, target, domain, child);
    assert (path + [child])[start..] == tail + [child];
    CompletesSnoc(nodes, machine.parallels, targetPath, tail, child);
  }
  AllowedChildren(machine, next, target, id);
}

lemma ShapeChildrenOutside(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                           target: string, domain: seq<string>, id: string)
  requires ParallelWellFormed(machine) && target in machine.nodes && id in machine.nodes
  requires NextShape(machine, active, next, target, domain)
  requires id in active && ChildrenActive(machine, active, id)
  requires !below(machine.nodes[id].path, domain) && machine.nodes[id].path != domain
  ensures ChildrenActive(machine, next, id)
{
  var nodes := machine.nodes;
  var path := nodes[id].path;
  var children := nodes[id].children;
  assert ParallelNodeShape(machine, id);
  forall child | child in children
    ensures child in next <==> child in active
  {
    BelowChild(path, child, domain);
    assert child in nodes && nodes[child].path == path + [child];
    ShapeAt(machine, active, next, target, domain, child);
    if path + [child] == domain {
      assert domain[|domain| - 1] == child;
    }
  }
  if id !in machine.parallels && |children| > 0 {
    var chosen :| chosen in children && chosen in active &&
      forall other :: other in children && other in active ==> other == chosen;
    assert chosen in next;
  }
}

lemma ShapeChildren(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                    target: string, domain: seq<string>, id: string)
  requires ParallelWellFormed(machine) && ActiveClosed(machine, active) && target in machine.nodes
  requires NextShape(machine, active, next, target, domain) && id in next
  ensures ChildrenActive(machine, next, id)
{
  var path := machine.nodes[id].path;
  if below(path, domain) || path == domain {
    ShapeChildrenInside(machine, active, next, target, domain, id);
  } else {
    ShapeAt(machine, active, next, target, domain, id);
    ShapeChildrenOutside(machine, active, next, target, domain, id);
  }
}

lemma ShapeParentInside(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                        target: string, domain: seq<string>, id: string)
  requires ParallelWellFormed(machine) && target in machine.nodes && id in machine.nodes
  requires NextShape(machine, active, next, target, domain) && id in next
  requires |machine.nodes[id].path| > 1 && below(machine.nodes[id].path, domain)
  ensures machine.nodes[id].path[|machine.nodes[id].path| - 2] in next
{
  var nodes := machine.nodes;
  var path := nodes[id].path;
  var targetPath := nodes[target].path;
  assert ParallelNodeShape(machine, id);
  var parent := path[|path| - 2];
  var parentPath := path[..|path| - 1];
  assert parent in nodes && nodes[parent].path == parentPath;
  assert path == parentPath + [id];
  BelowChild(parentPath, id, domain);
  ShapeAt(machine, active, next, target, domain, id);
  ShapeAt(machine, active, next, target, domain, parent);
  if below(parentPath, domain) {
    BelowMeaning(parentPath, domain);
    var start := DomainStart(domain);
    assert path[start..] == parentPath[start..] + [id];
    CompletesSnoc(nodes, machine.parallels, targetPath, parentPath[start..], id);
  }
}

lemma ShapeParentOutside(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                         target: string, domain: seq<string>, id: string)
  requires ParallelWellFormed(machine) && target in machine.nodes && id in machine.nodes
  requires NextShape(machine, active, next, target, domain)
  requires |machine.nodes[id].path| > 1 && !below(machine.nodes[id].path, domain)
  requires machine.nodes[id].path[|machine.nodes[id].path| - 2] in active
  ensures machine.nodes[id].path[|machine.nodes[id].path| - 2] in next
{
  var nodes := machine.nodes;
  var path := nodes[id].path;
  assert ParallelNodeShape(machine, id);
  var parent := path[|path| - 2];
  var parentPath := path[..|path| - 1];
  assert parent in nodes && nodes[parent].path == parentPath;
  assert path == parentPath + [id];
  BelowChild(parentPath, id, domain);
  ShapeAt(machine, active, next, target, domain, parent);
}

lemma ShapeParent(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                  target: string, domain: seq<string>, id: string)
  requires ParallelWellFormed(machine) && ActiveClosed(machine, active) && target in machine.nodes
  requires NextShape(machine, active, next, target, domain) && id in next
  requires |machine.nodes[id].path| > 1
  ensures machine.nodes[id].path[|machine.nodes[id].path| - 2] in next
{
  var path := machine.nodes[id].path;
  if below(path, domain) {
    ShapeParentInside(machine, active, next, target, domain, id);
  } else {
    ShapeAt(machine, active, next, target, domain, id);
    if path == domain {
      assert ParallelNodeShape(machine, id);
      assert domain[|domain| - 1] == id;
    }
    assert id in active;
    ShapeParentOutside(machine, active, next, target, domain, id);
  }
}

lemma ShapeRoot(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                target: string, domain: seq<string>)
  requires ParallelWellFormed(machine) && target in machine.nodes
  requires NextShape(machine, active, next, target, domain)
  requires machine.root in active || domain == []
  ensures machine.root in next
{
  var nodes := machine.nodes;
  BelowMeaning([machine.root], domain);
  if below([machine.root], domain) {
    completes_ensures(nodes, machine.parallels, nodes[target].path, [machine.root][DomainStart(domain)..]);
  }
}

lemma ShapeValid(machine: ParallelMachine, active: seq<string>, next: seq<string>,
                 target: string, domain: seq<string>)
  requires ParallelWellFormed(machine) && ActiveClosed(machine, active) && target in machine.nodes
  requires NextShape(machine, active, next, target, domain)
  requires machine.root in active || domain == []
  requires Subseq(next, machine.order)
  ensures ParallelValid(machine, next)
{
  ShapeRoot(machine, active, next, target, domain);
  forall id | id in next
    ensures id in machine.nodes &&
      (|machine.nodes[id].path| > 1 ==> machine.nodes[id].path[|machine.nodes[id].path| - 2] in next) &&
      ChildrenActive(machine, next, id)
  {
    ShapeChildren(machine, active, next, target, domain, id);
    if |machine.nodes[id].path| > 1 {
      ShapeParent(machine, active, next, target, domain, id);
    }
  }
}

lemma ParallelInitialValid(machine: ParallelMachine, event: Event)
  requires ParallelWellFormed(machine)
  ensures ParallelValid(machine, parallelInitialTransition(machine, event).snapshot.active)
{
  InitialShape(machine, event);
  FiltersAreSubsequences(machine.order);
  ShapeValid(machine, [], parallelInitialTransition(machine, event).snapshot.active, machine.root, []);
}

lemma PlanValid(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures ParallelValid(machine, parallelPlan(machine, active, source, target, reenter).active)
{
  var plan := parallelPlan(machine, active, source, target, reenter);
  PlanShape(machine, active, source, target, reenter);
  PlanNextOrder(machine, active, source, target, reenter);
  ShapeValid(machine, active, plan.active, target, plan.domain);
}

lemma ParallelStepValid(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  ensures ParallelValid(machine, parallelTransition(machine, snapshot, event).snapshot.active)
{
  var selections := parallelSelections(machine, snapshot, event);
  if |selections| > 0 {
    SelectionSourcesActive(machine, snapshot, event);
    var selected := selections[0];
    var result := selected.evaluation.result;
    if result.Some? && result.value.target.Some? && result.value.target.value in machine.nodes {
      PlanValid(machine, snapshot.active, selected.id, result.value.target.value, result.value.reenter);
    }
  }
}

lemma ParallelLifecycleOrder(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  ensures Subseq(parallelPlan(machine, active, source, target, reenter).entries, machine.order)
  ensures Subseq(reverse(parallelPlan(machine, active, source, target, reenter).exits), machine.order)
{
  var plan := parallelPlan(machine, active, source, target, reenter);
  PlanEntryOrder(machine, active, source, target, reenter);
  PlanExitOrder(machine, active, source, target, reenter);
  SubseqTransitive(reverse(plan.exits), active, machine.order);
}

lemma PlanPreservesOutsideDomain(machine: ParallelMachine, active: seq<string>, source: string, target: string,
                                 reenter: bool, id: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes && id in active
  requires !below(machine.nodes[id].path, parallelPlan(machine, active, source, target, reenter).domain)
  requires parallelPlan(machine, active, source, target, reenter).reentered != Some(id)
  ensures id in parallelPlan(machine, active, source, target, reenter).active
  ensures id !in parallelPlan(machine, active, source, target, reenter).exits
{
  var plan := parallelPlan(machine, active, source, target, reenter);
  PlanContext(machine, active, source, target, reenter);
  assert PlanMemberFacts(machine, active, target, plan);
  assert !exiting(machine.nodes, plan.domain, plan.reentered, id);
}

ghost predicate InRegion(path: seq<string>, region: seq<string>)
{
  |path| >= |region| && path[..|region|] == region
}

lemma CrossRegionDomain(parallelPath: seq<string>, sourcePath: seq<string>, targetPath: seq<string>)
  requires |parallelPath| > 0
  requires below(sourcePath, parallelPath) && below(targetPath, parallelPath)
  requires sourcePath[|parallelPath|] != targetPath[|parallelPath|]
  ensures commonPrefix(sourcePath, targetPath) != |sourcePath|
  ensures commonPrefix(sourcePath, targetPath[0..|targetPath| - 1]) == |parallelPath|
{
  var k := |parallelPath|;
  BelowMeaning(sourcePath, parallelPath);
  BelowMeaning(targetPath, parallelPath);
  CommonPrefixExact(sourcePath, targetPath, k);
  var ancestors := targetPath[0..|targetPath| - 1];
  assert ancestors[..k] == parallelPath;
  CommonPrefixExact(sourcePath, ancestors, k);
}

lemma CrossDomain(machine: ParallelMachine, source: string, target: string, parallel: string)
  requires ParallelWellFormed(machine) && source in machine.nodes && target in machine.nodes
  requires parallel in machine.parallels
  requires below(machine.nodes[source].path, machine.nodes[parallel].path)
  requires below(machine.nodes[target].path, machine.nodes[parallel].path)
  requires machine.nodes[source].path[|machine.nodes[parallel].path|] !=
    machine.nodes[target].path[|machine.nodes[parallel].path|]
  ensures transitionDomain(machine.parallels, machine.nodes[source].path, machine.nodes[target].path, false) ==
    compoundAncestor(machine.parallels, machine.nodes[parallel].path)
  ensures transitionDomain(machine.parallels, machine.nodes[source].path, machine.nodes[target].path, true) ==
    compoundAncestor(machine.parallels, machine.nodes[parallel].path)
{
  hide *;
  reveal transitionDomain;
  assert parallel in machine.nodes by { reveal ParallelWellFormed; }
  var parallelPath := machine.nodes[parallel].path;
  var sourcePath := machine.nodes[source].path;
  var targetPath := machine.nodes[target].path;
  var depth := |parallelPath|;
  PathEnds(machine, parallel);
  BelowMeaning(sourcePath, parallelPath);
  BelowMeaning(targetPath, parallelPath);
  CrossRegionDomain(parallelPath, sourcePath, targetPath);
  assert sourcePath[0..depth] == parallelPath;
  assert sourcePath[depth - 1] == parallel;
}

lemma KnownNodes(machine: ParallelMachine, active: seq<string>, source: string, parallel: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && parallel in machine.parallels
  ensures source in machine.nodes && parallel in machine.nodes
{
}

lemma CrossRegionExitsParallel(machine: ParallelMachine, active: seq<string>, source: string, target: string, parallel: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  requires parallel in machine.parallels
  requires below(machine.nodes[source].path, machine.nodes[parallel].path)
  requires below(machine.nodes[target].path, machine.nodes[parallel].path)
  requires machine.nodes[source].path[|machine.nodes[parallel].path|] !=
    machine.nodes[target].path[|machine.nodes[parallel].path|]
  ensures var plan := parallelPlan(machine, active, source, target, reenter);
    plan.domain == compoundAncestor(machine.parallels, machine.nodes[parallel].path) &&
    (parallel in active ==> parallel in plan.exits) &&
    forall id ::
      (id in active && id in machine.nodes && below(machine.nodes[id].path, machine.nodes[parallel].path)) ==>
        id in plan.exits
{
  hide *;
  reveal below, PlanDomainFacts, PlanMemberFacts, exiting;
  KnownNodes(machine, active, source, parallel);
  var nodes := machine.nodes;
  var parallelPath := nodes[parallel].path;
  var plan := parallelPlan(machine, active, source, target, reenter);
  CrossDomain(machine, source, target, parallel);
  PlanDomain(machine, active, source, target, reenter);
  PlanMembers(machine, active, source, target, reenter);
  assert plan.domain == compoundAncestor(machine.parallels, parallelPath);
  CompoundAncestorPrefix(machine.parallels, parallelPath);
  assert |parallelPath| > 0 by {
    reveal ParallelWellFormed, ParallelNodeShape;
    assert ParallelNodeShape(machine, parallel);
  }
  BelowMeaning(parallelPath, plan.domain);
  assert below(parallelPath, plan.domain);
  forall id | id in active && id in nodes && below(nodes[id].path, parallelPath)
    ensures id in plan.exits
  {
    BelowMeaning(nodes[id].path, parallelPath);
    BelowMeaning(nodes[id].path, plan.domain);
  }
}

lemma ParallelSourceNarrows(machine: ParallelMachine, active: seq<string>, target: string, parallel: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires parallel in active && target in machine.nodes
  requires parallel in machine.parallels
  requires below(machine.nodes[target].path, machine.nodes[parallel].path)
  ensures parallelPlan(machine, active, parallel, target, false).domain ==
    narrow(machine.parallels, machine.nodes[target].path,
      machine.nodes[target].path[..|machine.nodes[parallel].path| + 1])
{
  var parallelPath := machine.nodes[parallel].path;
  var targetPath := machine.nodes[target].path;
  assert ParallelNodeShape(machine, parallel);
  BelowMeaning(targetPath, parallelPath);
  CommonPrefixExact(parallelPath, targetPath, |parallelPath|);
}

lemma AncestorDomain(machine: ParallelMachine, source: string, target: string, parallel: string)
  requires ParallelWellFormed(machine) && source in machine.nodes && target in machine.nodes
  requires parallel in machine.parallels && source !in machine.parallels
  requires below(machine.nodes[parallel].path, machine.nodes[source].path)
  requires below(machine.nodes[target].path, machine.nodes[parallel].path)
  ensures transitionDomain(machine.parallels, machine.nodes[source].path, machine.nodes[target].path, false) ==
    machine.nodes[source].path
{
  var parallelPath := machine.nodes[parallel].path;
  var sourcePath := machine.nodes[source].path;
  var targetPath := machine.nodes[target].path;
  assert ParallelNodeShape(machine, parallel);
  assert ParallelNodeShape(machine, source);
  BelowMeaning(parallelPath, sourcePath);
  BelowMeaning(targetPath, parallelPath);
  assert targetPath[..|sourcePath|] == sourcePath;
  CommonPrefixExact(sourcePath, targetPath, |sourcePath|);
  assert sourcePath[|sourcePath| - 1] !in machine.parallels;
}

lemma AncestorResetsSubtree(machine: ParallelMachine, active: seq<string>, source: string, target: string, parallel: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  requires parallel in machine.parallels && source !in machine.parallels
  requires below(machine.nodes[parallel].path, machine.nodes[source].path)
  requires below(machine.nodes[target].path, machine.nodes[parallel].path)
  ensures var plan := parallelPlan(machine, active, source, target, false);
    plan.domain == machine.nodes[source].path &&
    forall id ::
      (id in active && id in machine.nodes && InRegion(machine.nodes[id].path, machine.nodes[parallel].path)) ==>
        id in plan.exits
{
  hide *;
  reveal InRegion(), PlanFacts(), PlanDomainFacts(), PlanMemberFacts(), exiting(), below();
  KnownNodes(machine, active, source, parallel);
  var nodes := machine.nodes;
  var parallelPath := nodes[parallel].path;
  var sourcePath := nodes[source].path;
  var plan := parallelPlan(machine, active, source, target, false);
  AncestorDomain(machine, source, target, parallel);
  PlanContext(machine, active, source, target, false);
  BelowMeaning(parallelPath, sourcePath);
  forall id | id in active && id in nodes && InRegion(nodes[id].path, parallelPath)
    ensures id in plan.exits
  {
    BelowMeaning(nodes[id].path, sourcePath);
    assert nodes[id].path[..|sourcePath|] == parallelPath[..|sourcePath|];
    assert below(nodes[id].path, plan.domain);
    assert exiting(nodes, plan.domain, plan.reentered, id);
  }
}

lemma PlanReenterSelf(machine: ParallelMachine, active: seq<string>, source: string, target: string)
  requires source in machine.nodes && target in machine.nodes
  requires transitionDomain(machine.parallels, machine.nodes[source].path, machine.nodes[target].path, true) ==
    machine.nodes[source].path
  ensures var plan := parallelPlan(machine, active, source, target, true);
    plan.domain == machine.nodes[source].path &&
    plan.reentered == Some(source) &&
    plan.extra == Some(source)
{
  SamePathMeaning(machine.nodes[source].path, machine.nodes[source].path);
}

lemma ReenterResetsSubtree(machine: ParallelMachine, active: seq<string>, source: string, target: string, parallel: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  requires parallel in machine.parallels
  requires source == parallel || below(machine.nodes[parallel].path, machine.nodes[source].path)
  requires below(machine.nodes[target].path, machine.nodes[parallel].path)
  ensures var plan := parallelPlan(machine, active, source, target, true);
    plan.domain == machine.nodes[source].path && plan.reentered == Some(source) &&
    source in plan.exits && source in plan.entries &&
    forall id ::
      (id in active && id in machine.nodes && InRegion(machine.nodes[id].path, machine.nodes[parallel].path)) ==>
        id in plan.exits
{
  hide *;
  KnownNodes(machine, active, source, parallel);
  var nodes := machine.nodes;
  var parallelPath := nodes[parallel].path;
  var sourcePath := nodes[source].path;
  var targetPath := nodes[target].path;
  assert ParallelNodeShape(machine, parallel) && ParallelNodeShape(machine, source) by {
    reveal ParallelWellFormed();
  }
  BelowMeaning(targetPath, parallelPath);
  if source != parallel {
    BelowMeaning(parallelPath, sourcePath);
  }
  assert |parallelPath| >= |sourcePath| && parallelPath[..|sourcePath|] == sourcePath;
  assert targetPath[..|sourcePath|] == sourcePath;
  CommonPrefixExact(sourcePath, targetPath, |sourcePath|);
  assert transitionDomain(machine.parallels, sourcePath, targetPath, true) == sourcePath by {
    reveal transitionDomain();
  }
  PlanReenterSelf(machine, active, source, target);
  var plan := parallelPlan(machine, active, source, target, true);
  PlanMembers(machine, active, source, target, true);
  assert source in plan.exits by {
    reveal PlanMemberFacts(), exiting();
  }
  assert source in plan.entries by {
    reveal PlanMemberFacts(), entering();
  }
  forall id | id in active && id in nodes && InRegion(nodes[id].path, parallelPath)
    ensures id in plan.exits
  {
    var path := nodes[id].path;
    assert ParallelNodeShape(machine, id) by {
      reveal ParallelWellFormed();
    }
    assert path[..|sourcePath|] == sourcePath by {
      reveal InRegion();
    }
    if |path| == |sourcePath| {
      assert path == sourcePath;
      assert id == source by {
        reveal ParallelNodeShape();
      }
    } else {
      assert |path| > |sourcePath| by {
        reveal InRegion();
      }
      BelowMeaning(path, sourcePath);
    }
    assert id in plan.exits by {
      reveal PlanMemberFacts(), exiting();
    }
  }
}

lemma ParallelSelfReenter(machine: ParallelMachine, active: seq<string>, parallel: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires parallel in active && parallel in machine.parallels
  ensures var plan := parallelPlan(machine, active, parallel, parallel, true);
    plan.domain == machine.nodes[parallel].path && plan.reentered == Some(parallel) &&
    parallel in plan.exits && parallel in plan.entries && parallel in plan.active
{
  var plan := parallelPlan(machine, active, parallel, parallel, true);
  var parallelPath := machine.nodes[parallel].path;
  CommonPrefixExact(parallelPath, parallelPath, |parallelPath|);
  SamePathMeaning(parallelPath, parallelPath);
  PlanContext(machine, active, parallel, parallel, true);
  assert PlanMemberFacts(machine, active, parallel, plan);
  assert exiting(machine.nodes, plan.domain, plan.reentered, parallel);
  assert entering(machine.nodes, machine.parallels, parallelPath, plan.domain, plan.extra, parallel);
}

lemma PlanDeclared(machine: ParallelMachine, active: seq<string>, source: string, target: string, reenter: bool)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source in active && target in machine.nodes
  ensures declaredPath(machine.nodes, parallelPlan(machine, active, source, target, reenter).exits)
  ensures declaredPath(machine.nodes, parallelPlan(machine, active, source, target, reenter).entries)
{
  var plan := parallelPlan(machine, active, source, target, reenter);
  PlanContext(machine, active, source, target, reenter);
  assert PlanMemberFacts(machine, active, target, plan);
  DeclaredMembers(machine.nodes, plan.exits);
  DeclaredMembers(machine.nodes, plan.entries);
}

lemma ParallelStepMeaning(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  requires |parallelSelections(machine, snapshot, event)| > 0
  requires var selected := parallelSelections(machine, snapshot, event)[0];
    selected.evaluation.result.Some? && selected.evaluation.result.value.target.Some? &&
    selected.evaluation.result.value.target.value in machine.nodes
  ensures var selected := parallelSelections(machine, snapshot, event)[0];
    var result := selected.evaluation.result.value;
    var plan := parallelPlan(machine, snapshot.active, selected.id, result.target.value, result.reenter);
    var exited := lifecycle(machine.nodes, plan.exits, snapshot.context, event, true);
    var updated := apply(exited.context, selected.evaluation);
    var entered := lifecycle(machine.nodes, plan.entries, updated.context, event, false);
    parallelTransition(machine, snapshot, event) ==
      ParallelStep(ParallelSnapshot(plan.active, entered.context), false,
        exited.reused && updated.reused && entered.reused,
        exited.effects + selected.evaluation.effects + entered.effects)
{
  var selected := parallelSelections(machine, snapshot, event)[0];
  var result := selected.evaluation.result.value;
  SelectionSourcesActive(machine, snapshot, event);
  PlanDeclared(machine, snapshot.active, selected.id, result.target.value, result.reenter);
}

lemma ParallelTargetlessKeepsActive(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires |parallelSelections(machine, snapshot, event)| > 0
  requires var selected := parallelSelections(machine, snapshot, event)[0];
    selected.evaluation.result.None? || selected.evaluation.result.value.target.None?
  ensures parallelTransition(machine, snapshot, event).snapshot.active == snapshot.active
  ensures !parallelTransition(machine, snapshot, event).snapshotReused
  ensures var selected := parallelSelections(machine, snapshot, event)[0];
    var updated := apply(snapshot.context, selected.evaluation);
    parallelTransition(machine, snapshot, event) ==
      ParallelStep(ParallelSnapshot(snapshot.active, updated.context), false, updated.reused, updated.effects)
{
}

lemma TargetlessSelectionLifecycle(machine: ParallelMachine, active: seq<string>, selection: Selection)
  requires selection.evaluation.result.Some? && selection.evaluation.result.value.target.None?
  ensures selectionReady(machine, active, selection)
  ensures selectionPlan(machine, active, selection).None?
  ensures conflictExits(machine, active, selection) == []
{
}

lemma RootPath(machine: ParallelMachine)
  requires ParallelWellFormed(machine)
  ensures machine.root in machine.nodes && machine.nodes[machine.root].path == [machine.root]
{
}

lemma InitialOrder(machine: ParallelMachine, event: Event)
  ensures Subseq(parallelInitialTransition(machine, event).snapshot.active, machine.order)
{
  FiltersAreSubsequences(machine.order);
}

lemma InitialEntries(machine: ParallelMachine, event: Event)
  requires ParallelWellFormed(machine)
  ensures var entries := parallelInitialTransition(machine, event).snapshot.active;
    Subseq(entries, machine.order) &&
    forall id :: id in entries <==>
      (id in machine.nodes && completes(machine.nodes, machine.parallels, [machine.root], machine.nodes[id].path))
{
  hide *;
  reveal NextShape(), DomainStart();
  var entries := parallelInitialTransition(machine, event).snapshot.active;
  InitialShape(machine, event);
  InitialOrder(machine, event);
  RootPath(machine);
  forall id | id in machine.nodes
    ensures id in entries <==> completes(machine.nodes, machine.parallels, [machine.root], machine.nodes[id].path)
  {
    PathEnds(machine, id);
    BelowMeaning(machine.nodes[id].path, []);
    assert machine.nodes[id].path[0..] == machine.nodes[id].path;
  }
}

lemma ParallelInitialMeaning(machine: ParallelMachine, event: Event)
  requires ParallelWellFormed(machine)
  ensures var step := parallelInitialTransition(machine, event);
    var entered := lifecycle(machine.nodes, step.snapshot.active, machine.context, event, false);
    Subseq(step.snapshot.active, machine.order) &&
    (forall id :: id in step.snapshot.active <==>
      id in machine.nodes && completes(machine.nodes, machine.parallels, [machine.root], machine.nodes[id].path)) &&
    step == ParallelStep(ParallelSnapshot(step.snapshot.active, entered.context), false, entered.reused, entered.effects)
{
  InitialEntries(machine, event);
  DeclaredMembers(machine.nodes, parallelInitialTransition(machine, event).snapshot.active);
}

lemma InitialChildren(machine: ParallelMachine, event: Event, id: string, child: string)
  requires ParallelWellFormed(machine) && id in machine.nodes && child in machine.nodes[id].children
  ensures var entries := parallelInitialTransition(machine, event).snapshot.active;
    child in entries <==>
      id in entries && (id in machine.parallels || machine.nodes[id].initial == Some(child))
{
  var nodes := machine.nodes;
  var path := nodes[id].path;
  InitialEntries(machine, event);
  assert ParallelNodeShape(machine, id);
  assert nodes[child].path == path + [child];
  CompletesSnoc(nodes, machine.parallels, [machine.root], path, child);
  BelowMeaning([machine.root], path);
}

// Leaf-first selection at every depth: each selected transition is chosen by
// some active leaf, every active leaf with an enabled ancestor handler is
// represented, and an empty selection keeps the snapshot unchanged.
lemma LeafFirstSelection(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  ensures forall selected :: selected in parallelSelections(machine, snapshot, event) ==>
    selected.id in snapshot.active && selected.id in machine.nodes &&
    exists leaf :: leaf in snapshot.active && leaf in machine.nodes &&
      !(exists other ::
          other in snapshot.active && other in machine.nodes &&
          below(machine.nodes[other].path, machine.nodes[leaf].path)) &&
      declaredPath(machine.nodes, machine.nodes[leaf].path) &&
      select(machine.nodes, machine.nodes[leaf].path, snapshot.context, event) == Some(selected)
  ensures forall leaf :: (leaf in snapshot.active && leaf in machine.nodes &&
    !(exists other ::
        other in snapshot.active && other in machine.nodes &&
        below(machine.nodes[other].path, machine.nodes[leaf].path)) &&
    declaredPath(machine.nodes, machine.nodes[leaf].path) &&
    select(machine.nodes, machine.nodes[leaf].path, snapshot.context, event).Some?) ==>
      exists s :: s in parallelSelections(machine, snapshot, event) &&
        s.id == select(machine.nodes, machine.nodes[leaf].path, snapshot.context, event).value.id
  ensures |parallelSelections(machine, snapshot, event)| == 0 ==>
    parallelTransition(machine, snapshot, event) == ParallelStep(snapshot, true, true, [])
{
  SelectionSourcesActive(machine, snapshot, event);
  LeafSelectionsMeaning(machine.nodes, snapshot.active, snapshot.active, snapshot.context, event, []);
}

lemma ParallelStepDelegates(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires |parallelSelections(machine, snapshot, event)| < 2
  ensures parallelStep(machine, snapshot, event) == parallelTransition(machine, snapshot, event)
  ensures parallelStepReady(machine, snapshot, event) == parallelReady(machine, snapshot, event)
{
}

ghost predicate Distinct(xs: seq<string>)
{
  forall i, j :: 0 <= i < j < |xs| ==> xs[i] != xs[j]
}

lemma DistinctTail(xs: seq<string>)
  requires |xs| > 0 && Distinct(xs)
  ensures Distinct(xs[1..]) && xs[0] !in xs[1..]
{
  forall i, j | 0 <= i < j < |xs| - 1
    ensures xs[1..][i] != xs[1..][j]
  {
    assert xs[1..][i] == xs[i + 1] && xs[1..][j] == xs[j + 1];
  }
  forall k | 0 <= k < |xs| - 1
    ensures xs[1..][k] != xs[0]
  {
    assert xs[1..][k] == xs[k + 1];
  }
}

lemma {:induction false} SubseqMembers(a: seq<string>, b: seq<string>)
  requires Subseq(a, b)
  ensures forall x :: x in a ==> x in b
  decreases |b|
{
  if |a| > 0 {
    if a[0] == b[0] && Subseq(a[1..], b[1..]) {
      SubseqMembers(a[1..], b[1..]);
      assert a == [a[0]] + a[1..];
      assert b == [b[0]] + b[1..];
    } else {
      SubseqMembers(a, b[1..]);
      assert b == [b[0]] + b[1..];
    }
  }
}

lemma {:induction false} SubseqDistinct(a: seq<string>, b: seq<string>)
  requires Subseq(a, b) && Distinct(b)
  ensures Distinct(a)
  decreases |b|
{
  if |a| > 0 {
    DistinctTail(b);
    if a[0] == b[0] && Subseq(a[1..], b[1..]) {
      SubseqDistinct(a[1..], b[1..]);
      SubseqMembers(a[1..], b[1..]);
      forall i, j | 0 <= i < j < |a|
        ensures a[i] != a[j]
      {
        assert a[j] == a[1..][j - 1];
        if i > 0 {
          assert a[i] == a[1..][i - 1];
        } else {
          assert a[j] in a[1..];
        }
      }
    } else {
      SubseqDistinct(a, b[1..]);
    }
  }
}

ghost predicate DistinctIds(selections: seq<Selection>)
{
  forall i, j :: 0 <= i < j < |selections| ==> selections[i].id != selections[j].id
}

lemma {:induction false} LeafSelectionsDistinct(nodes: map<string, CompoundNode>, active: seq<string>,
                                                candidates: seq<string>, context: map<string, int>, event: Event,
                                                seen: seq<Selection>)
  requires DistinctIds(seen)
  ensures DistinctIds(leafSelections(nodes, active, candidates, context, event, seen))
  decreases |candidates|
{
  if |candidates| > 0 {
    var id := candidates[0];
    var rest := candidates[1..];
    if !isActiveLeaf(nodes, active, id) {
      LeafSelectionsDistinct(nodes, active, rest, context, event, seen);
    } else {
      var path := nodes[id].path;
      if !declaredPath(nodes, path) {
        LeafSelectionsDistinct(nodes, active, rest, context, event, seen);
      } else {
        var picked := select(nodes, path, context, event);
        if picked.None? || hasSelectionId(seen, picked.value.id) {
          LeafSelectionsDistinct(nodes, active, rest, context, event, seen);
        } else {
          HasSelectionIdMeaning(seen, picked.value.id);
          var nextSeen := seen + [picked.value];
          assert DistinctIds(nextSeen) by {
            forall i, j | 0 <= i < j < |nextSeen|
              ensures nextSeen[i].id != nextSeen[j].id
            {
              if j < |seen| {
                assert nextSeen[i] == seen[i] && nextSeen[j] == seen[j];
              } else {
                assert nextSeen[i] in seen;
                assert nextSeen[j] == picked.value;
              }
            }
          }
          LeafSelectionsDistinct(nodes, active, rest, context, event, nextSeen);
        }
      }
    }
  }
}

lemma {:induction false} SourceApartMeaning(path: seq<string>, selections: seq<Selection>)
  ensures sourceApart(path, selections) <==>
    forall k :: 0 <= k < |selections| ==> !comparable(path, selections[k].node.path)
  decreases |selections|
{
  if |selections| > 0 {
    SourceApartMeaning(path, selections[1..]);
    forall k | 0 < k < |selections|
      ensures selections[k] == selections[1..][k - 1]
    {
    }
  }
}

lemma {:induction false} SourcesApartMeaning(selections: seq<Selection>)
  ensures sourcesApart(selections) <==>
    forall i, j :: 0 <= i < j < |selections| ==> !comparable(selections[i].node.path, selections[j].node.path)
  decreases |selections|
{
  if |selections| > 0 {
    var rest := selections[1..];
    SourceApartMeaning(selections[0].node.path, rest);
    SourcesApartMeaning(rest);
    forall k | 0 < k < |selections|
      ensures selections[k] == rest[k - 1]
    {
    }
  }
}

lemma SelectedIdsDistinct(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  ensures DistinctIds(parallelSelections(machine, snapshot, event))
{
  LeafSelectionsDistinct(machine.nodes, snapshot.active, snapshot.active, snapshot.context, event, []);
}

// With several selections, readiness depends only on each target: no simultaneous
// step is refused because of how many parallel nodes the machine declares.
lemma SimultaneousReadyMeaning(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  requires |parallelSelections(machine, snapshot, event)| >= 2
  ensures parallelStepReady(machine, snapshot, event) <==>
    forall selection :: selection in parallelSelections(machine, snapshot, event) ==>
      selectionReady(machine, snapshot.active, selection)
{
  hide *;
  var selections := parallelSelections(machine, snapshot, event);
  var ready := (selection: Selection) => selectionReady(machine, snapshot.active, selection);
  assert parallelStepReady(machine, snapshot, event) == multiReady(machine, snapshot.active, selections) by {
    reveal parallelStepReady;
  }
  assert multiReady(machine, snapshot.active, selections) == SeqAll(selections, ready) by {
    reveal multiReady;
  }
  if parallelStepReady(machine, snapshot, event) {
    SelectionsReady(machine, snapshot.active, selections);
  } else if forall selection :: selection in selections ==> selectionReady(machine, snapshot.active, selection) {
    SelectionsReadyConverse(machine, snapshot.active, selections);
  }
}

lemma {:induction false} SelectionsReadyConverse(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  requires forall selection :: selection in selections ==> selectionReady(machine, active, selection)
  ensures SeqAll(selections, (selection: Selection) => selectionReady(machine, active, selection))
  decreases |selections|
{
  if |selections| > 0 {
    assert forall selection :: selection in selections[1..] ==> selection in selections;
    SelectionsReadyConverse(machine, active, selections[1..]);
  }
}

ghost function Effects(selections: seq<Selection>): seq<Effect>
  decreases |selections|
{
  if |selections| == 0 then [] else selections[0].evaluation.effects + Effects(selections[1..])
}

lemma {:induction false} ApplyAllSequential(context: map<string, int>, xs: seq<Selection>, ys: seq<Selection>)
  ensures var first := applyAll(context, xs);
    var second := applyAll(first.context, ys);
    applyAll(context, xs + ys) == Applied(second.context, first.reused && second.reused, first.effects + second.effects, first.raises + second.raises)
  decreases |xs|
{
  if |xs| == 0 {
    assert xs + ys == ys;
  } else {
    assert (xs + ys)[0] == xs[0];
    assert (xs + ys)[1..] == xs[1..] + ys;
    var head := apply(context, xs[0].evaluation);
    ApplyAllSequential(head.context, xs[1..], ys);
    var rest := applyAll(head.context, xs[1..]);
    var second := applyAll(rest.context, ys);
    assert head.effects + (rest.effects + second.effects) == (head.effects + rest.effects) + second.effects;
  }
}

lemma {:induction false} ApplyAllEffects(context: map<string, int>, selections: seq<Selection>)
  ensures applyAll(context, selections).effects == Effects(selections)
  decreases |selections|
{
  if |selections| > 0 {
    ApplyAllEffects(apply(context, selections[0].evaluation).context, selections[1..]);
  }
}

lemma {:induction false} AnyPreemptsMeaning(machine: ParallelMachine, active: seq<string>, candidate: Selection,
                                            kept: seq<Selection>)
  ensures anyPreempts(machine, active, candidate, kept) <==>
    exists other :: other in kept && preempts(machine, active, candidate, other)
  decreases |kept|
{
  if |kept| > 0 {
    AnyPreemptsMeaning(machine, active, candidate, kept[1..]);
    assert kept == [kept[0]] + kept[1..];
  }
}

lemma {:induction false} RemoveConflictsLength(machine: ParallelMachine, active: seq<string>,
                                               pending: seq<Selection>, kept: seq<Selection>)
  ensures |removeConflicts(machine, active, pending, kept)| <= |kept| + |pending|
  decreases |pending|
{
  if |pending| > 0 {
    var first := pending[0];
    if anyPreempts(machine, active, first, kept) {
      RemoveConflictsLength(machine, active, pending[1..], kept);
    } else {
      var exits := conflictExits(machine, active, first);
      var survivors := SeqFilter((other: Selection) => !overlaps(exits, conflictExits(machine, active, other)), kept);
      RemoveConflictsLength(machine, active, pending[1..], survivors + [first]);
    }
  }
}

lemma {:induction false} RemoveConflictsDrawn(machine: ParallelMachine, active: seq<string>,
                                              pending: seq<Selection>, kept: seq<Selection>)
  ensures forall selection :: selection in removeConflicts(machine, active, pending, kept) ==>
    selection in pending || selection in kept
  decreases |pending|
{
  if |pending| > 0 {
    var first := pending[0];
    if anyPreempts(machine, active, first, kept) {
      RemoveConflictsDrawn(machine, active, pending[1..], kept);
    } else {
      var exits := conflictExits(machine, active, first);
      var survivors := SeqFilter((other: Selection) => !overlaps(exits, conflictExits(machine, active, other)), kept);
      RemoveConflictsDrawn(machine, active, pending[1..], survivors + [first]);
    }
  }
}

lemma TwoSelectionConflicts(machine: ParallelMachine, active: seq<string>, x: Selection, y: Selection)
  ensures var exitsX := conflictExits(machine, active, x);
    var exitsY := conflictExits(machine, active, y);
    removeConflicts(machine, active, [x, y], []) ==
      if !overlaps(exitsY, exitsX) then [x, y]
      else if below(y.node.path, x.node.path) then [y]
      else [x]
{
  var exitsX := conflictExits(machine, active, x);
  var exitsY := conflictExits(machine, active, y);
  assert [x, y][0] == x && [x, y][1..] == [y];
  assert [y][0] == y && [y][1..] == [];
  assert !anyPreempts(machine, active, x, []);
  var none := SeqFilter((other: Selection) => !overlaps(exitsX, conflictExits(machine, active, other)), []);
  assert |none| == 0;
  assert none + [x] == [x];
  assert removeConflicts(machine, active, [x, y], []) == removeConflicts(machine, active, [x, y][1..], none + [x]);
  assert removeConflicts(machine, active, [x, y], []) == removeConflicts(machine, active, [y], [x]);
  assert [x][1..] == [];
  assert anyPreempts(machine, active, y, [x]) == preempts(machine, active, y, x);
  var survivors := SeqFilter((other: Selection) => !overlaps(exitsY, conflictExits(machine, active, other)), [x]);
  assert survivors == if overlaps(exitsY, exitsX) then [] else [x];
  if !anyPreempts(machine, active, y, [x]) {
    assert removeConflicts(machine, active, [y], [x]) == removeConflicts(machine, active, [], survivors + [y]);
  }
}

ghost predicate Disjoint(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  decreases |selections|
{
  |selections| == 0 ||
  ((forall other :: other in selections[1..] ==>
     !overlaps(conflictExits(machine, active, selections[0]), conflictExits(machine, active, other))) &&
   Disjoint(machine, active, selections[1..]))
}

lemma {:induction false} DisjointFilter(machine: ParallelMachine, active: seq<string>, p: Selection -> bool,
                                        selections: seq<Selection>)
  requires Disjoint(machine, active, selections)
  ensures Disjoint(machine, active, SeqFilter(p, selections))
  decreases |selections|
{
  if |selections| > 0 {
    DisjointFilter(machine, active, p, selections[1..]);
    var rest := SeqFilter(p, selections[1..]);
    if p(selections[0]) {
      assert SeqFilter(p, selections) == [selections[0]] + rest;
      assert ([selections[0]] + rest)[1..] == rest;
    } else {
      assert SeqFilter(p, selections) == rest;
    }
  }
}

lemma {:induction false} DisjointSnoc(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>,
                                      last: Selection)
  requires Disjoint(machine, active, selections)
  requires forall other :: other in selections ==>
    !overlaps(conflictExits(machine, active, other), conflictExits(machine, active, last))
  ensures Disjoint(machine, active, selections + [last])
  decreases |selections|
{
  if |selections| == 0 {
    assert ([] + [last])[1..] == [];
  } else {
    assert (selections + [last])[0] == selections[0];
    assert (selections + [last])[1..] == selections[1..] + [last];
    DisjointSnoc(machine, active, selections[1..], last);
  }
}

lemma {:induction false} RemoveConflictsDisjoint(machine: ParallelMachine, active: seq<string>,
                                                 pending: seq<Selection>, kept: seq<Selection>)
  requires Disjoint(machine, active, kept)
  ensures Disjoint(machine, active, removeConflicts(machine, active, pending, kept))
  decreases |pending|
{
  if |pending| > 0 {
    var first := pending[0];
    if anyPreempts(machine, active, first, kept) {
      RemoveConflictsDisjoint(machine, active, pending[1..], kept);
    } else {
      var exits := conflictExits(machine, active, first);
      var p := (other: Selection) => !overlaps(exits, conflictExits(machine, active, other));
      var survivors := SeqFilter(p, kept);
      DisjointFilter(machine, active, p, kept);
      DisjointSnoc(machine, active, survivors, first);
      RemoveConflictsDisjoint(machine, active, pending[1..], survivors + [first]);
    }
  }
}

lemma {:induction false} DisjointPairs(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  requires Disjoint(machine, active, selections)
  ensures forall i, j :: 0 <= i < j < |selections| ==>
    !overlaps(conflictExits(machine, active, selections[i]), conflictExits(machine, active, selections[j]))
  decreases |selections|
{
  if |selections| > 0 {
    DisjointPairs(machine, active, selections[1..]);
    forall i, j | 0 <= i < j < |selections|
      ensures !overlaps(conflictExits(machine, active, selections[i]), conflictExits(machine, active, selections[j]))
    {
      if i == 0 {
        assert selections[j] in selections[1..];
      } else {
        assert selections[i] == selections[1..][i - 1] && selections[j] == selections[1..][j - 1];
      }
    }
  }
}

lemma KeptSelectionsDisjoint(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  ensures var kept := removeConflicts(machine, active, selections, []);
    forall i, j :: 0 <= i < j < |kept| ==>
      !overlaps(conflictExits(machine, active, kept[i]), conflictExits(machine, active, kept[j]))
{
  RemoveConflictsDisjoint(machine, active, selections, []);
  DisjointPairs(machine, active, removeConflicts(machine, active, selections, []));
}

lemma {:induction false} FilterKeepsAll(p: Selection -> bool, selections: seq<Selection>)
  requires forall selection :: selection in selections ==> p(selection)
  ensures SeqFilter(p, selections) == selections
  decreases |selections|
{
  if |selections| > 0 {
    FilterKeepsAll(p, selections[1..]);
    assert selections == [selections[0]] + selections[1..];
  }
}

ghost predicate NoDescendantSources(pending: seq<Selection>, kept: seq<Selection>)
{
  forall candidate, other :: candidate in pending && (other in pending || other in kept) ==>
    !below(candidate.node.path, other.node.path)
}

ghost function Greedy(machine: ParallelMachine, active: seq<string>, pending: seq<Selection>,
                      kept: seq<Selection>): seq<Selection>
  decreases |pending|
{
  if |pending| == 0 then kept
  else if (exists other :: other in kept &&
             overlaps(conflictExits(machine, active, pending[0]), conflictExits(machine, active, other)))
  then Greedy(machine, active, pending[1..], kept)
  else Greedy(machine, active, pending[1..], kept + [pending[0]])
}

lemma {:induction false} GreedyWhenApart(machine: ParallelMachine, active: seq<string>,
                                         pending: seq<Selection>, kept: seq<Selection>)
  requires NoDescendantSources(pending, kept)
  ensures removeConflicts(machine, active, pending, kept) == Greedy(machine, active, pending, kept)
  decreases |pending|
{
  if |pending| > 0 {
    var first := pending[0];
    var exits := conflictExits(machine, active, first);
    assert NoDescendantSources(pending[1..], kept);
    AnyPreemptsMeaning(machine, active, first, kept);
    var clash := exists other :: other in kept && overlaps(exits, conflictExits(machine, active, other));
    assert anyPreempts(machine, active, first, kept) == clash;
    if clash {
      GreedyWhenApart(machine, active, pending[1..], kept);
    } else {
      var p := (other: Selection) => !overlaps(exits, conflictExits(machine, active, other));
      FilterKeepsAll(p, kept);
      assert removeConflicts(machine, active, pending, kept) ==
        removeConflicts(machine, active, pending[1..], kept + [first]);
      assert NoDescendantSources(pending[1..], kept + [first]);
      GreedyWhenApart(machine, active, pending[1..], kept + [first]);
    }
  }
}

lemma DescendantWins(machine: ParallelMachine, active: seq<string>, ancestor: Selection, descendant: Selection)
  requires below(descendant.node.path, ancestor.node.path)
  requires overlaps(conflictExits(machine, active, ancestor), conflictExits(machine, active, descendant))
  ensures removeConflicts(machine, active, [ancestor, descendant], []) == [descendant]
  ensures removeConflicts(machine, active, [descendant, ancestor], []) == [descendant]
{
  BelowMeaning(descendant.node.path, ancestor.node.path);
  BelowMeaning(ancestor.node.path, descendant.node.path);
  TwoSelectionConflicts(machine, active, ancestor, descendant);
  TwoSelectionConflicts(machine, active, descendant, ancestor);
}

ghost predicate Within(path: seq<string>, domain: seq<string>)
{
  |domain| <= |path| && path[..|domain|] == domain
}

lemma WithinMeaning(path: seq<string>, domain: seq<string>)
  ensures Within(path, domain) <==> below(path, domain) || path == domain
{
  BelowMeaning(path, domain);
}

lemma ComparableMeaning(a: seq<string>, b: seq<string>)
  ensures comparable(a, b) <==> Within(a, b) || Within(b, a)
{
  CommonPrefixMeaning(a, b);
  if Within(b, a) {
    CommonPrefixExact(a, b, |a|);
  }
  if Within(a, b) {
    CommonPrefixExact(a, b, |b|);
  }
}

lemma WithinShared(path: seq<string>, a: seq<string>, b: seq<string>)
  requires Within(path, a) && Within(path, b)
  ensures comparable(a, b)
{
  ComparableMeaning(a, b);
  if |a| <= |b| {
    assert b[..|a|] == path[..|b|][..|a|];
  } else {
    assert a[..|b|] == path[..|a|][..|b|];
  }
}

lemma WithinTransitive(path: seq<string>, middle: seq<string>, domain: seq<string>)
  requires Within(path, middle) && Within(middle, domain)
  ensures Within(path, domain)
{
  assert path[..|domain|] == path[..|middle|][..|domain|];
}

ghost predicate PlanFrom(machine: ParallelMachine, active: seq<string>, plan: ParallelPlan)
{
  exists source, target, reenter :: source in active && target in machine.nodes &&
    plan == parallelPlan(machine, active, source, target, reenter)
}

lemma {:induction false} PlansFromActive(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  requires forall selection :: selection in selections ==> selection.id in active
  ensures forall plan :: plan in selectionPlans(machine, active, selections) ==> PlanFrom(machine, active, plan)
  decreases |selections|
{
  if |selections| > 0 {
    PlansFromActive(machine, active, selections[1..]);
    var selection := selections[0];
    var plan := selectionPlan(machine, active, selection);
    if plan.Some? {
      var result := selection.evaluation.result.value;
      assert PlanFrom(machine, active, plan.value) by {
        assert plan.value == parallelPlan(machine, active, selection.id, result.target.value, result.reenter);
      }
    }
  }
}

lemma PlanFromFacts(machine: ParallelMachine, active: seq<string>, plan: ParallelPlan)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active) && PlanFrom(machine, active, plan)
  ensures ParallelValid(machine, plan.active)
  ensures ActiveNodePath(machine, active, plan.domain)
  ensures forall id :: id in machine.nodes && machine.nodes[id].path == plan.domain ==> id in plan.active
  ensures forall id :: id in plan.active <==>
    id in machine.nodes && ((id in active && id !in plan.exits) || id in plan.entries)
  ensures forall id :: id in machine.nodes && !Within(machine.nodes[id].path, plan.domain) ==>
    id !in plan.exits && id !in plan.entries
{
  var source, target, reenter :| source in active && target in machine.nodes &&
    plan == parallelPlan(machine, active, source, target, reenter);
  KnownSource(machine, active, source);
  PlanContext(machine, active, source, target, reenter);
  PlanValid(machine, active, source, target, reenter);
  PlanShape(machine, active, source, target, reenter);
  assert PlanDomainFacts(machine, active, source, target, reenter, plan);
  assert PlanMemberFacts(machine, active, target, plan);
  forall id | id in machine.nodes && !Within(machine.nodes[id].path, plan.domain)
    ensures id !in plan.exits && id !in plan.entries
  {
    WithinMeaning(machine.nodes[id].path, plan.domain);
  }
}

ghost predicate PlansApart(plans: seq<ParallelPlan>)
{
  forall i, j :: 0 <= i < |plans| && 0 <= j < |plans| && i != j ==> !comparable(plans[i].domain, plans[j].domain)
}

lemma {:induction false} DomainsApartMeaning(plans: seq<ParallelPlan>)
  requires domainsApart(plans)
  ensures PlansApart(plans)
  decreases |plans|
{
  if |plans| > 0 {
    DomainsApartMeaning(plans[1..]);
    forall i, j | 0 <= i < |plans| && 0 <= j < |plans| && i != j
      ensures !comparable(plans[i].domain, plans[j].domain)
    {
      ComparableMeaning(plans[i].domain, plans[j].domain);
      ComparableMeaning(plans[j].domain, plans[i].domain);
      if i == 0 {
        assert plans[j] in plans[1..];
      } else if j == 0 {
        assert plans[i] in plans[1..];
      } else {
        assert plans[i] == plans[1..][i - 1] && plans[j] == plans[1..][j - 1];
      }
    }
  }
}

lemma {:induction false} NarrowWithin(parallels: seq<string>, target: seq<string>, domain: seq<string>)
  requires Within(target, domain)
  ensures Within(target, narrow(parallels, target, domain))
  decreases |target| - |domain|
{
  BelowMeaning(target, domain);
  if |domain| > 0 && below(target, domain) && domain[|domain| - 1] in parallels {
    NarrowWithin(parallels, target, target[0..|domain| + 1]);
  }
}

// Narrowing descends along the target path exactly while the current domain
// ends at a parallel node, stopping at a non-parallel node or at the target.
lemma {:induction false} NarrowMeaning(parallels: seq<string>, target: seq<string>, domain: seq<string>)
  requires |domain| > 0 && Within(target, domain)
  ensures var narrowed := narrow(parallels, target, domain);
    |domain| <= |narrowed| <= |target| && narrowed == target[..|narrowed|] &&
    (forall i :: |domain| - 1 <= i < |narrowed| - 1 ==> target[i] in parallels) &&
    (|narrowed| == |target| || narrowed[|narrowed| - 1] !in parallels)
  decreases |target| - |domain|
{
  BelowMeaning(target, domain);
  if below(target, domain) && domain[|domain| - 1] in parallels {
    var next := target[0..|domain| + 1];
    NarrowMeaning(parallels, target, next);
    assert target[|domain| - 1] == domain[|domain| - 1];
  }
}

lemma DomainWithinTarget(parallels: seq<string>, source: seq<string>, target: seq<string>, reenter: bool)
  ensures Within(target, transitionDomain(parallels, source, target, reenter))
{
  if commonPrefix(source, target) == |source| {
    assert source == target[..|source|];
    NarrowWithin(parallels, target, source);
  } else if |target| > 0 {
    var ancestors := target[0..|target| - 1];
    var lca := commonPrefix(source, ancestors);
    assert source[0..lca] == ancestors[0..lca] == target[0..lca];
    if lca == 0 {
      NarrowWithin(parallels, target, target[0..1]);
    } else if source[lca - 1] in parallels {
      CompoundAncestorPrefix(parallels, source[0..lca]);
    } else {
      NarrowWithin(parallels, target, source[0..lca]);
    }
  }
}

// statelyai/xstate#5895 pattern: one transition's exit set contains the
// other's target or an ancestor of it. Its domains are then comparable.
lemma PatternDomainsComparable(machine: ParallelMachine, active: seq<string>,
                               source1: string, target1: string, reenter1: bool,
                               source2: string, target2: string, reenter2: bool, node: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source1 in active && target1 in machine.nodes && source2 in active && target2 in machine.nodes
  requires node in machine.nodes && Within(machine.nodes[target2].path, machine.nodes[node].path)
  requires node in parallelPlan(machine, active, source1, target1, reenter1).exits
  ensures comparable(parallelPlan(machine, active, source1, target1, reenter1).domain,
                     parallelPlan(machine, active, source2, target2, reenter2).domain)
{
  var nodes := machine.nodes;
  var plan1 := parallelPlan(machine, active, source1, target1, reenter1);
  var plan2 := parallelPlan(machine, active, source2, target2, reenter2);
  KnownSource(machine, active, source1);
  KnownSource(machine, active, source2);
  PlanContext(machine, active, source1, target1, reenter1);
  PlanContext(machine, active, source2, target2, reenter2);
  var nodePath := nodes[node].path;
  var targetPath := nodes[target2].path;
  assert exiting(nodes, plan1.domain, plan1.reentered, node);
  WithinMeaning(nodePath, plan1.domain);
  WithinTransitive(targetPath, nodePath, plan1.domain);
  DomainWithinTarget(machine.parallels, nodes[source2].path, targetPath, reenter2);
  WithinShared(targetPath, plan1.domain, plan2.domain);
}

// Comparable domains alone do not imply that a step must be refused.
lemma PatternDomainsNotApart(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>, i: int, j: int,
                     source1: string, target1: string, reenter1: bool,
                     source2: string, target2: string, reenter2: bool, node: string)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  requires source1 in active && target1 in machine.nodes && source2 in active && target2 in machine.nodes
  requires 0 <= i < |plans| && 0 <= j < |plans| && i != j
  requires plans[i] == parallelPlan(machine, active, source1, target1, reenter1)
  requires plans[j] == parallelPlan(machine, active, source2, target2, reenter2)
  requires node in machine.nodes && Within(machine.nodes[target2].path, machine.nodes[node].path)
  requires node in plans[i].exits
  ensures !domainsApart(plans)
{
  PatternDomainsComparable(machine, active, source1, target1, reenter1, source2, target2, reenter2, node);
  if domainsApart(plans) {
    DomainsApartMeaning(plans);
    assert !comparable(plans[i].domain, plans[j].domain);
  }
}

ghost predicate Combined(plans: seq<ParallelPlan>, active: seq<string>, id: string)
{
  (id in active && !plansExit(plans, id)) || plansEnter(plans, id)
}

ghost predicate PlansContext(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>)
{
  ParallelWellFormed(machine) && ParallelValid(machine, active) &&
  (forall plan :: plan in plans ==> PlanFrom(machine, active, plan)) && PlansApart(plans)
}

lemma CombinedOwned(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>, id: string, i: int)
  requires PlansContext(machine, active, plans)
  requires id in machine.nodes && 0 <= i < |plans| && Within(machine.nodes[id].path, plans[i].domain)
  ensures Combined(plans, active, id) <==> id in plans[i].active
{
  var path := machine.nodes[id].path;
  forall j | 0 <= j < |plans| && j != i
    ensures id !in plans[j].exits && id !in plans[j].entries
  {
    if Within(path, plans[j].domain) {
      WithinShared(path, plans[i].domain, plans[j].domain);
    }
    PlanFromFacts(machine, active, plans[j]);
  }
  PlanFromFacts(machine, active, plans[i]);
  assert plansExit(plans, id) <==> id in plans[i].exits;
  assert plansEnter(plans, id) <==> id in plans[i].entries;
}

lemma CombinedUnowned(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>, id: string)
  requires PlansContext(machine, active, plans)
  requires id in machine.nodes
  requires forall i :: 0 <= i < |plans| ==> !Within(machine.nodes[id].path, plans[i].domain)
  ensures Combined(plans, active, id) <==> id in active
{
  forall plan | plan in plans
    ensures id !in plan.exits && id !in plan.entries
  {
    PlanFromFacts(machine, active, plan);
  }
}

lemma ChildrenAgree(machine: ParallelMachine, next: seq<string>, other: seq<string>, id: string)
  requires id in machine.nodes && ChildrenActive(machine, other, id)
  requires forall child :: child in machine.nodes[id].children ==> (child in next <==> child in other)
  ensures ChildrenActive(machine, next, id)
{
}

lemma ParentWithin(machine: ParallelMachine, id: string)
  requires ParallelWellFormed(machine) && id in machine.nodes && |machine.nodes[id].path| > 1
  ensures var path := machine.nodes[id].path;
    var parent := path[|path| - 2];
    parent in machine.nodes && Within(path, machine.nodes[parent].path) &&
    |machine.nodes[parent].path| == |path| - 1
{
  assert ParallelNodeShape(machine, id);
}

lemma ChildWithin(machine: ParallelMachine, id: string, child: string)
  requires ParallelWellFormed(machine) && id in machine.nodes && child in machine.nodes[id].children
  ensures child in machine.nodes && machine.nodes[child].path == machine.nodes[id].path + [child]
  ensures Within(machine.nodes[child].path, machine.nodes[id].path)
{
  assert ParallelNodeShape(machine, id);
}

lemma CombinedOwnedNode(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>,
                        next: seq<string>, id: string, i: int)
  requires PlansContext(machine, active, plans)
  requires forall x :: x in next <==> x in machine.nodes && Combined(plans, active, x)
  requires id in next && 0 <= i < |plans| && Within(machine.nodes[id].path, plans[i].domain)
  ensures |machine.nodes[id].path| > 1 ==> machine.nodes[id].path[|machine.nodes[id].path| - 2] in next
  ensures ChildrenActive(machine, next, id)
{
  var path := machine.nodes[id].path;
  var plan := plans[i];
  PlanFromFacts(machine, active, plan);
  CombinedOwned(machine, active, plans, id, i);
  if |path| > 1 {
    var parent := path[|path| - 2];
    ParentWithin(machine, id);
    var parentPath := machine.nodes[parent].path;
    if Within(parentPath, plan.domain) {
      CombinedOwned(machine, active, plans, parent, i);
    } else {
      forall j | 0 <= j < |plans|
        ensures !Within(parentPath, plans[j].domain)
      {
        if Within(parentPath, plans[j].domain) {
          WithinTransitive(path, parentPath, plans[j].domain);
          WithinShared(path, plan.domain, plans[j].domain);
        }
      }
      CombinedUnowned(machine, active, plans, parent);
    }
  }
  forall child | child in machine.nodes[id].children
    ensures child in next <==> child in plan.active
  {
    ChildWithin(machine, id, child);
    WithinTransitive(machine.nodes[child].path, path, plan.domain);
    CombinedOwned(machine, active, plans, child, i);
  }
  ChildrenAgree(machine, next, plan.active, id);
}

lemma CombinedUnownedNode(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>,
                          next: seq<string>, id: string)
  requires PlansContext(machine, active, plans)
  requires forall x :: x in next <==> x in machine.nodes && Combined(plans, active, x)
  requires id in next
  requires forall i :: 0 <= i < |plans| ==> !Within(machine.nodes[id].path, plans[i].domain)
  ensures |machine.nodes[id].path| > 1 ==> machine.nodes[id].path[|machine.nodes[id].path| - 2] in next
  ensures ChildrenActive(machine, next, id)
{
  var path := machine.nodes[id].path;
  CombinedUnowned(machine, active, plans, id);
  if |path| > 1 {
    var parent := path[|path| - 2];
    ParentWithin(machine, id);
    forall j | 0 <= j < |plans|
      ensures !Within(machine.nodes[parent].path, plans[j].domain)
    {
      if Within(machine.nodes[parent].path, plans[j].domain) {
        WithinTransitive(path, machine.nodes[parent].path, plans[j].domain);
      }
    }
    CombinedUnowned(machine, active, plans, parent);
  }
  forall child | child in machine.nodes[id].children
    ensures child in next <==> child in active
  {
    CombinedUnownedChild(machine, active, plans, next, id, child);
  }
  ChildrenAgree(machine, next, active, id);
}

lemma CombinedUnownedChild(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>,
                           next: seq<string>, id: string, child: string)
  requires PlansContext(machine, active, plans)
  requires forall x :: x in next <==> x in machine.nodes && Combined(plans, active, x)
  requires id in machine.nodes && child in machine.nodes[id].children
  requires forall i :: 0 <= i < |plans| ==> !Within(machine.nodes[id].path, plans[i].domain)
  ensures child in next <==> child in active
{
  hide *;
  reveal PlansContext();
  var path := machine.nodes[id].path;
  ChildWithin(machine, id, child);
  var childPath := machine.nodes[child].path;
  if j :| 0 <= j < |plans| && Within(childPath, plans[j].domain) {
    var plan := plans[j];
    assert plan in plans;
    PlanFromFacts(machine, active, plan);
    WithinChild(path, child, plan.domain);
    PathEnds(machine, child);
    CombinedOwned(machine, active, plans, child, j);
  } else {
    CombinedUnowned(machine, active, plans, child);
  }
}

lemma WithinChild(path: seq<string>, child: string, domain: seq<string>)
  requires Within(path + [child], domain) && !Within(path, domain)
  ensures domain == path + [child]
{
  if |domain| <= |path| {
    assert path[..|domain|] == (path + [child])[..|domain|];
  }
}

lemma CombinedValid(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>, next: seq<string>)
  requires PlansContext(machine, active, plans)
  requires forall x :: x in next <==> x in machine.nodes && Combined(plans, active, x)
  requires Subseq(next, machine.order)
  ensures ParallelValid(machine, next)
{
  var root := machine.root;
  if i :| 0 <= i < |plans| && Within(machine.nodes[root].path, plans[i].domain) {
    PlanFromFacts(machine, active, plans[i]);
    CombinedOwned(machine, active, plans, root, i);
  } else {
    CombinedUnowned(machine, active, plans, root);
  }
  forall id | id in next
    ensures id in machine.nodes &&
      (|machine.nodes[id].path| > 1 ==> machine.nodes[id].path[|machine.nodes[id].path| - 2] in next) &&
      ChildrenActive(machine, next, id)
  {
    if i :| 0 <= i < |plans| && Within(machine.nodes[id].path, plans[i].domain) {
      CombinedOwnedNode(machine, active, plans, next, id, i);
    } else {
      CombinedUnownedNode(machine, active, plans, next, id);
    }
  }
}

lemma MultiPlansContext(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  requires multiReady(machine, snapshot.active, parallelSelections(machine, snapshot, event))
  ensures var kept := removeConflicts(machine, snapshot.active, parallelSelections(machine, snapshot, event), []);
    PlansContext(machine, snapshot.active, MovingPlans(selectionPlans(machine, snapshot.active, kept)))
{
  var selections := parallelSelections(machine, snapshot, event);
  var active := snapshot.active;
  var kept := removeConflicts(machine, active, selections, []);
  SelectionSourcesActive(machine, snapshot, event);
  SelectionsReady(machine, active, selections);
  RemoveConflictsDrawn(machine, active, selections, []);
  PlansFromActive(machine, active, kept);
  RemoveConflictsDisjoint(machine, active, selections, []);
  ReadyMovingDomainsApart(machine, active, kept);
  DomainsApartMeaning(MovingPlans(selectionPlans(machine, active, kept)));
}

lemma MultiStepMembers(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine)
  requires |parallelSelections(machine, snapshot, event)| >= 2
  ensures var kept := removeConflicts(machine, snapshot.active, parallelSelections(machine, snapshot, event), []);
    var plans := selectionPlans(machine, snapshot.active, kept);
    var next := parallelStep(machine, snapshot, event).snapshot.active;
    Subseq(next, machine.order) &&
    forall x :: x in next <==> x in machine.nodes && Combined(plans, snapshot.active, x)
{
  hide *;
  reveal parallelStep, Combined, ParallelWellFormed;
  var active := snapshot.active;
  var kept := removeConflicts(machine, active, parallelSelections(machine, snapshot, event), []);
  var plans := selectionPlans(machine, active, kept);
  var keep := (id: string) => (((id in active) && !(plansExit(plans, id))) || plansEnter(plans, id));
  var next := parallelStep(machine, snapshot, event).snapshot.active;
  assert next == SeqFilter(keep, machine.order);
  FilterSubseq(keep, machine.order);
  forall x
    ensures x in next <==> x in machine.nodes && Combined(plans, active, x)
  {
    assert keep(x) == Combined(plans, active, x);
  }
}

lemma MultiStepValid(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  requires parallelStepReady(machine, snapshot, event)
  ensures ParallelValid(machine, parallelStep(machine, snapshot, event).snapshot.active)
{
  var selections := parallelSelections(machine, snapshot, event);
  if |selections| < 2 {
    ParallelStepValid(machine, snapshot, event);
  } else {
    var kept := removeConflicts(machine, snapshot.active, selections, []);
    var plans := selectionPlans(machine, snapshot.active, kept);
    MultiPlansContext(machine, snapshot, event);
    MultiStepMembers(machine, snapshot, event);
    forall id {
      MovingCombined(plans, snapshot.active, id);
    }
    CombinedValid(machine, snapshot.active, MovingPlans(plans), parallelStep(machine, snapshot, event).snapshot.active);
  }
}

lemma {:induction false} SelectionsReady(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
  requires SeqAll(selections, (selection: Selection) => selectionReady(machine, active, selection))
  ensures forall selection :: selection in selections ==> selectionReady(machine, active, selection)
  decreases |selections|
{
  if |selections| > 0 {
    SelectionsReady(machine, active, selections[1..]);
  }
}

  ghost function MovingPlans(plans: seq<ParallelPlan>): seq<ParallelPlan>
  {
    SeqFilter((plan: ParallelPlan) => |plan.exits| > 0 || |plan.entries| > 0, plans)
  }

  lemma MovingCombined(plans: seq<ParallelPlan>, active: seq<string>, id: string)
    ensures Combined(MovingPlans(plans), active, id) <==> Combined(plans, active, id)
  {
    assert plansExit(MovingPlans(plans), id) <==> plansExit(plans, id);
    assert plansEnter(MovingPlans(plans), id) <==> plansEnter(plans, id);
  }

  lemma AtomicNoDescendants(machine: ParallelMachine, atom: string)
    requires ParallelWellFormed(machine) && atom in machine.nodes
    requires |machine.nodes[atom].children| == 0
    ensures forall id :: id in machine.nodes ==> !below(machine.nodes[id].path, machine.nodes[atom].path)
  {
    var domain := machine.nodes[atom].path;
    PathEnds(machine, atom);
    forall id | id in machine.nodes
      ensures !below(machine.nodes[id].path, domain)
    {
      BelowMeaning(machine.nodes[id].path, domain);
      if below(machine.nodes[id].path, domain) {
        var path := machine.nodes[id].path;
        var k := |domain|;
        PathPrefixes(machine, id, k + 1);
        var child := path[k];
        assert ParallelNodeShape(machine, child);
        assert machine.nodes[child].path == domain + [child];
        assert child in machine.nodes[atom].children;
      }
    }
  }

  lemma DomainEqualTargetIsRegion(parallels: seq<string>, source: seq<string>, target: seq<string>, reenter: bool)
    requires |target| > 1 && source != target
    requires transitionDomain(parallels, source, target, reenter) == target
    ensures target[|target| - 2] in parallels
  {
    CommonPrefixMeaning(source, target);
    if commonPrefix(source, target) == |source| {
      BelowMeaning(target, source);
      assert narrow(parallels, target, source) == target;
      assert target[..|source|] == source;
      if |source| == 0 {
        assert narrow(parallels, target, source) == source;
      }
      NarrowMeaning(parallels, target, source);
      assert |source| <= |target| - 1;
      assert target[|target| - 2] in parallels;
    } else {
      var ancestors := target[..|target| - 1];
      var lca := commonPrefix(source, ancestors);
      CommonPrefixMeaning(source, ancestors);
      if lca > 0 && source[lca - 1] in parallels {
        CompoundAncestorPrefix(parallels, source[..lca]);
        assert false;
      }
      var base := if lca == 0 then target[..1] else source[..lca];
      assert |base| < |target|;
      assert narrow(parallels, target, base) == target;
      assert target[..|base|] == base;
      if reenter {
        assert transitionDomain(parallels, source, target, reenter) == source[..lca];
        assert false;
      }
      NarrowMeaning(parallels, target, base);
      assert |base| <= |target| - 1;
      assert target[|target| - 2] in parallels;
    }
  }

  lemma ReadyAtomicPlanExits(machine: ParallelMachine, active: seq<string>, selection: Selection, atom: string)
    requires ParallelWellFormed(machine) && ParallelValid(machine, active)
    requires selection.id in active && selectionReady(machine, active, selection)
    requires selectionPlan(machine, active, selection).Some?
    requires atom in machine.nodes && |machine.nodes[atom].children| == 0
    requires selectionPlan(machine, active, selection).value.domain == machine.nodes[atom].path
    requires var plan := selectionPlan(machine, active, selection).value;
      |plan.exits| > 0 || |plan.entries| > 0
    ensures atom in selectionPlan(machine, active, selection).value.exits
  {
    var result := selection.evaluation.result.value;
    var target := result.target.value;
    var source := selection.id;
    var nodes := machine.nodes;
    var plan := selectionPlan(machine, active, selection).value;
    KnownSource(machine, active, source);
    PlanContext(machine, active, source, target, result.reenter);
    AtomicNoDescendants(machine, atom);
    PathEnds(machine, atom);
    PathEnds(machine, source);
    PathEnds(machine, target);
    assert PlanDomainFacts(machine, active, source, target, result.reenter, plan);
    assert PlanMemberFacts(machine, active, target, plan);
    assert atom in active;
    if plan.reentered.None? {
      if plan.extra.Some? {
        SamePathMeaning(plan.domain, nodes[target].path);
        assert target == atom && source != target;
        if |nodes[target].path| == 1 {
          assert nodes[target].path == [machine.root];
          BelowMeaning(nodes[source].path, nodes[target].path);
          assert below(nodes[source].path, nodes[target].path);
        } else {
          assert nodes[source].path != nodes[target].path;
          DomainEqualTargetIsRegion(machine.parallels, nodes[source].path, nodes[target].path, result.reenter);
          assert !selectionReady(machine, active, selection);
        }
      }
      assert plan.extra.None?;
      assert forall id :: id in nodes ==> !exiting(nodes, plan.domain, plan.reentered, id);
      assert forall id :: id in nodes ==> !entering(nodes, machine.parallels, nodes[target].path, plan.domain, plan.extra, id);
      if |plan.exits| > 0 {
        var id := plan.exits[0];
        assert id in active && id in nodes;
        assert exiting(nodes, plan.domain, plan.reentered, id);
        assert false;
      }
      if |plan.entries| > 0 {
        var id := plan.entries[0];
        assert entering(nodes, machine.parallels, nodes[target].path, plan.domain, plan.extra, id);
        assert id in nodes;
        assert false;
      }
    }
  }

  lemma NestedMovingPlansOverlap(machine: ParallelMachine, active: seq<string>, outer: Selection, inner: Selection)
    requires ParallelWellFormed(machine) && ParallelValid(machine, active)
    requires outer.id in active && inner.id in active
    requires selectionReady(machine, active, outer) && selectionReady(machine, active, inner)
    requires selectionPlan(machine, active, outer).Some? && selectionPlan(machine, active, inner).Some?
    requires var a := selectionPlan(machine, active, outer).value;
      var b := selectionPlan(machine, active, inner).value;
      (|a.exits| > 0 || |a.entries| > 0) && (|b.exits| > 0 || |b.entries| > 0) &&
      Within(b.domain, a.domain)
    ensures overlaps(conflictExits(machine, active, outer), conflictExits(machine, active, inner))
  {
      hide *;
      reveal PlanFacts(), PlanDomainFacts(), PlanMemberFacts(), ActiveNodePath(), ParallelValid(), ParallelWellFormed();
      reveal selectionPlan, conflictExits, overlaps, Within, ChildrenActive, exiting, below, lookupNode;
    var a := selectionPlan(machine, active, outer).value;
    var b := selectionPlan(machine, active, inner).value;
    var ar := outer.evaluation.result.value;
    var br := inner.evaluation.result.value;
    KnownSource(machine, active, outer.id);
    KnownSource(machine, active, inner.id);
    PlanContext(machine, active, outer.id, ar.target.value, ar.reenter);
    PlanContext(machine, active, inner.id, br.target.value, br.reenter);
    assert PlanDomainFacts(machine, active, outer.id, ar.target.value, ar.reenter, a);
    assert PlanDomainFacts(machine, active, inner.id, br.target.value, br.reenter, b);
    assert PlanMemberFacts(machine, active, ar.target.value, a);
    assert PlanMemberFacts(machine, active, br.target.value, b);
    if |b.domain| == 0 {
      BelowMeaning(machine.nodes[machine.root].path, b.domain);
      assert a.domain == [];
      assert machine.root in a.exits && machine.root in b.exits;
    } else {
      var id := b.domain[|b.domain| - 1];
      assert id in machine.nodes && id in active && machine.nodes[id].path == b.domain;
      if |machine.nodes[id].children| > 0 {
        assert ChildrenActive(machine, active, id);
        if id in machine.parallels {
          assert machine.nodes[id].children[0] in machine.nodes[id].children;
          assert machine.nodes[id].children[0] in active;
        }
        var child :| child in machine.nodes[id].children && child in active;
        ChildWithin(machine, id, child);
        BelowMeaning(machine.nodes[child].path, b.domain);
        WithinTransitive(machine.nodes[child].path, b.domain, a.domain);
        BelowMeaning(machine.nodes[child].path, a.domain);
        assert child in a.exits && child in b.exits;
      } else {
        ReadyAtomicPlanExits(machine, active, inner, id);
        if a.domain == b.domain {
          ReadyAtomicPlanExits(machine, active, outer, id);
        } else {
          BelowMeaning(b.domain, a.domain);
          assert id in a.exits;
        }
      }
    }
  }

  lemma {:induction false} SelectionPlanMembers(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
    ensures forall plan :: plan in selectionPlans(machine, active, selections) ==>
      exists selection :: selection in selections && selectionPlan(machine, active, selection) == Some(plan)
    decreases |selections|
  {
    if |selections| > 0 {
      SelectionPlanMembers(machine, active, selections[1..]);
      var first := selectionPlan(machine, active, selections[0]);
      forall plan | plan in selectionPlans(machine, active, selections)
        ensures exists selection :: selection in selections && selectionPlan(machine, active, selection) == Some(plan)
      {
        if first != Some(plan) {
          assert plan in selectionPlans(machine, active, selections[1..]);
          var selection :| selection in selections[1..] && selectionPlan(machine, active, selection) == Some(plan);
          assert selection in selections;
        } else {
          assert selections[0] in selections;
        }
      }
    }
  }

  lemma {:induction false} ReadyMovingDomainsApart(machine: ParallelMachine, active: seq<string>, selections: seq<Selection>)
    requires ParallelWellFormed(machine) && ParallelValid(machine, active)
    requires forall selection :: selection in selections ==> selection.id in active && selectionReady(machine, active, selection)
    requires Disjoint(machine, active, selections)
    ensures domainsApart(MovingPlans(selectionPlans(machine, active, selections)))
    decreases |selections|
  {
    if |selections| > 0 {
      var first := selections[0];
      var rest := selections[1..];
      ReadyMovingDomainsApart(machine, active, rest);
      SelectionPlanMembers(machine, active, rest);
      var plan := selectionPlan(machine, active, first);
      var moving := MovingPlans(selectionPlans(machine, active, rest));
      if plan.Some? && (|plan.value.exits| > 0 || |plan.value.entries| > 0) {
        assert MovingPlans(selectionPlans(machine, active, selections)) == [plan.value] + moving;
        forall other | other in moving
          ensures !comparable(plan.value.domain, other.domain)
        {
          var selection :| selection in rest && selectionPlan(machine, active, selection) == Some(other);
          assert |other.exits| > 0 || |other.entries| > 0;
          if comparable(plan.value.domain, other.domain) {
            ComparableMeaning(plan.value.domain, other.domain);
            if Within(other.domain, plan.value.domain) {
              NestedMovingPlansOverlap(machine, active, first, selection);
            } else {
              NestedMovingPlansOverlap(machine, active, selection, first);
            }
            assert !overlaps(conflictExits(machine, active, first), conflictExits(machine, active, selection));
          }
        }
        assert ([plan.value] + moving)[1..] == moving;
      } else {
        assert MovingPlans(selectionPlans(machine, active, selections)) == moving;
      }
    }
  }
lemma CombinedLifecycleLists(machine: ParallelMachine, active: seq<string>, plans: seq<ParallelPlan>)
  requires ParallelWellFormed(machine) && ParallelValid(machine, active)
  ensures var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
    var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
    declaredPath(machine.nodes, exits) && declaredPath(machine.nodes, entries) &&
    (forall id :: id in exits <==> id in active && plansExit(plans, id)) &&
    (forall id :: id in entries <==> id in machine.nodes && plansEnter(plans, id)) &&
    Subseq(reverse(exits), active) && Subseq(entries, machine.order)
{
  var p := (id: string) => plansExit(plans, id);
  var filtered := SeqFilter(p, active);
  var exits := reverse(filtered);
  var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
  ReverseMembers(filtered);
  ReverseInvolution(filtered);
  FilterSubseq(p, active);
  FiltersAreSubsequences(machine.order);
  DeclaredMembers(machine.nodes, exits);
  DeclaredMembers(machine.nodes, entries);
}

lemma MultiStepMeaning(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  requires ParallelWellFormed(machine) && ParallelValid(machine, snapshot.active)
  requires |parallelSelections(machine, snapshot, event)| >= 2
  ensures var active := snapshot.active;
    var kept := removeConflicts(machine, active, parallelSelections(machine, snapshot, event), []);
    var plans := selectionPlans(machine, active, kept);
    var step := parallelStep(machine, snapshot, event);
    var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
    var entries := SeqFilter((id: string) => plansEnter(plans, id), machine.order);
    declaredPath(machine.nodes, exits) && declaredPath(machine.nodes, entries) &&
    var exited := lifecycle(machine.nodes, exits, snapshot.context, event, true);
    var updated := applyAll(exited.context, kept);
    var entered := lifecycle(machine.nodes, entries, updated.context, event, false);
    step == ParallelStep(ParallelSnapshot(step.snapshot.active, entered.context), false,
      exited.reused && updated.reused && entered.reused,
      exited.effects + Effects(kept) + entered.effects)
{
  var active := snapshot.active;
  var kept := removeConflicts(machine, active, parallelSelections(machine, snapshot, event), []);
  var plans := selectionPlans(machine, active, kept);
  CombinedLifecycleLists(machine, active, plans);
  var exits := reverse(SeqFilter((id: string) => plansExit(plans, id), active));
  var exited := lifecycle(machine.nodes, exits, snapshot.context, event, true);
  ApplyAllEffects(exited.context, kept);
}

// Eventless transitions and bounded macrosteps (robertpenner/xstate#34), with
// raised events queued between microsteps (robertpenner/xstate#35).

ghost function NodeAt(machine: Machine, value: string): Option<Node>
{
  if value in machine.states then Some(machine.states[value]) else None
}

ghost predicate AlwaysEnabled(machine: Machine, snapshot: Snapshot, event: Event)
{
  alwaysSelected(machine, snapshot, event).result.Some? ||
  |alwaysSelected(machine, snapshot, event).effects| > 0 ||
  |alwaysSelected(machine, snapshot, event).raises| > 0
}

ghost predicate AlwaysDeclared(machine: Machine)
{
  forall id, context, event ::
    id in machine.states &&
    machine.states[id].always(context, event).result.Some? &&
    machine.states[id].always(context, event).result.value.target.Some? ==>
      machine.states[id].always(context, event).result.value.target.value in machine.states
}

ghost predicate OnDeclared(machine: Machine)
{
  forall id, type_, context, event ::
    id in machine.states && type_ in machine.states[id].on &&
    machine.states[id].on[type_](context, event).result.Some? &&
    machine.states[id].on[type_](context, event).result.value.target.Some? ==>
      machine.states[id].on[type_](context, event).result.value.target.value in machine.states
}

ghost function TraceEffects(trace: seq<Step>): seq<Effect>
  decreases |trace|
{
  if |trace| == 0 then [] else trace[0].effects + TraceEffects(trace[1..])
}

ghost function TraceRaised(trace: seq<Step>): seq<Event>
  decreases |trace|
{
  if |trace| == 0 then [] else trace[0].raised + TraceRaised(trace[1..])
}

ghost predicate AllSnapshotsReused(trace: seq<Step>)
{
  forall i :: 0 <= i < |trace| ==> trace[i].snapshotReused
}

ghost predicate AllContextsReused(trace: seq<Step>)
{
  forall i :: 0 <= i < |trace| ==> trace[i].contextReused
}

ghost function NextEventless(machine: Machine, step: Step, event: Event): Step
{
  eventlessStep(machine, step.snapshot, event, alwaysSelected(machine, step.snapshot, event))
}

// An eventless transition is taken before the next raised event is dequeued.
ghost predicate Proceeds(machine: Machine, step: Step, event: Event, select: bool)
{
  select && AlwaysEnabled(machine, step.snapshot, event)
}

// A done machine takes no further microsteps, whatever the budget.
ghost predicate Done(machine: Machine, step: Step)
{
  completed(machine, step.snapshot.value)
}

ghost predicate Continues(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>)
{
  !Done(machine, step) && (Proceeds(machine, step, event, select) || |queue| > 0)
}

ghost function NextStep(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>): Step
  requires Continues(machine, step, event, select, queue)
{
  if Proceeds(machine, step, event, select) then NextEventless(machine, step, event)
  else transition(machine, step.snapshot, queue[0])
}

ghost function NextEvent(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>): Event
  requires Continues(machine, step, event, select, queue)
{
  if Proceeds(machine, step, event, select) then event else queue[0]
}

ghost function NextSelect(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>): bool
  requires Continues(machine, step, event, select, queue)
{
  !Proceeds(machine, step, event, select) || !NextStep(machine, step, event, select, queue).snapshotReused
}

ghost function NextQueue(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>): seq<Event>
  requires Continues(machine, step, event, select, queue)
{
  (if Proceeds(machine, step, event, select) then queue else queue[1..]) +
    NextStep(machine, step, event, select, queue).raised
}

ghost function Advanced(step: Step, next: Step): Step
{
  Step(next.snapshot, step.snapshotReused && next.snapshotReused,
       step.contextReused && next.contextReused, step.effects + next.effects,
       step.raised + next.raised)
}

lemma SettleUnfold(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires remaining > 0 && Continues(machine, step, event, select, queue)
  ensures var next := NextStep(machine, step, event, select, queue);
          var rest := settle(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                             NextSelect(machine, step, event, select, queue),
                             NextQueue(machine, step, event, select, queue), remaining - 1);
          settle(machine, step, event, select, queue, remaining) ==
            Macrostep(rest.settled, rest.step, rest.queue, [next] + rest.trace)
{
}

// Eventless transitions run before a dequeue; their raises join the back of the queue.
lemma SettleEventless(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires remaining > 0 && !Done(machine, step) && Proceeds(machine, step, event, select)
  ensures var next := NextEventless(machine, step, event);
          var rest := settle(machine, Advanced(step, next), event, !next.snapshotReused,
                             queue + next.raised, remaining - 1);
          settle(machine, step, event, select, queue, remaining) ==
            Macrostep(rest.settled, rest.step, rest.queue, [next] + rest.trace)
{
  SettleUnfold(machine, step, event, select, queue, remaining);
}

// FIFO: the head of the queue is processed as an event, the step's raises are
// appended, and eventless transitions are reselected against the dequeued event.
lemma SettleDequeue(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires remaining > 0 && !Done(machine, step) && !Proceeds(machine, step, event, select) && |queue| > 0
  ensures var next := transition(machine, step.snapshot, queue[0]);
          var rest := settle(machine, Advanced(step, next), queue[0], true,
                             queue[1..] + next.raised, remaining - 1);
          settle(machine, step, event, select, queue, remaining) ==
            Macrostep(rest.settled, rest.step, rest.queue, [next] + rest.trace)
{
  SettleUnfold(machine, step, event, select, queue, remaining);
}

lemma SettleStops(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires remaining > 0 && !Continues(machine, step, event, select, queue)
  ensures settle(machine, step, event, select, queue, remaining) == Macrostep(true, step, [], [])
{
}

// A raised event that no transition handles still takes a microstep.
lemma DequeueUnhandled(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires remaining > 0 && !Done(machine, step) && !Proceeds(machine, step, event, select) && |queue| > 0
  requires step.snapshot.value in machine.states
  requires queue[0].type_ !in machine.states[step.snapshot.value].on
  ensures settle(machine, step, event, select, queue, remaining).trace[0] ==
    Step(step.snapshot, true, true, [], [])
{
  SettleUnfold(machine, step, event, select, queue, remaining);
}

lemma MacrostepQueues(machine: Machine, snapshot: Snapshot, event: Event, maxIterations: int)
  ensures initialMacrostep(machine, event, maxIterations) ==
    settle(machine, initialTransition(machine, event), event, true,
           initialTransition(machine, event).raised, maxIterations)
  ensures transitionMacrostep(machine, snapshot, event, maxIterations) ==
    settle(machine, transition(machine, snapshot, event), event, true,
           transition(machine, snapshot, event).raised, maxIterations)
{
}

lemma EventStepShared(machine: Machine, snapshot: Snapshot, event: Event)
  ensures transition(machine, snapshot, event) ==
    takeTransition(machine, snapshot, event, NodeAt(machine, snapshot.value),
      Selected(machine, snapshot, event))
{
}

lemma EventlessIdentity(machine: Machine, snapshot: Snapshot, event: Event, selected: Evaluation)
  ensures var taken := takeTransition(machine, snapshot, event, NodeAt(machine, snapshot.value), selected);
          eventlessStep(machine, snapshot, event, selected) ==
            (if taken.snapshot.value == snapshot.value && taken.contextReused
             then Step(snapshot, true, true, taken.effects, taken.raised)
             else Step(taken.snapshot, false, taken.contextReused, taken.effects, taken.raised))
{
}

// Eventless and dequeue microsteps count against the same bound.
lemma SettleBudget(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires remaining >= 0
  ensures |settle(machine, step, event, select, queue, remaining).trace| <= remaining
  ensures settle(machine, step, event, select, queue, remaining).settled <==>
    |settle(machine, step, event, select, queue, remaining).trace| < remaining ||
    Done(machine, settle(machine, step, event, select, queue, remaining).step)
  decreases remaining
{
  if remaining > 0 && Continues(machine, step, event, select, queue) {
    var next := NextStep(machine, step, event, select, queue);
    SettleUnfold(machine, step, event, select, queue, remaining);
    SettleBudget(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                 NextSelect(machine, step, event, select, queue),
                 NextQueue(machine, step, event, select, queue), remaining - 1);
  }
}

// The event and selection flag in force when settle stops.
ghost function FinalEvent(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>,
                          remaining: int): (Event, bool)
  decreases remaining
{
  if remaining > 0 && Continues(machine, step, event, select, queue) then
    FinalEvent(machine, Advanced(step, NextStep(machine, step, event, select, queue)),
               NextEvent(machine, step, event, select, queue),
               NextSelect(machine, step, event, select, queue),
               NextQueue(machine, step, event, select, queue), remaining - 1)
  else (event, select)
}

// At rest the queue is empty and no eventless transition is enabled.
lemma SettleRest(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  ensures var m := settle(machine, step, event, select, queue, remaining);
          var final := FinalEvent(machine, step, event, select, queue, remaining);
          m.settled ==> m.queue == [] && (Done(machine, m.step) || !Proceeds(machine, m.step, final.0, final.1))
  ensures var m := settle(machine, step, event, select, queue, remaining);
          m.settled && |m.trace| == 0 ==> !Continues(machine, step, event, select, queue)
  decreases remaining
{
  if remaining > 0 && Continues(machine, step, event, select, queue) {
    var next := NextStep(machine, step, event, select, queue);
    SettleUnfold(machine, step, event, select, queue, remaining);
    SettleRest(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
               NextSelect(machine, step, event, select, queue),
               NextQueue(machine, step, event, select, queue), remaining - 1);
  }
}

// Without raises, only the last eventless step may reuse the snapshot.
lemma SettleSteps(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  ensures var m := settle(machine, step, event, select, queue, remaining);
          (|m.trace| > 0 ==> Continues(machine, step, event, select, queue)) &&
          (queue == [] && TraceRaised(m.trace) == [] ==>
            forall i :: 0 <= i < |m.trace| - 1 ==> !m.trace[i].snapshotReused)
  decreases remaining
{
  if remaining > 0 && Continues(machine, step, event, select, queue) {
    var next := NextStep(machine, step, event, select, queue);
    var rest := settle(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                       NextSelect(machine, step, event, select, queue),
                       NextQueue(machine, step, event, select, queue), remaining - 1);
    SettleUnfold(machine, step, event, select, queue, remaining);
    SettleSteps(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                NextSelect(machine, step, event, select, queue),
                NextQueue(machine, step, event, select, queue), remaining - 1);
    var trace := [next] + rest.trace;
    assert trace[1..] == rest.trace;
    assert TraceRaised(trace) == next.raised + TraceRaised(rest.trace);
    if queue == [] && TraceRaised(trace) == [] {
      assert next.raised == [] && TraceRaised(rest.trace) == [];
      assert NextQueue(machine, step, event, select, queue) == [];
      if next.snapshotReused && remaining - 1 > 0 {
        SettleStops(machine, Advanced(step, next), event, false, [], remaining - 1);
      }
      forall i | 0 <= i < |trace| - 1 ensures !trace[i].snapshotReused {
        if i > 0 { assert trace[i] == rest.trace[i - 1]; }
      }
    }
  }
}

lemma {:isolate_assertions} SettleAccumulates(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  ensures var m := settle(machine, step, event, select, queue, remaining);
          m.step.snapshot == (if |m.trace| == 0 then step.snapshot else m.trace[|m.trace| - 1].snapshot) &&
          m.step.effects == step.effects + TraceEffects(m.trace) &&
          m.step.raised == step.raised + TraceRaised(m.trace) &&
          m.step.snapshotReused == (step.snapshotReused && AllSnapshotsReused(m.trace)) &&
          m.step.contextReused == (step.contextReused && AllContextsReused(m.trace))
  decreases remaining
{
  if remaining > 0 && Continues(machine, step, event, select, queue) {
    var next := NextStep(machine, step, event, select, queue);
    var rest := settle(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                       NextSelect(machine, step, event, select, queue),
                       NextQueue(machine, step, event, select, queue), remaining - 1);
    SettleUnfold(machine, step, event, select, queue, remaining);
    SettleAccumulates(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                      NextSelect(machine, step, event, select, queue),
                      NextQueue(machine, step, event, select, queue), remaining - 1);
    var trace := [next] + rest.trace;
    assert trace[1..] == rest.trace;
    assert TraceEffects(trace) == next.effects + TraceEffects(rest.trace);
    assert TraceRaised(trace) == next.raised + TraceRaised(rest.trace);
    assert AllSnapshotsReused(trace) == (next.snapshotReused && AllSnapshotsReused(rest.trace)) by {
      if next.snapshotReused && AllSnapshotsReused(rest.trace) {
        forall i | 0 <= i < |trace| ensures trace[i].snapshotReused {
          if i > 0 { assert trace[i] == rest.trace[i - 1]; }
        }
      }
    }
    assert AllContextsReused(trace) == (next.contextReused && AllContextsReused(rest.trace)) by {
      if next.contextReused && AllContextsReused(rest.trace) {
        forall i | 0 <= i < |trace| ensures trace[i].contextReused {
          if i > 0 { assert trace[i] == rest.trace[i - 1]; }
        }
      }
    }
  } else {
    assert TraceEffects([]) == [];
    assert TraceRaised([]) == [];
  }
}

lemma SettleStable(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>,
                   small: int, large: int)
  requires 0 <= small <= large
  ensures var a := settle(machine, step, event, select, queue, small);
          var b := settle(machine, step, event, select, queue, large);
          a.trace <= b.trace && (a.settled ==> a == b)
  decreases small
{
  if small > 0 && Continues(machine, step, event, select, queue) {
    var next := NextStep(machine, step, event, select, queue);
    SettleUnfold(machine, step, event, select, queue, small);
    SettleUnfold(machine, step, event, select, queue, large);
    SettleStable(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                 NextSelect(machine, step, event, select, queue),
                 NextQueue(machine, step, event, select, queue), small - 1, large - 1);
  } else if small > 0 {
    SettleStops(machine, step, event, select, queue, small);
    SettleStops(machine, step, event, select, queue, large);
  }
}

lemma EventlessDeclared(machine: Machine, snapshot: Snapshot, event: Event)
  requires AlwaysDeclared(machine)
  requires snapshot.value in machine.states
  ensures eventlessStep(machine, snapshot, event, alwaysSelected(machine, snapshot, event)).snapshot.value
    in machine.states
{
  var selected := alwaysSelected(machine, snapshot, event);
  assert selected == machine.states[snapshot.value].always(snapshot.context, event);
}

lemma DequeueDeclared(machine: Machine, snapshot: Snapshot, event: Event)
  requires OnDeclared(machine)
  requires snapshot.value in machine.states
  ensures transition(machine, snapshot, event).snapshot.value in machine.states
{
  if !machine.states[snapshot.value].final && event.type_ in machine.states[snapshot.value].on {
    assert Selected(machine, snapshot, event) ==
      machine.states[snapshot.value].on[event.type_](snapshot.context, event);
  }
  StepDeclared(machine, snapshot, event);
}

lemma SettleValid(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires AlwaysDeclared(machine) && OnDeclared(machine)
  requires step.snapshot.value in machine.states
  ensures var m := settle(machine, step, event, select, queue, remaining);
          m.step.snapshot.value in machine.states &&
          forall i :: 0 <= i < |m.trace| ==> m.trace[i].snapshot.value in machine.states
  decreases remaining
{
  if remaining > 0 && Continues(machine, step, event, select, queue) {
    var next := NextStep(machine, step, event, select, queue);
    if Proceeds(machine, step, event, select) {
      EventlessDeclared(machine, step.snapshot, event);
    } else {
      DequeueDeclared(machine, step.snapshot, queue[0]);
    }
    SettleUnfold(machine, step, event, select, queue, remaining);
    SettleValid(machine, Advanced(step, next), NextEvent(machine, step, event, select, queue),
                NextSelect(machine, step, event, select, queue),
                NextQueue(machine, step, event, select, queue), remaining - 1);
  }
}

lemma IdentityStepRunsOnce(machine: Machine, step: Step, event: Event, remaining: int)
  requires remaining >= 2 && !Done(machine, step)
  requires AlwaysEnabled(machine, step.snapshot, event)
  requires NextEventless(machine, step, event).snapshotReused
  requires NextEventless(machine, step, event).raised == []
  ensures var m := settle(machine, step, event, true, [], remaining);
          m.settled && |m.trace| == 1
{
  var next := NextEventless(machine, step, event);
  SettleEventless(machine, step, event, true, [], remaining);
  assert [] + next.raised == [];
  SettleStops(machine, Advanced(step, next), event, false, [], remaining - 1);
}

lemma EmptyPatchLoops(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>,
                      remaining: int)
  requires select
  requires step.snapshot.value in machine.states && !machine.states[step.snapshot.value].final
  requires forall context ::
    (machine.states[step.snapshot.value].always(context, event).result ==
     Some(Result(None, Some([]), false)))
  ensures !settle(machine, step, event, select, queue, remaining).settled
  decreases remaining
{
  if remaining > 0 {
    assert alwaysSelected(machine, step.snapshot, event).result == Some(Result(None, Some([]), false));
    var next := NextEventless(machine, step, event);
    assert next.snapshot.value == step.snapshot.value && !next.snapshotReused;
    SettleEventless(machine, step, event, select, queue, remaining);
    EmptyPatchLoops(machine, Advanced(step, next), event, true, queue + next.raised, remaining - 1);
  }
}

// Completion (robertpenner/xstate#37). In the flat model every state is a
// child of the root, so entering a final state completes the machine.

// A non-final destination completes nothing.
lemma CompletionInert(machine: Machine, value: string, context: map<string, int>, event: Event)
  requires !completed(machine, value)
  ensures completion(machine, value, context, event) == Completion(context, true, [], None)
{
}

// A final root child resolves its output from the entered context, then the
// root output from that context and a done event carrying the final output,
// and only then runs its exit. The runtime order is the subject of
// statelyai/xstate#5949; exit raises are discarded.
lemma CompletionOrder(machine: Machine, value: string, context: map<string, int>, event: Event)
  requires completed(machine, value)
  ensures var node := machine.states[value];
          var finalOutput := node.output(context, event);
          var exited := apply(context, node.exit(context, event));
          completion(machine, value, context, event) ==
            Completion(exited.context, exited.reused, exited.effects,
              Some(if machine.hasOutput then machine.output(context, doneEvent(value, finalOutput))
                   else finalOutput))
{
}

// A done snapshot takes no transitions: same snapshot, no effects, no raises.
lemma TerminalInert(machine: Machine, snapshot: Snapshot, event: Event)
  requires completed(machine, snapshot.value)
  ensures transition(machine, snapshot, event) == Step(snapshot, true, true, [], [])
{
}

// Completion ends the macrostep before the budget is checked and discards
// the queued raises.
lemma SettleDone(machine: Machine, step: Step, event: Event, select: bool, queue: seq<Event>, remaining: int)
  requires completed(machine, step.snapshot.value)
  ensures settle(machine, step, event, select, queue, remaining) == Macrostep(true, step, [], [])
{
}

// A later event sent to a done snapshot is a settled macrostep with no
// microsteps beyond the event's own identity step.
lemma TerminalMacrostep(machine: Machine, snapshot: Snapshot, event: Event, maxIterations: int)
  requires completed(machine, snapshot.value)
  ensures transitionMacrostep(machine, snapshot, event, maxIterations) ==
    Macrostep(true, Step(snapshot, true, true, [], []), [], [])
{
  TerminalInert(machine, snapshot, event);
}

// Output is undefined while the machine is active.
lemma ActiveOutputUndefined(machine: Machine, snapshot: Snapshot, event: Event)
  requires snapshot.output.None?
  requires !completed(machine, transition(machine, snapshot, event).snapshot.value)
  ensures transition(machine, snapshot, event).snapshot.output.None?
{
}

// Entering a final state defines the output.
lemma EnteredFinalDefinesOutput(machine: Machine, snapshot: Snapshot, event: Event)
  requires transition(machine, snapshot, event).snapshot.value != snapshot.value
  requires completed(machine, transition(machine, snapshot, event).snapshot.value)
  ensures transition(machine, snapshot, event).snapshot.output.Some?
{
}

// An initial final state completes during initialization: the entry runs,
// then completion, and the entry's raises are discarded by settle.
lemma InitialCompletion(machine: Machine, event: Event, maxIterations: int)
  requires completed(machine, machine.initial)
  ensures var node := machine.states[machine.initial];
          var entering := node.entry(machine.context, event);
          var applied := apply(machine.context, entering);
          var done := completion(machine, machine.initial, applied.context, event);
          initialTransition(machine, event) ==
            Step(Snapshot(machine.initial, done.context, done.output), false,
                 applied.reused && done.reused, applied.effects + done.effects, entering.raises) &&
          done.output.Some? &&
          initialMacrostep(machine, event, maxIterations) ==
            Macrostep(true, initialTransition(machine, event), [], [])
{
}

// Compound transition proofs
ghost predicate TreePath(machine: CompoundMachine, path: seq<string>)
{
  |path| > 0 && path[0] == machine.root &&
  declaredPath(machine.nodes, path) &&
  |machine.nodes[path[|path| - 1]].children| == 0 &&
  (forall i :: 0 <= i < |path| ==> machine.nodes[path[i]].path == path[..i + 1]) &&
  (forall i :: 0 <= i < |path| - 1 ==> path[i + 1] in machine.nodes[path[i]].children)
}

ghost predicate WellFormed(machine: CompoundMachine)
{
  machine.root in machine.nodes &&
  machine.nodes[machine.root].path == [machine.root] &&
  (forall id :: id in machine.nodes ==>
    |machine.nodes[id].path| > 0 &&
    machine.nodes[id].path[|machine.nodes[id].path| - 1] == id &&
    initialWitness(machine.nodes, id) &&
    TreePath(machine, machine.nodes[id].initialPath) &&
    commonPrefix(machine.nodes[id].path, machine.nodes[id].initialPath) == |machine.nodes[id].path| &&
    (forall child :: child in machine.nodes[id].children ==>
      child in machine.nodes &&
      machine.nodes[child].path == machine.nodes[id].path + [child]))
}

ghost predicate ValidConfiguration(machine: CompoundMachine, path: seq<string>)
{
  TreePath(machine, path) &&
  (forall i :: 0 <= i < |path| && |machine.nodes[path[i]].children| > 0 ==>
    (exists child :: child in machine.nodes[path[i]].children && child in path) &&
    (forall a, b ::
      (a in machine.nodes[path[i]].children && a in path &&
      b in machine.nodes[path[i]].children && b in path) ==> a == b))
}

lemma PathHasExactlyOneChild(machine: CompoundMachine, path: seq<string>)
  requires WellFormed(machine)
  requires TreePath(machine, path)
  ensures ValidConfiguration(machine, path)
{
  forall i | 0 <= i < |path| && |machine.nodes[path[i]].children| > 0
    ensures (exists child :: child in machine.nodes[path[i]].children && child in path) &&
      (forall a, b ::
        (a in machine.nodes[path[i]].children && a in path &&
        b in machine.nodes[path[i]].children && b in path) ==> a == b)
  {
    assert i < |path| - 1;
    assert path[i + 1] in machine.nodes[path[i]].children;
    forall child | child in machine.nodes[path[i]].children && child in path
      ensures child == path[i + 1]
    {
      var j :| 0 <= j < |path| && path[j] == child;
      assert machine.nodes[child].path == path[..j + 1];
      assert machine.nodes[child].path == path[..i + 1] + [child];
      assert j == i + 1;
    }
  }
}

lemma CompoundInitialValid(machine: CompoundMachine, event: Event)
  requires WellFormed(machine)
  ensures ValidConfiguration(machine, compoundInitialTransition(machine, event).snapshot.path)
{
  PathHasExactlyOneChild(machine, machine.nodes[machine.root].initialPath);
}

lemma CompoundStepValid(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event)
  requires WellFormed(machine)
  requires ValidConfiguration(machine, snapshot.path)
  requires ready(machine, snapshot, event)
  ensures ValidConfiguration(machine, compoundTransition(machine, snapshot, event).snapshot.path)
{
  var chosen := select(machine.nodes, snapshot.path, snapshot.context, event);
  if compoundDone(machine, snapshot.path) {
    assert compoundTransition(machine, snapshot, event).snapshot == snapshot;
  } else if chosen.Some? && chosen.value.evaluation.result.Some? &&
     chosen.value.evaluation.result.value.target.Some? {
    var target := chosen.value.evaluation.result.value.target.value;
    assert target in machine.nodes;
    PathHasExactlyOneChild(machine, machine.nodes[target].initialPath);
  }
}

lemma InitialDescendantTraversal(nodes: map<string, CompoundNode>, id: string)
  requires id in nodes
  requires forall k :: k in nodes ==> initialWitness(nodes, k)
  ensures nodes[id].initial.None? ==> descend(nodes, id) == nodes[id].path
  ensures nodes[id].initial.Some? ==>
    descend(nodes, id) == descend(nodes, nodes[id].initial.value)
{
  assert initialWitness(nodes, id);
}

ghost function NodeEvaluation(nodes: map<string, CompoundNode>, id: string,
                              context: map<string, int>, event: Event): Evaluation
  requires id in nodes
{
  if event.type_ in nodes[id].on then nodes[id].on[event.type_](context, event)
  else Evaluation(None, [], [])
}

ghost predicate Enabled(evaluation: Evaluation)
{
  evaluation.result.Some? || |evaluation.effects| > 0 || |evaluation.raises| > 0
}

lemma DeepestSelection(nodes: map<string, CompoundNode>, path: seq<string>,
                       context: map<string, int>, event: Event)
  requires declaredPath(nodes, path)
  ensures select(nodes, path, context, event).None? <==>
    (forall i :: 0 <= i < |path| ==> !Enabled(NodeEvaluation(nodes, path[i], context, event)))
  ensures select(nodes, path, context, event).Some? ==>
    (exists i :: 0 <= i < |path| &&
      select(nodes, path, context, event).value == Selection(path[i], nodes[path[i]], NodeEvaluation(nodes, path[i], context, event)) &&
      Enabled(NodeEvaluation(nodes, path[i], context, event)) &&
      (forall j :: i < j < |path| ==> !Enabled(NodeEvaluation(nodes, path[j], context, event))))
  decreases |path|
{
  if |path| > 0 {
    var last := |path| - 1;
    if Enabled(NodeEvaluation(nodes, path[last], context, event)) {
      assert select(nodes, path, context, event).value ==
        Selection(path[last], nodes[path[last]], NodeEvaluation(nodes, path[last], context, event));
    } else {
      var prefix := path[..last];
      DeepestSelection(nodes, prefix, context, event);
      assert select(nodes, path, context, event) == select(nodes, prefix, context, event);
      if select(nodes, prefix, context, event).Some? {
        var i :| 0 <= i < last &&
          select(nodes, prefix, context, event).value ==
            Selection(prefix[i], nodes[prefix[i]], NodeEvaluation(nodes, prefix[i], context, event)) &&
          Enabled(NodeEvaluation(nodes, prefix[i], context, event)) &&
          (forall j :: i < j < last ==> !Enabled(NodeEvaluation(nodes, prefix[j], context, event)));
        forall j | i < j < |path|
          ensures !Enabled(NodeEvaluation(nodes, path[j], context, event))
        {
          if j < last {
            assert prefix[j] == path[j];
          }
        }
      } else {
        forall i | 0 <= i < |path|
          ensures !Enabled(NodeEvaluation(nodes, path[i], context, event))
        {
          if i < last {
            assert prefix[i] == path[i];
          }
        }
      }
    }
  }
}

lemma DecliningChildFallsBack(nodes: map<string, CompoundNode>, path: seq<string>,
                             context: map<string, int>, event: Event)
  requires declaredPath(nodes, path) && |path| > 0
  requires NodeEvaluation(nodes, path[|path| - 1], context, event) == Evaluation(None, [], [])
  ensures select(nodes, path, context, event) == select(nodes, path[..|path| - 1], context, event)
{
}

lemma ExplicitBlockWins(nodes: map<string, CompoundNode>, path: seq<string>,
                       context: map<string, int>, event: Event)
  requires declaredPath(nodes, path) && |path| > 0
  requires NodeEvaluation(nodes, path[|path| - 1], context, event) ==
    Evaluation(Some(Result(None, None, false)), [], [])
  ensures select(nodes, path, context, event).Some?
  ensures select(nodes, path, context, event).value.id == path[|path| - 1]
{
}

lemma EffectOnlyChildWins(nodes: map<string, CompoundNode>, path: seq<string>,
                         context: map<string, int>, event: Event)
  requires declaredPath(nodes, path) && |path| > 0
  requires |NodeEvaluation(nodes, path[|path| - 1], context, event).effects| > 0
  ensures select(nodes, path, context, event).Some?
  ensures select(nodes, path, context, event).value.id == path[|path| - 1]
{
}

lemma {:induction false} {:isolate_assertions} LifecycleCons(nodes: map<string, CompoundNode>, path: seq<string>,
  context: map<string, int>, event: Event, exiting: bool)
  requires declaredPath(nodes, path) && |path| > 0
  ensures var evaluation := if exiting then nodes[path[0]].exit(context, event) else nodes[path[0]].entry(context, event);
    var first := apply(context, evaluation);
    var rest := lifecycle(nodes, path[1..], first.context, event, exiting);
    lifecycle(nodes, path, context, event, exiting) ==
      Applied(rest.context, first.reused && rest.reused, first.effects + rest.effects, first.raises + rest.raises)
{
}

lemma {:induction false} {:isolate_assertions} LifecycleConcatenation(nodes: map<string, CompoundNode>, a: seq<string>, b: seq<string>,
                             context: map<string, int>, event: Event, exiting: bool)
  requires declaredPath(nodes, a + b)
  ensures var first := lifecycle(nodes, a, context, event, exiting);
          var second := lifecycle(nodes, b, first.context, event, exiting);
          lifecycle(nodes, a + b, context, event, exiting) ==
            Applied(second.context, first.reused && second.reused, first.effects + second.effects, first.raises + second.raises)
  decreases |a|
{
  hide *;
  if |a| > 0 {
    assert lookupNode(nodes, a[0]) == nodes[a[0]];
    var evaluation := if exiting then nodes[a[0]].exit(context, event) else nodes[a[0]].entry(context, event);
    var first := apply(context, evaluation);
    assert a + b == [a[0]] + (a[1..] + b);
    assert (a + b)[1..] == a[1..] + b;
    LifecycleCons(nodes, a, context, event, exiting);
    LifecycleCons(nodes, a + b, context, event, exiting);
    LifecycleConcatenation(nodes, a[1..], b, first.context, event, exiting);
    var rest := lifecycle(nodes, a[1..], first.context, event, exiting);
    var second := lifecycle(nodes, b, rest.context, event, exiting);
    assert lifecycle(nodes, a, context, event, exiting) ==
      Applied(rest.context, first.reused && rest.reused, first.effects + rest.effects, first.raises + rest.raises);
    assert lifecycle(nodes, a[1..] + b, first.context, event, exiting) ==
      Applied(second.context, rest.reused && second.reused, rest.effects + second.effects, rest.raises + second.raises);
    assert lifecycle(nodes, a + b, context, event, exiting) ==
      Applied(second.context, first.reused && (rest.reused && second.reused),
        first.effects + (rest.effects + second.effects), first.raises + (rest.raises + second.raises));
    assert first.effects + (rest.effects + second.effects) ==
      (first.effects + rest.effects) + second.effects;
    assert first.raises + (rest.raises + second.raises) ==
      (first.raises + rest.raises) + second.raises;
  } else {
    assert a + b == b;
    assert lifecycle(nodes, a, context, event, exiting) == Applied(context, true, [], []);
  }
}

ghost function Target(evaluation: Evaluation): Option<string>
{
  if evaluation.result.Some? then evaluation.result.value.target else None
}

ghost function Reenters(evaluation: Evaluation): bool
{
  evaluation.result.Some? && evaluation.result.value.reenter
}

ghost function Kept(source: seq<string>, target: seq<string>, reenter: bool): int
{
  if commonPrefix(source, target) == |source|
  then |source| - (if reenter then 1 else 0)
  else commonPrefix(source, if |target| == 0 then [] else target[..|target| - 1])
}

lemma {:induction false} {:isolate_assertions} CompoundLifecycleMeaning(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event)
  requires WellFormed(machine)
  requires ValidConfiguration(machine, snapshot.path)
  requires ready(machine, snapshot, event)
  requires !compoundDone(machine, snapshot.path)
  ensures var chosen := select(machine.nodes, snapshot.path, snapshot.context, event);
    chosen.None? ==> compoundTransition(machine, snapshot, event) == CompoundStep(snapshot, true, true, [], [])
  ensures var chosen := select(machine.nodes, snapshot.path, snapshot.context, event);
    chosen.Some? ==>
      var target := Target(chosen.value.evaluation);
      var reenter := Reenters(chosen.value.evaluation);
      var nextPath := if target.Some? then machine.nodes[target.value].initialPath else snapshot.path;
      var kept := if target.Some? then Kept(chosen.value.node.path, machine.nodes[target.value].path, reenter) else 0;
      var exitKept := if target == Some(machine.root) && !reenter then 1 else kept;
      var exits := if target.Some? then reverse(snapshot.path[exitKept..]) else [];
      var entries := if target.Some? then nextPath[kept..] else [];
      var exited := lifecycle(machine.nodes, exits, snapshot.context, event, true);
      var updated := apply(exited.context, chosen.value.evaluation);
      var entered := lifecycle(machine.nodes, entries, updated.context, event, false);
      var done := compoundCompletion(machine, nextPath, |entries| > 0, entered.context, event);
      compoundTransition(machine, snapshot, event) ==
        CompoundStep(CompoundSnapshot(nextPath, done.context, done.output), false,
          exited.reused && updated.reused && entered.reused && done.reused,
          exited.effects + chosen.value.evaluation.effects + entered.effects + done.effects,
          exited.raises + chosen.value.evaluation.raises + entered.raises + done.raised)
{
  hide *;
  assert declaredPath(machine.nodes, snapshot.path) by {
    reveal ValidConfiguration(), TreePath();
  }
  assert forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k) by {
    reveal WellFormed();
  }
  reveal Target(), Reenters(), Kept(), compoundTransition();
  var chosen := select(machine.nodes, snapshot.path, snapshot.context, event);
  if chosen.Some? {
    var target := Target(chosen.value.evaluation);
    var reenter := Reenters(chosen.value.evaluation);
    if target.Some? {
      assert target.value in machine.nodes by {
        reveal ready();
      }
      assert descend(machine.nodes, target.value) == machine.nodes[target.value].initialPath by {
        reveal WellFormed();
      }
      if reenter {
        assert chosen.value.evaluation.result.value.reenter;
      } else {
        assert !chosen.value.evaluation.result.value.reenter;
      }
    } else {
      if reenter {
        assert chosen.value.evaluation.result.Some?;
      } else {
        assert !Reenters(chosen.value.evaluation);
      }
    }
  }
}

lemma CompoundSelfResetsDescendants(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event)
  requires WellFormed(machine)
  requires ValidConfiguration(machine, snapshot.path)
  requires ready(machine, snapshot, event)
  requires !compoundDone(machine, snapshot.path)
  requires select(machine.nodes, snapshot.path, snapshot.context, event).Some?
  requires Target(select(machine.nodes, snapshot.path, snapshot.context, event).value.evaluation) ==
    Some(select(machine.nodes, snapshot.path, snapshot.context, event).value.id)
  ensures compoundTransition(machine, snapshot, event).snapshot.path ==
    machine.nodes[select(machine.nodes, snapshot.path, snapshot.context, event).value.id].initialPath
{
}

lemma {:induction false} ReverseLifecycleOrder(path: seq<string>, i: int)
  requires 0 <= i < |path|
  ensures reverse(path)[i] == path[|path| - 1 - i]
  decreases |path|
{
  if i < |path| - 1 {
    ReverseLifecycleOrder(path[1..], i);
    assert reverse(path)[i] == reverse(path[1..])[i];
    assert path[1..][|path| - 2 - i] == path[|path| - 1 - i];
  } else {
    assert reverse(path)[i] == path[0];
  }
}

lemma PreservedAncestorsAreNotExited(path: seq<string>, kept: int, i: int)
  requires 0 <= i < kept <= |path|
  requires forall a, b :: 0 <= a < b < |path| ==> path[a] != path[b]
  ensures path[i] !in reverse(path[kept..])
{
}

lemma {:induction false} {:isolate_assertions} CompoundLifecycleWitness(reenter: bool)
{
  var empty: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(None, [], []);
  var rootExit: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(None, [Effect(0, [])], []);
  var parentEntry: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(None, [Effect(1, [])], []);
  var parentExit: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(None, [Effect(2, [])], []);
  var childEntry: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(None, [Effect(3, [])], []);
  var childExit: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(None, [Effect(4, [])], []);
  var sibling: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(Some(Result(Some("b"), None, false)), [], []);
  var reset: (map<string, int>, Event) -> Evaluation :=
    (context, event) => Evaluation(Some(Result(Some("p"), None, reenter)), [], []);
  var zero: (map<string, int>, Event) -> int := (context, event) => 0;
  var root := CompoundNode(["r"], ["r", "p", "a"], ["p"], Some("p"), map[], empty, rootExit, false, zero);
  var parent := CompoundNode(["r", "p"], ["r", "p", "a"], ["a", "b"], Some("a"), map["reset" := reset], parentEntry, parentExit, false, zero);
  var a := CompoundNode(["r", "p", "a"], ["r", "p", "a"], [], None, map["go" := sibling], childEntry, childExit, false, zero);
  var b := CompoundNode(["r", "p", "b"], ["r", "p", "b"], [], None, map[], childEntry, childExit, false, zero);
  var machine := CompoundMachine("r", map[], map["r" := root, "p" := parent, "a" := a, "b" := b], false, zero);
  var snapshot := CompoundSnapshot(["r", "p", "a"], map[], None);
  assert forall id :: id in machine.nodes ==> initialWitness(machine.nodes, id);
  assert compoundTransition(machine, snapshot, Event("go", 0)).effects ==
    [Effect(4, []), Effect(3, [])];
  assert select(machine.nodes, snapshot.path, snapshot.context, Event("reset", 0)) ==
    Some(Selection("p", parent, Evaluation(Some(Result(Some("p"), None, reenter)), [], [])));
  if reenter {
    LifecycleCons(machine.nodes, ["a", "p"], map[], Event("reset", 0), true);
    LifecycleCons(machine.nodes, ["p", "a"], map[], Event("reset", 0), false);
    assert lifecycle(machine.nodes, ["a", "p"], map[], Event("reset", 0), true).effects ==
      [Effect(4, []), Effect(2, [])];
    assert lifecycle(machine.nodes, ["p", "a"], map[], Event("reset", 0), false).effects ==
      [Effect(1, []), Effect(3, [])];
    assert compoundTransition(machine, snapshot, Event("reset", 0)).effects ==
      [Effect(4, []), Effect(2, []), Effect(1, []), Effect(3, [])];
  } else {
    assert compoundTransition(machine, snapshot, Event("reset", 0)).effects ==
      [Effect(4, []), Effect(3, [])];
  }
}

// Compound completion

// A done compound machine takes no transitions.
lemma CompoundDoneInert(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event)
  requires declaredPath(machine.nodes, snapshot.path)
  requires ready(machine, snapshot, event)
  requires forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k)
  requires compoundDone(machine, snapshot.path)
  ensures compoundTransition(machine, snapshot, event) == CompoundStep(snapshot, true, true, [], [])
{
}

// Settling a done machine stops at once and discards the queue, whatever the
// remaining budget.
lemma CompoundSettleDone(machine: CompoundMachine, step: CompoundStep, queue: seq<Event>, remaining: int)
  requires forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k)
  requires declaredPath(machine.nodes, step.snapshot.path)
  requires compoundDone(machine, step.snapshot.path)
  ensures compoundSettle(machine, step, queue, remaining) == CompoundMacrostep(true, false, step, [], [])
{
}

// Entering a final leaf below a non-root parent queues one done event for the
// parent, carrying the leaf's output, and changes nothing else.
lemma NestedFinalRaisesDone(machine: CompoundMachine, path: seq<string>, context: map<string, int>, event: Event)
  requires declaredPath(machine.nodes, path) && |path| >= 2
  requires machine.nodes[path[|path| - 1]].final
  requires path[|path| - 2] != machine.root
  ensures var leaf := machine.nodes[path[|path| - 1]];
          compoundCompletion(machine, path, true, context, event) ==
            CompoundCompletion(context, true, [],
              [doneEvent(path[|path| - 2], leaf.output(context, event))], None)
{
}

// Entering a final child of the root resolves the root output from the entered
// context and a done event carrying the final output, then exits every active
// node from the leaf up. Exit patches never reach the output.
lemma RootCompletionOutput(machine: CompoundMachine, path: seq<string>, context: map<string, int>, event: Event)
  requires declaredPath(machine.nodes, path) && |path| >= 2
  requires machine.nodes[path[|path| - 1]].final
  requires path[|path| - 2] == machine.root
  ensures var leafId := path[|path| - 1];
          var finalOutput := machine.nodes[leafId].output(context, event);
          var exited := lifecycle(machine.nodes, reverse(path), context, event, true);
          compoundCompletion(machine, path, true, context, event) ==
            CompoundCompletion(exited.context, exited.reused, exited.effects, [],
              Some(if machine.hasOutput then machine.output(context, doneEvent(leafId, finalOutput))
                   else finalOutput))
{
}

// A step that changes the snapshot defines output only when it completes the
// machine.
lemma CompoundOutputOnlyWhenDone(machine: CompoundMachine, snapshot: CompoundSnapshot, event: Event)
  requires declaredPath(machine.nodes, snapshot.path)
  requires ready(machine, snapshot, event)
  requires forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k)
  ensures var next := compoundTransition(machine, snapshot, event);
          !next.snapshotReused && next.snapshot.output.Some? ==>
            declaredPath(machine.nodes, next.snapshot.path) &&
            compoundDone(machine, next.snapshot.path)
{
  reveal compoundTransition();
}

// Raised events are processed first-in, first-out: the head of the queue is
// processed, and the step's own raises join the back of the queue.
lemma CompoundSettleDequeue(machine: CompoundMachine, step: CompoundStep, queue: seq<Event>, remaining: int)
  requires forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k)
  requires declaredPath(machine.nodes, step.snapshot.path)
  requires !compoundDone(machine, step.snapshot.path)
  requires remaining > 0 && |queue| > 0
  requires ready(machine, step.snapshot, queue[0])
  ensures var next := compoundTransition(machine, step.snapshot, queue[0]);
          var advanced := CompoundStep(next.snapshot, step.snapshotReused && next.snapshotReused,
            step.contextReused && next.contextReused, step.effects + next.effects,
            step.raised + next.raised);
          var rest := compoundSettle(machine, advanced, queue[1..] + next.raised, remaining - 1);
          compoundSettle(machine, step, queue, remaining) ==
            CompoundMacrostep(rest.settled, rest.refused, rest.step, rest.queue, [next] + rest.trace)
{
}

// An active machine with an exhausted budget reports an unsettled macrostep,
// keeping its queue.
lemma CompoundSettleBudget(machine: CompoundMachine, step: CompoundStep, queue: seq<Event>, remaining: int)
  requires forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k)
  requires declaredPath(machine.nodes, step.snapshot.path)
  requires !compoundDone(machine, step.snapshot.path)
  requires remaining <= 0
  ensures compoundSettle(machine, step, queue, remaining) == CompoundMacrostep(false, false, step, queue, [])
{
}

// Initialization applies completion to the entered configuration, so a machine
// whose initial leaf is a final child of the root is done before any event,
// and a nested initial final leaf queues its parent's done event after the
// entry raises.
lemma CompoundInitialCompletion(machine: CompoundMachine, event: Event)
  requires machine.root in machine.nodes
  requires declaredPath(machine.nodes, machine.nodes[machine.root].initialPath)
  requires forall k :: k in machine.nodes ==> initialWitness(machine.nodes, k)
  ensures var path := descend(machine.nodes, machine.root);
          var entered := lifecycle(machine.nodes, path, machine.context, event, false);
          var done := compoundCompletion(machine, path, true, entered.context, event);
          compoundInitialTransition(machine, event) ==
            CompoundStep(CompoundSnapshot(path, done.context, done.output), false,
              entered.reused && done.reused, entered.effects + done.effects,
              entered.raises + done.raised)
{
}

// A concrete instance of NestedFinalRaisesDone whose leaf and parent ids differ,
// so a done event named for the wrong node fails quickly.
lemma NestedDoneNamesParent(machine: CompoundMachine, context: map<string, int>, event: Event)
  requires "r" in machine.nodes && "p" in machine.nodes && "f" in machine.nodes
  requires machine.root == "r" && machine.nodes["f"].final
  ensures compoundCompletion(machine, ["r", "p", "f"], true, context, event).raised ==
            [Event("xstate.done.state.p", machine.nodes["f"].output(context, event))]
{
  var path := ["r", "p", "f"];
  assert path[|path| - 1] == "f" && path[|path| - 2] == "p";
  assert lookupNode(machine.nodes, "f") == machine.nodes["f"];
  assert "xstate.done.state." + "p" == "xstate.done.state.p";
}

// ---- Parallel completion ----

ghost function ParentOf(machine: ParallelMachine, id: string): string
  requires id in machine.nodes && |machine.nodes[id].path| >= 2
{
  machine.nodes[id].path[|machine.nodes[id].path| - 2]
}

// Climbing from a marker records each parallel it completes, in order from the
// marker upward, and queues exactly one done event per recorded parallel, in
// the same order. A parallel is recorded only while it is final in the
// configuration the runtime holds at that entry, and never twice. The machine
// is done only when the climb records the root.
lemma {:induction false} {:isolate_assertions} ClimbBookkeeping(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>, marker: string, fuel: int)
  decreases fuel
  ensures var c := climb(machine, outputs, next, entries, index, context, event, queue, completed, marker, fuel);
    |completed| <= |c.completed| && c.completed[..|completed|] == completed &&
    |c.raised| == |c.completed| - |completed| &&
    (forall i :: 0 <= i < |c.raised| ==> c.raised[i].type_ == doneEvent(c.completed[|completed| + i], 0).type_) &&
    (forall i :: |completed| <= i < |c.completed| ==>
      c.completed[i] in machine.nodes && c.completed[i] in machine.parallels &&
      finalAt(machine, next, entries, index, c.completed[i], |machine.order|)) &&
    (|c.completed| > |completed| ==> c.completed[|completed|] == marker) &&
    (forall i :: |completed| <= i < |c.completed| - 1 ==>
      |machine.nodes[c.completed[i]].path| >= 2 && c.completed[i + 1] == ParentOf(machine, c.completed[i])) &&
    (Distinct(completed) ==> Distinct(c.completed)) &&
    (c.done <==> c.output.Some?) &&
    (c.done ==> |c.completed| > |completed| && |machine.nodes[c.completed[|c.completed| - 1]].path| < 2)
{
  var c := climb(machine, outputs, next, entries, index, context, event, queue, completed, marker, fuel);
  if fuel <= 0 || marker !in machine.nodes || marker !in machine.parallels || marker in completed ||
     !finalAt(machine, next, entries, index, marker, |machine.order|) {
    assert c == ParallelClimb([], completed, false, None);
  } else {
    var node := lookupNode(machine.nodes, marker);
    var combine := outputs.regions;
    var done := doneEvent(marker, combine(marker, regionOutputs(machine, outputs, next, entries, index, context, event, queue, node.children)));
    var path := node.path;
    if |path| < 2 {
      assert c == ParallelClimb([done], completed + [marker], true, Some(outputs.output(context, done)));
      assert c.completed[..|completed|] == completed;
      if Distinct(completed) {
        assert forall i :: 0 <= i < |completed| ==> c.completed[i] != marker;
      }
    } else {
      var parent := path[|path| - 2];
      var rest := climb(machine, outputs, next, entries, index, context, event, queue + [done], completed + [marker], parent, fuel - 1);
      ClimbBookkeeping(machine, outputs, next, entries, index, context, event, queue + [done], completed + [marker], parent, fuel - 1);
      assert c == ParallelClimb([done] + rest.raised, rest.completed, rest.done, rest.output);
      var grown := completed + [marker];
      assert rest.completed[..|grown|] == grown;
      assert rest.completed[..|completed|] == grown[..|completed|] == completed;
      assert rest.completed[|completed|] == marker;
      forall i | 0 <= i < |c.raised|
        ensures c.raised[i].type_ == doneEvent(c.completed[|completed| + i], 0).type_
      {
        if i > 0 {
          assert c.raised[i] == rest.raised[i - 1];
          assert |completed| + i == |grown| + (i - 1);
        }
      }
      if |rest.completed| > |grown| {
        assert rest.completed[|grown|] == parent;
        assert machine.nodes[marker].path == path;
      }
      if Distinct(completed) {
        assert forall i :: 0 <= i < |completed| ==> grown[i] != marker;
        assert Distinct(grown);
      }
    }
  }
}

// Entering one node extends the completed parallels without repeating one.
lemma FinalEnteredBookkeeping(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  ensures var f := finalEntered(machine, outputs, next, entries, index, context, event, queue, completed);
    |completed| <= |f.completed| && f.completed[..|completed|] == completed &&
    (forall i :: |completed| <= i < |f.completed| ==> f.completed[i] in machine.parallels) &&
    (Distinct(completed) ==> Distinct(f.completed))
{
  if 0 <= index < |entries| && entries[index] in machine.nodes {
    var node := lookupNode(machine.nodes, entries[index]);
    var path := node.path;
    if node.final && |path| >= 2 {
      var parent := path[|path| - 2];
      var fuel := |machine.order|;
      if parent in machine.parallels {
        ClimbBookkeeping(machine, outputs, next, entries, index, context, event, queue, completed, parent, fuel);
      } else if |path| >= 3 {
        var own := node.output;
        var done := doneEvent(parent, own(context, event));
        ClimbBookkeeping(machine, outputs, next, entries, index, context, event, queue + [done], completed, path[|path| - 3], fuel);
      }
    }
  }
}

// Within one microstep each parallel node completes at most once: each
// entry's climb starts from every parallel completed by earlier entries, the
// pass returns an extension of what the current entry completed, and no node
// is listed twice. A climb refuses a listed node and queues exactly one done
// event per node it adds (`ClimbBookkeeping`).
lemma {:induction false} ParallelEnterCompletesOnce(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  decreases |entries| - index
  ensures var e := parallelEnter(machine, outputs, next, entries, index, context, event, queue, completed);
    |completed| <= |e.completed| && e.completed[..|completed|] == completed &&
    (forall i :: |completed| <= i < |e.completed| ==> e.completed[i] in machine.parallels) &&
    (Distinct(completed) ==> Distinct(e.completed)) &&
    (0 <= index < |entries| ==>
      var entered := runLifecycle(machine.nodes, [entries[index]], context, event, false);
      var f := finalEntered(machine, outputs, next, entries, index, entered.context, event, queue + entered.raises, completed);
      |f.completed| <= |e.completed| && e.completed[..|f.completed|] == f.completed)
{
  if 0 <= index < |entries| {
    var entered := runLifecycle(machine.nodes, [entries[index]], context, event, false);
    var queued := queue + entered.raises;
    var final := finalEntered(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    FinalEnteredBookkeeping(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    ParallelEnterCompletesOnce(machine, outputs, next, entries, index + 1, entered.context, event, queued + final.raised, final.completed);
    var e := parallelEnter(machine, outputs, next, entries, index, context, event, queue, completed);
    var rest := parallelEnter(machine, outputs, next, entries, index + 1, entered.context, event, queued + final.raised, final.completed);
    assert e.completed == rest.completed;
    assert rest.completed[..|final.completed|] == final.completed;
    assert e.completed[..|completed|] == final.completed[..|completed|];
    forall i | |completed| <= i < |e.completed|
      ensures e.completed[i] in machine.parallels
    {
      if i < |final.completed| {
        assert e.completed[i] == final.completed[i];
      }
    }
  }
}

// Entering a non-final node, or the root, completes nothing.
lemma NonFinalEntryInert(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  requires 0 <= index < |entries| && entries[index] in machine.nodes
  requires !machine.nodes[entries[index]].final || |machine.nodes[entries[index]].path| < 2
  ensures finalEntered(machine, outputs, next, entries, index, context, event, queue, completed) ==
    ParallelClimb([], completed, false, None)
{
}

// A final region of a parallel climbs from that parallel.
lemma FinalRegionClimbs(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  requires 0 <= index < |entries| && entries[index] in machine.nodes
  requires machine.nodes[entries[index]].final && |machine.nodes[entries[index]].path| >= 2
  requires ParentOf(machine, entries[index]) in machine.parallels
  ensures finalEntered(machine, outputs, next, entries, index, context, event, queue, completed) ==
    climb(machine, outputs, next, entries, index, context, event, queue, completed,
      ParentOf(machine, entries[index]), |machine.order|)
{
}

// A final child of a compound node queues that node's done event, carrying
// the child's output, before any parallel completion it causes. A final child
// of a compound root completes the machine with the root output, which falls
// back to the child's output.
lemma FinalChildQueuesParentDone(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  requires 0 <= index < |entries| && entries[index] in machine.nodes
  requires machine.nodes[entries[index]].final && |machine.nodes[entries[index]].path| >= 2
  requires ParentOf(machine, entries[index]) !in machine.parallels
  ensures var id := entries[index];
    var path := machine.nodes[id].path;
    var finalOutput := machine.nodes[id].output(context, event);
    var done := doneEvent(ParentOf(machine, id), finalOutput);
    var f := finalEntered(machine, outputs, next, entries, index, context, event, queue, completed);
    |f.raised| > 0 && f.raised[0] == done &&
    (|path| < 3 ==> f == ParallelClimb([done], completed, true,
      Some(if outputs.hasOutput then outputs.output(context, doneEvent(id, finalOutput)) else finalOutput))) &&
    (|path| >= 3 ==> f.raised[1..] == climb(machine, outputs, next, entries, index, context, event,
      queue + [done], completed, path[|path| - 3], |machine.order|).raised)
{
}

// Entering runs each entry's lifecycle in order from the planned context, so
// completion changes neither the entered context nor the entry effects.
lemma {:induction false} {:isolate_assertions} ParallelEnterLifecycle(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  requires 0 <= index <= |entries|
  requires declaredPath(machine.nodes, entries)
  decreases |entries| - index
  ensures var e := parallelEnter(machine, outputs, next, entries, index, context, event, queue, completed);
    var l := lifecycle(machine.nodes, entries[index..], context, event, false);
    e.context == l.context && e.reused == l.reused && e.effects == l.effects
{
  var e := parallelEnter(machine, outputs, next, entries, index, context, event, queue, completed);
  if index == |entries| {
    assert entries[index..] == [];
  } else {
    var nodes := machine.nodes;
    var tail := entries[index..];
    assert tail[0] == entries[index] && tail[1..] == entries[index + 1..];
    assert declaredPath(nodes, tail) && declaredPath(nodes, [entries[index]]);
    var entered := runLifecycle(nodes, [entries[index]], context, event, false);
    LifecycleCons(nodes, [entries[index]], context, event, false);
    assert [entries[index]][1..] == [];
    LifecycleCons(nodes, tail, context, event, false);
    var queued := queue + entered.raises;
    var final := finalEntered(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    ParallelEnterLifecycle(machine, outputs, next, entries, index + 1, entered.context, event, queued + final.raised, final.completed);
  }
}

// The completion plan repeats the step's planning up to its entries: running
// the planned entries from the planned context reproduces the step's context.
lemma {:isolate_assertions} ParallelPartsAgree(machine: ParallelMachine, snapshot: ParallelSnapshot, event: Event)
  ensures var step := parallelStep(machine, snapshot, event);
    var parts := parallelParts(machine, snapshot, event);
    !step.snapshotReused ==>
      step.snapshot.context == runLifecycle(machine.nodes, parts.entries, parts.entryContext, event, false).context
{
}

// A step that completes nothing keeps the step's snapshot and effects, and a
// step that completes the machine keeps its configuration. In both cases the
// entered context equals the step's context.
lemma {:isolate_assertions} ParallelMicroKeepsStep(machine: ParallelMachine, outputs: ParallelOutputs,
  state: ParallelState, event: Event, pending: seq<Event>)
  requires ParallelWellFormed(machine) && !state.done
  ensures var step := parallelStep(machine, state.snapshot, event);
    var micro := parallelMicrostep(machine, outputs, state, event, pending);
    !step.snapshotReused ==>
      micro.state.snapshot.active == step.snapshot.active &&
      (!micro.state.done ==> micro.state.snapshot == step.snapshot && micro.effects == step.effects) &&
      (micro.state.done <==> micro.state.output.Some?) &&
      (micro.state.done ==>
        micro.state.snapshot.context ==
          runLifecycle(machine.nodes, reverse(step.snapshot.active), step.snapshot.context, event, true).context)
{
  hide *;
  var step := parallelStep(machine, state.snapshot, event);
  if !step.snapshotReused {
    reveal parallelMicrostep();
    var parts := parallelParts(machine, state.snapshot, event);
    var entered := parallelEnter(machine, outputs, step.snapshot.active, parts.entries, 0, parts.entryContext, event,
      pending + parts.raised, []);
    assert parallelMicrostep(machine, outputs, state, event, pending) == parallelFinish(machine, step, parts, entered, event);
    reveal parallelFinish();
    EnteredDoneHasOutput(machine, outputs, step.snapshot.active, parts.entries, 0, parts.entryContext, event,
      pending + parts.raised, []);
  }
}

// An entry pass that completes the machine reports its output.
lemma {:induction false} EnteredDoneHasOutput(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  decreases |entries| - index
  ensures var e := parallelEnter(machine, outputs, next, entries, index, context, event, queue, completed);
    e.done ==> e.output.Some?
{
  if 0 <= index < |entries| {
    var entered := runLifecycle(machine.nodes, [entries[index]], context, event, false);
    var queued := queue + entered.raises;
    var final := finalEntered(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    FinalEnteredDoneHasOutput(machine, outputs, next, entries, index, entered.context, event, queued, completed);
    EnteredDoneHasOutput(machine, outputs, next, entries, index + 1, entered.context, event, queued + final.raised, final.completed);
  }
}

lemma FinalEnteredDoneHasOutput(machine: ParallelMachine, outputs: ParallelOutputs,
  next: seq<string>, entries: seq<string>, index: int, context: map<string, int>, event: Event,
  queue: seq<Event>, completed: seq<string>)
  ensures var f := finalEntered(machine, outputs, next, entries, index, context, event, queue, completed);
    f.done <==> f.output.Some?
{
  if 0 <= index < |entries| && entries[index] in machine.nodes {
    var node := machine.nodes[entries[index]];
    var path := node.path;
    if node.final && |path| >= 2 {
      var parent := path[|path| - 2];
      if parent in machine.parallels {
        ClimbBookkeeping(machine, outputs, next, entries, index, context, event, queue, completed, parent, |machine.order|);
      } else if |path| >= 3 {
        var done := doneEvent(parent, node.output(context, event));
        ClimbBookkeeping(machine, outputs, next, entries, index, context, event, queue + [done], completed, path[|path| - 3], |machine.order|);
      }
    }
  }
}

// A microstep from a valid configuration leaves a valid configuration.
lemma ParallelMicroValid(machine: ParallelMachine, outputs: ParallelOutputs,
  state: ParallelState, event: Event, pending: seq<Event>)
  requires ParallelWellFormed(machine) && ParallelValid(machine, state.snapshot.active)
  requires parallelStepReady(machine, state.snapshot, event)
  ensures ParallelValid(machine, parallelMicrostep(machine, outputs, state, event, pending).state.snapshot.active)
{
  if !state.done && !parallelStep(machine, state.snapshot, event).snapshotReused {
    MultiStepValid(machine, state.snapshot, event);
  }
}

// Settling a done machine stops at once and discards the queue.
lemma ParallelSettleDone(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro,
  queue: seq<Event>, remaining: int)
  requires step.state.done
  ensures parallelSettle(machine, outputs, step, queue, remaining) == ParallelMacrostep(true, false, step, [], [])
{
}

// An active machine with an exhausted budget reports an unsettled macrostep,
// keeping its queue.
lemma ParallelSettleBudget(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro,
  queue: seq<Event>, remaining: int)
  requires !step.state.done && remaining <= 0
  ensures parallelSettle(machine, outputs, step, queue, remaining) == ParallelMacrostep(false, false, step, queue, [])
{
}

// A queued event the step model cannot represent refuses the macrostep before
// any of its effects.
lemma ParallelSettleRefuses(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro,
  queue: seq<Event>, remaining: int)
  requires !step.state.done && remaining > 0 && |queue| > 0
  requires !parallelStepReady(machine, step.state.snapshot, queue[0])
  ensures parallelSettle(machine, outputs, step, queue, remaining) == ParallelMacrostep(false, true, step, queue, [])
{
}

// Raised and done events are processed first-in, first-out; a microstep's
// raises reach the back of the queue, and the rest of the queue is visible to
// the microstep's region outputs.
lemma ParallelSettleDequeue(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro,
  queue: seq<Event>, remaining: int)
  requires !step.state.done && remaining > 0 && |queue| > 0
  requires parallelStepReady(machine, step.state.snapshot, queue[0])
  ensures var next := parallelMicrostep(machine, outputs, step.state, queue[0], queue[1..]);
    var advanced := ParallelMicro(next.state, step.snapshotReused && next.snapshotReused,
      step.contextReused && next.contextReused, step.effects + next.effects, step.raised + next.raised);
    var rest := parallelSettle(machine, outputs, advanced, queue[1..] + next.raised, remaining - 1);
    parallelSettle(machine, outputs, step, queue, remaining) ==
      ParallelMacrostep(rest.settled, rest.refused, rest.step, rest.queue, [next] + rest.trace)
{
}

// Every microstep of a settled macrostep, and its final state, keeps a valid
// configuration.
lemma {:induction false} ParallelSettleValid(machine: ParallelMachine, outputs: ParallelOutputs, step: ParallelMicro,
  queue: seq<Event>, remaining: int)
  requires ParallelWellFormed(machine) && ParallelValid(machine, step.state.snapshot.active)
  decreases remaining
  ensures var m := parallelSettle(machine, outputs, step, queue, remaining);
    ParallelValid(machine, m.step.state.snapshot.active) &&
    forall i :: 0 <= i < |m.trace| ==> ParallelValid(machine, m.trace[i].state.snapshot.active)
{
  if !step.state.done && remaining > 0 && |queue| > 0 && parallelStepReady(machine, step.state.snapshot, queue[0]) {
    var next := parallelMicrostep(machine, outputs, step.state, queue[0], queue[1..]);
    ParallelMicroValid(machine, outputs, step.state, queue[0], queue[1..]);
    var advanced := ParallelMicro(next.state, step.snapshotReused && next.snapshotReused,
      step.contextReused && next.contextReused, step.effects + next.effects, step.raised + next.raised);
    ParallelSettleValid(machine, outputs, advanced, queue[1..] + next.raised, remaining - 1);
    ParallelSettleDequeue(machine, outputs, step, queue, remaining);
    var rest := parallelSettle(machine, outputs, advanced, queue[1..] + next.raised, remaining - 1);
    forall i | 0 <= i < |[next] + rest.trace|
      ensures ParallelValid(machine, ([next] + rest.trace)[i].state.snapshot.active)
    {
      if i > 0 { assert ([next] + rest.trace)[i] == rest.trace[i - 1]; }
    }
  }
}

// Initialization keeps the initial configuration whether or not it completes
// the machine.
lemma ParallelInitialMicroValid(machine: ParallelMachine, outputs: ParallelOutputs, event: Event)
  requires ParallelWellFormed(machine)
  ensures ParallelValid(machine, parallelInitialMicro(machine, outputs, event).state.snapshot.active)
{
  ParallelInitialValid(machine, event);
}

// While entering `entries[index]`, a node counts as active when the step's
// next configuration holds it and no later entry enters it.
lemma ActiveAtMeaning(next: seq<string>, entries: seq<string>, index: int, id: string)
  requires 0 <= index
  ensures activeAt(next, entries, index, id) <==>
    id in next && forall j :: index < j < |entries| ==> entries[j] != id
{
  if id in next && index + 1 < |entries| {
    var later := entries[index + 1..];
    assert forall k :: 0 <= k < |later| ==> later[k] == entries[k + index + 1];
    assert forall j :: index < j < |entries| ==> entries[j] == later[j - index - 1];
  }
}

lemma SeqAllMeaning<T>(xs: seq<T>, p: T -> bool)
  ensures SeqAll(xs, p) <==> forall x :: x in xs ==> p(x)
{
  if |xs| > 0 {
    SeqAllMeaning(xs[1..], p);
    assert forall x :: x in xs <==> x == xs[0] || x in xs[1..];
  }
}

// The runtime's final test: a parallel is final when all its regions are, a
// compound node when one of its final children is active, and an atomic node
// when it is a final node, whether or not it has been entered yet.
lemma FinalAtMeaning(machine: ParallelMachine, next: seq<string>, entries: seq<string>, index: int, id: string, fuel: int)
  requires fuel > 0 && id in machine.nodes
  ensures var node := machine.nodes[id];
    finalAt(machine, next, entries, index, id, fuel) <==>
      if id in machine.parallels then
        forall child :: child in node.children ==> finalAt(machine, next, entries, index, child, fuel - 1)
      else if |node.children| == 0 then node.final
      else (exists child ::
              child in node.children && child in machine.nodes &&
              machine.nodes[child].final && activeAt(next, entries, index, child))
{
  var node := machine.nodes[id];
  SeqAllMeaning(node.children, (child: string) => finalAt(machine, next, entries, index, child, fuel - 1));
}

// A done machine processes no events.
lemma ParallelDoneInert(machine: ParallelMachine, outputs: ParallelOutputs,
  state: ParallelState, event: Event, pending: seq<Event>)
  requires state.done
  ensures parallelMicrostep(machine, outputs, state, event, pending) == ParallelMicro(state, true, true, [], [])
{
}
